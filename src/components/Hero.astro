---
// Home hero: product screenshot in a browser frame over the "Living Architecture" network (desktop only).
// Green = action (CTAs). Cyan/blue = the system.
import { tourDashboards } from '../data/site.js';

// Named product links near the top of the homepage (SEO Fix Spec T9)
const productLinks = [
  { href: '/sheqx/', label: 'SHEQX®' },
  { href: '/erm/', label: 'ERM' },
  { href: '/envirx/', label: 'ENVIRX®' },
  { href: '/msx/', label: 'MSX®' },
  { href: '/msxcyber/', label: 'MSXCyber®' },
  { href: '/compliance-hub/', label: 'Compliance Hub' },
  { href: '/maia/', label: 'MAIA®' },
];
---

<section class="hero">
  <div class="scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-copy">
      <span class="eyebrow"><span class="dot"></span>Connected Governance Architecture</span>
      <h1>Integrated <span class="grad">GRC software</span> for governance, risk and compliance</h1>
      <p class="hero-sub">See every risk, control and obligation in one auditable place, and act before issues become incidents.</p>
      <p class="lede">Governance, risk, compliance and cyber security, wired into one secure, auditable platform. Every solution talks to the next, so your four lines of defence finally act as one.</p>
      <p class="products">One platform for {productLinks.map((l, i) => (
        <>{i > 0 && (i === productLinks.length - 1 ? ' and ' : ', ')}<a href={l.href}>{l.label}</a></>
      ))}, built in South Africa by Strategix.</p>
      <div class="actions">
        <a href="/demo/" class="btn btn-primary">Book a demo</a>
        <a href="/tour/" class="btn btn-ghost">Take the live tour <span aria-hidden="true">→</span></a>
        <a href="/solutions/" class="btn btn-ghost">Explore solutions</a>
      </div>
      <ul class="trust" aria-label="Certifications and hosting">
        <li><a href="/trust/"><span class="tick" aria-hidden="true">✓</span>ISO 27001:2022 certified</a></li>
        <li><a href="/trust/"><span class="tick" aria-hidden="true">✓</span>ISO/IEC 42001 by October 2026</a></li>
        <li><a href="/trust/"><span class="tick" aria-hidden="true">✓</span>Hosted on Microsoft Azure</a></li>
      </ul>
    </div>

    <figure class="hero-visual">
      <a class="frame" href="/tour/enterprise-risk.html" aria-label="Open the live Enterprise Risk dashboard">
        <span class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>xgrcsoftware.com/tour</span></span>
        <img
          src="/assets/tour/hero-erm-900-v1.webp"
          srcset="/assets/tour/hero-erm-900-v1.webp 900w, /assets/tour/hero-erm-1600-v1.webp 1600w"
          sizes="(max-width: 860px) 92vw, 640px"
          width="1600" height="1000"
          alt="XGRC® Enterprise Risk dashboard showing risk appetite, a likelihood and impact heat map, and combined assurance"
          fetchpriority="high"
        />
      </a>
      <figcaption>Illustrative data. <a href="/tour/">Click through all {tourDashboards.length} dashboards →</a></figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; }
  .scrim { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(95deg, rgba(6,15,28,0.97) 0%, rgba(6,15,28,0.92) 38%, rgba(6,15,28,0.6) 62%, rgba(6,15,28,0.35) 100%); }

  .hero-content { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(28px, 4vw, 56px); align-items: center; padding-top: 90px; padding-bottom: 48px; }
  .hero-copy { max-width: 600px; }
  h1 { margin-bottom: 22px; font-size: clamp(2.1rem, 3.9vw, 3.3rem); max-width: 18ch; }
  .products { color: var(--mute); font-size: 0.95rem; line-height: 1.6; margin: -8px 0 24px; max-width: 56ch; }
  .products a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .products a:hover { color: var(--cyan); text-decoration-color: var(--cyan); }
  .grad { background: linear-gradient(100deg, var(--cyan-hi), var(--cyan) 40%, var(--blue)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-sub { font-size: clamp(1.05rem, 1.5vw, 1.22rem); color: var(--ink); font-weight: 500; margin-bottom: 14px; max-width: 52ch; line-height: 1.5; }
  .lede { margin-bottom: 30px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
  .trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .trust a { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.03em; color: var(--mute); text-decoration: none; border: 1px solid var(--line); border-radius: 7px; padding: 6px 10px; background: rgba(6,15,28,0.5); }
  .trust a:hover { color: var(--ink); border-color: var(--line-strong); }
  .trust a:focus-visible { outline: 2px solid var(--green-hi); outline-offset: 2px; }
  .tick { color: var(--green); font-weight: 700; }
  .eyebrow .dot { animation: beat 2.4s infinite ease-in-out; }
  @keyframes beat { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.7); } }

  .hero-visual { margin: 0; display: grid; gap: 12px; perspective: 1400px; }
  .frame { display: block; text-decoration: none; border-radius: 12px; overflow: hidden; border: 1px solid rgba(48,226,244,0.35); background: #0a1729;
    box-shadow: 0 40px 90px rgba(0,0,0,0.55), 0 0 0 1px rgba(48,226,244,0.08), 0 0 60px rgba(48,226,244,0.10);
    transform: rotateY(-9deg) rotateX(3deg); transform-origin: left center; transition: transform 0.6s var(--ease); }
  .frame:hover, .frame:focus-visible { transform: rotateY(-3deg) rotateX(1deg); }
  .frame:focus-visible { outline: 2px solid var(--green-hi); outline-offset: 4px; }
  .frame img { display: block; width: 100%; height: auto; }
  .frame-bar { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #081322; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 10.5px; color: var(--faint); }
  .frame-bar i { width: 8px; height: 8px; border-radius: 50%; background: #243546; display: inline-block; }
  .frame-bar span { margin-left: 8px; }
  .hero-visual figcaption { font-family: var(--font-mono); font-size: 11px; color: var(--faint); padding-left: 4px; }
  .hero-visual figcaption a { color: var(--cyan); text-decoration: none; }
  .hero-visual figcaption a:hover { color: var(--cyan-hi); }

  /* Phones and small tablets: nothing sits behind the headline; the product image follows the buttons. */
  @media (max-width: 860px) {
    .hero { min-height: 0; }
    .scrim { display: none; }
    .hero-content { grid-template-columns: minmax(0, 1fr); padding-top: 72px; padding-bottom: 40px; }
    .frame, .frame:hover { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .frame, .frame:hover { transform: none; transition: none; } }
</style>
