---
// Illustration of the XGRC® AI Governance product window, drawn from the real product's menu
// (14 items, in the product's order and wording). Used for page illustrations until clean-tenant
// screenshots exist; always labelled as an illustration.
interface Props { active?: string; title?: string; compact?: boolean; label?: string }
const { active = 'dashboard', title = 'AI Governance', compact = false, label = 'Illustration of the XGRC® AI Governance workspace' } = Astro.props;

const MENU = [
  { key: 'work', name: 'My AI Governance Work', d: 'M9 3h6v3H9zM6 5h3M15 5h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1M12 11.5a2 2 0 1 0 0-.01M8.5 17a3.5 3.5 0 0 1 7 0' },
  { key: 'dashboard', name: 'AI Governance Dashboard', d: 'M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z' },
  { key: 'classification', name: 'AI Act Classification', d: 'M12 4v16M7 20h10M5 8h14M5 8l-2.5 6a2.5 2.5 0 0 0 5 0zM19 8l-2.5 6a2.5 2.5 0 0 0 5 0z' },
  { key: 'compliance', name: 'Compliance & Applicability', d: 'M9 3h6v3H9zM6 5h3M15 5h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1M9 14l2 2 4-4' },
  { key: 'impact', name: 'Impact Assessment', d: 'M12 10a2.5 2.5 0 1 0 0-.01M6 11a2 2 0 1 0 0-.01M18 11a2 2 0 1 0 0-.01M7.5 18a4.5 4.5 0 0 1 9 0M2.5 18a3.5 3.5 0 0 1 4-3.4M21.5 18a3.5 3.5 0 0 0-4-3.4' },
  { key: 'controls', name: 'Controls & Evidence', d: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4' },
  { key: 'oversight', name: 'Human Oversight', d: 'M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6zM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM17 19l1.5 1.5L21 18' },
  { key: 'risk', name: 'AI Risk Management', d: 'M12 2.5l2.2 1.6 2.7-.2.9 2.6 2.3 1.4-.6 2.6 1 2.5-2 1.8-.4 2.7-2.7.4-1.8 2-2.5-1-2.6.6-1.4-2.3-2.6-.9.2-2.7L2.5 12l1.6-2.2-.2-2.7 2.6-.9L7.9 3.9l2.6.6zM12 8v4.5M12 15.5v.5' },
  { key: 'incident', name: 'Incident Governance', d: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7.5v6M12 16.5v.5' },
  { key: 'change', name: 'Change Governance', d: 'M4 9h13l-3-3M20 15H7l3 3' },
  { key: 'aims', name: 'AI Management System', d: 'M4 4h12a1 1 0 0 1 1 1v6M4 4v15a1 1 0 0 0 1 1h7M7 8h7M7 12h4M7 16h3M17.5 14l1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3z' },
  { key: 'library', name: 'Governance Library', d: 'M4 20h16M5 5h3v15H5zM10 5h3v15h-3zM15.5 5.5l2.8-.8 3 14.2-2.8.8z' },
  { key: 'register', name: 'Register Connection', d: 'M4 7h10M18 7h2M4 17h2M10 17h10M16 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM8 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  { key: 'approvals', name: 'Approvals', d: 'M12 2.5l2.4 1.7 2.9-.1.9 2.8 2.4 1.7-.9 2.8.9 2.8-2.4 1.7-.9 2.8-2.9-.1L12 21.5l-2.4-1.7-2.9.1-.9-2.8-2.4-1.7.9-2.8-.9-2.8 2.4-1.7.9-2.8 2.9.1zM8.5 12l2.5 2.5 4.5-4.5' },
];
---
<figure class={`pf${compact ? ' pf--compact' : ''}`} aria-label={label}>
  <div class="pf-top" aria-hidden="true">
    <span class="pf-logo"><img src="/assets/logos/brand/xgrc-icon-white.png" alt="" width="22" height="22" /><b>XGRC</b><sup>®</sup></span>
    <span class="pf-crumb">{title}</span>
    <span class="pf-ill">Illustration</span>
  </div>
  <div class="pf-body">
    <nav class="pf-side" aria-hidden="true">
      <div class="pf-side-h">AI GOVERNANCE</div>
      {MENU.map((m) => (
        <div class={`pf-item${m.key === active ? ' is-active' : ''}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={m.d} /></svg>
          <span>{m.name}</span>
        </div>
      ))}
    </nav>
    <div class="pf-main"><slot /></div>
  </div>
</figure>

<style>
  /* Product palette, taken from the live XGRC® AI Governance interface. */
  .pf { --pf-blue: #3f86f4; --pf-navy: #1a2331; --pf-navy-2: #202b3b; --pf-ink: #e9eef5; --pf-mute: #9aa8ba; --pf-teal: #45b7ae; --pf-line: rgba(255,255,255,0.07);
    margin: 0; border-radius: 14px; overflow: hidden; background: #111a26; border: 1px solid rgba(120,170,200,0.22);
    box-shadow: 0 36px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(63,134,244,0.10); font-family: var(--font-body); color: var(--pf-ink); }
  .pf-top { display: flex; align-items: center; gap: 14px; height: 40px; padding: 0 14px; background: var(--pf-blue); }
  .pf-logo { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-weight: 700; font-size: 14px; color: #fff; letter-spacing: 0.02em; }
  .pf-logo sup { font-size: 7px; margin-left: -3px; }
  .pf-crumb { font-size: 11.5px; color: rgba(255,255,255,0.85); }
  .pf-ill { margin-left: auto; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,0.18); border-radius: 4px; padding: 3px 7px; }
  .pf-body { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: 100%; }
  .pf-side { background: var(--pf-navy); padding: 12px 8px 14px; border-right: 1px solid var(--pf-line); }
  .pf-side-h { font-family: var(--font-display); font-weight: 600; font-size: 10.5px; color: var(--pf-blue); letter-spacing: 0.03em; padding: 2px 10px 10px; }
  .pf-item { display: flex; align-items: center; gap: 9px; padding: 6.5px 10px; border-radius: 10px; font-size: 11px; color: var(--pf-ink); white-space: nowrap; overflow: hidden; }
  .pf-item span { overflow: hidden; text-overflow: ellipsis; }
  .pf-item svg { width: 14px; height: 14px; flex-shrink: 0; color: #c9d3df; }
  .pf-item.is-active { background: var(--pf-navy-2); color: var(--pf-teal); }
  .pf-item.is-active svg { color: var(--pf-teal); }
  .pf-main { background: #151f2d; padding: 16px 18px 18px; min-width: 0; }
  .pf--compact .pf-body { grid-template-columns: 150px minmax(0, 1fr); }
  .pf--compact .pf-item { font-size: 10px; padding: 5px 8px; }
  .pf--compact .pf-item:nth-child(n+10):not(.is-active) { display: none; }
  @media (max-width: 640px) {
    .pf-body, .pf--compact .pf-body { grid-template-columns: minmax(0, 1fr); }
    .pf-side { display: none; }
  }
</style>
