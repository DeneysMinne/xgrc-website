---
import Base from '../layouts/Base.astro';

const APP_URL = 'https://v5.xgrc.cloud/';
---

<Base
  title="Customer Login | XGRC® Software"
  description="Log in to XGRC® Software."
  noindex={true}
>
  <section class="login-hero">
    <div class="container login-inner">
      <span class="eyebrow"><span class="dot"></span>Customer login</span>
      <h1>Log in to XGRC®.</h1>
      <p class="lede">One login for every XGRC® solution you're licensed for — MSX®, SHEQX®, ERM, MSXCyber®, ENVIRX®, ESG, Integrated Assurance, MAIA®, XGRC® Compliance Hub, and XLOGIC®. You'll land in the solutions your account has access to.</p>
      <a href={APP_URL} class="btn btn-primary">Log in to XGRC®</a>
      <p class="help">Not sure which login to use, or need access set up? <a href="/contact" class="link-arrow">Contact us →</a></p>
    </div>
  </section>
</Base>

<style>
  .login-hero { padding: 160px 0 120px; text-align: center; }
  .login-inner { max-width: 620px; margin: 0 auto; }
  .login-hero h1 { margin: 10px 0 18px; }
  .login-hero .lede { margin: 0 auto 32px; }
  .help { margin-top: 22px; font-size: 0.92rem; color: var(--mute); }
</style>
