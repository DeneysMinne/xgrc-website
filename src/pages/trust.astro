---
import Base from '../layouts/Base.astro';
import { brand } from '../data/site.js';

const sections = [
  {
    title: 'Security & certification',
    body: 'XGRC® Software is certified to ISO/IEC 27001:2022 by BSI (certificate IS 804839, valid to 28 August 2027), covering the governance, risk assessment, controls and continuous improvement processes that protect customer data. Users can sign in with single sign-on through Microsoft Entra ID (Azure Active Directory).',
    href: '/trust/cybersecurity-data-protection-policy/',
  },
  {
    title: 'Data hosting & residency',
    body: 'XGRC® Software is hosted on Microsoft Azure in the West Europe (Netherlands) region. Azure\'s infrastructure holds its own ISO 27001, ISO 27017, ISO 27018 and SOC 2 Type II certifications.',
    href: '/trust/data-hosting/',
  },
  {
    title: 'Subprocessors',
    body: 'Our primary subprocessors are Microsoft Azure and Microsoft 365, used for hosting, infrastructure and productivity services. Customers receive advance written notice of any material subprocessor change, with the right to raise objections on data protection grounds.',
    href: '/trust/subprocessors/',
  },
  {
    title: 'Data protection',
    body: 'Customer personal data is processed under a Data Processing Addendum satisfying POPIA section 21 operator agreement requirements, with a 72-hour security incident notification commitment and defined data subject rights handling.',
    href: '/legal/data-processing-addendum/',
  },
];

// Security & Trust Overview v3.0 (Oct 2026): the downloadable document and the
// questions buyers ask most. Answers mirror the PDF's FAQ (section 15); source in
// scripts/generate-pdfs/security-overview/.
const overviewPdf = '/resources/xgrc-security-trust-overview-v3.pdf';
const facts = [
  { b: 'ISO/IEC 27001:2022', s: 'Certified by BSI, IS 804839' },
  { b: '72 hours', s: 'Breach notification' },
  { b: 'RPO 1h · RTO 4h', s: 'Recovery objectives' },
  { b: 'AES-256', s: 'Per-customer keys' },
];
const faqs = [
  { q: 'Is XGRC® ISO 27001 certified?', a: 'Yes. Strategix Application Solutions is certified to ISO/IEC 27001:2022 by BSI, certificate IS 804839, valid to 28 August 2027, covering the design, development, delivery and support of the XGRC® cloud platform. The certificate can be checked in BSI\'s public certificate directory.' },
  { q: 'Where is our data stored?', a: 'On Microsoft Azure in the West Europe region (Netherlands). Azure holds ISO 27001, ISO 27017, ISO 27018 and SOC 2 Type II certifications. There is no South African hosting option today; cross-border transfers are protected under our Data Processing Addendum.' },
  { q: 'Is our data encrypted?', a: 'Yes. Traffic uses TLS 1.2 or 1.3, and stored data is encrypted with AES-256 using keys unique to each customer, so one customer\'s key cannot open another\'s data.' },
  { q: 'Do you support single sign-on and MFA?', a: 'Yes, through Microsoft Entra ID (Azure Active Directory), so your own password, MFA and leaver policies apply. MFA is enforced for all Strategix administrative access.' },
  { q: 'How quickly will you tell us about a breach?', a: 'We notify customers without undue delay, and within 72 hours of a confirmed security incident affecting their data. A suspected security breach receives an initial response within 4 hours, 24 hours a day, 7 days a week.' },
  { q: 'What are your recovery objectives?', a: 'A Recovery Point Objective of 1 hour and a Recovery Time Objective of 4 hours, backed by daily backups, hourly transaction logs and replication across locations. Recovery is tested every quarter and reviewed yearly by our external ISO auditor.' },
  { q: 'How often do you test for vulnerabilities?', a: 'Automated vulnerability assessments and penetration testing run daily through our partner Hakware, and a manual penetration test is carried out every year. An executive summary is available under NDA.' },
  { q: 'Do you have 24/7 security monitoring?', a: 'Yes. Hakware\'s security operations centre monitors the platform around the clock, with SIEM and SOAR, and security, access and audit logs are retained indefinitely.' },
  { q: 'Do you use our data to train AI models?', a: 'No. Strategix never uses customer data to train AI models. You choose which model MAIA® uses, and we can help you run a local model so prompts and data stay within your own environment.' },
  { q: 'Who are your subprocessors?', a: 'Microsoft Azure (hosting) and Microsoft 365 (email), both in West Europe. Customers get 10 business days\' notice of material changes and a right to object.' },
  { q: 'What happens to our data when we leave?', a: 'You can request a copy within 30 days of termination. Personal information is then deleted or irreversibly anonymised within 90 days, and a Data Destruction Certificate is issued.' },
  { q: 'Do you have a SOC 2 report?', a: 'No. Our independent assurance is ISO/IEC 27001:2022 certification, and our hosting provider, Microsoft Azure, holds SOC 2 Type II.' },
];
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const policies = [
  { name: 'Privacy Policy', slug: 'privacy-policy' },
  { name: 'Cookie Policy', slug: 'cookie-policy' },
  { name: 'Website Terms of Use', slug: 'website-terms-of-use' },
  { name: 'Privacy Requests', slug: 'privacy-requests' },
];
---

<Base
  title="Trust Centre | XGRC® Software"
  description="Review XGRC® Software hosting, certifications, subprocessors and data protection commitments: everything your procurement, security or legal team needs."
  ogImage="/assets/og/og-trust-centre.jpg"
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>Trust Centre</span>
      <h1>Security and compliance, on the record.</h1>
      <p class="lede">Everything your procurement, security, or legal team needs to evaluate XGRC® Software: hosting, certifications, subprocessors and data protection commitments.</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="card overview-card">
        <div class="overview-copy">
          <span class="eyebrow"><span class="dot"></span>Security &amp; Trust Overview · v3.0</span>
          <h2>The full security picture, in one document.</h2>
          <p class="lede">Governance, hosting, encryption, access, monitoring, incident response, recovery, suppliers and AI, plus answers to the standard security questionnaire questions. Updated October 2026.</p>
          <a href={overviewPdf} class="btn btn-primary" download>Download the PDF</a>
        </div>
        <div class="overview-facts">
          {facts.map((f) => (<div class="overview-fact"><b>{f.b}</b><span>{f.s}</span></div>))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid cols-2 trust-grid">
        {sections.map((s) => (
          <a class="card trust-card" href={s.href}>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <span class="link-arrow">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>FAQ</span>
      <h2 class="faq-title">Security questions, answered.</h2>
      <div class="faq-list">
        {faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
      <p class="faq-more">More answers, with the contractual source for each, are in the <a href={overviewPdf} download>Security &amp; Trust Overview</a>.</p>
    </div>
  </section>
  <script type="application/ld+json" set:html={faqSchema} />

  <section class="section--tight">
    <div class="container">
      <div class="card policies-card">
        <span class="eyebrow"><span class="dot"></span>Policies</span>
        <h2>Privacy Policy, Cookie Policy & Website Terms.</h2>
        <p class="lede">Our full legal and policy documentation is published in the Legal Hub, including the Data Processing Addendum and SaaS-incorporated policies.</p>
        <div class="policy-links">
          {policies.map((p) => (
            <a href={`/legal/${p.slug}/`} class="policy-link">{p.name}</a>
          ))}
          <a href="/legal/" class="policy-link policy-link--all">All legal documents &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-block">
        <div class="cta-tag"><span class="dot"></span>Due diligence</div>
        <h2>Need a security questionnaire completed, or a signed DPA?</h2>
        <p class="lede">Our team can provide security questionnaire responses, certification evidence, and signed data processing documentation for procurement review.</p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-primary">Contact us</a>
        </div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 130px 0 0; }
  .overview-card { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center;
    background: linear-gradient(120deg, rgba(48,226,244,0.08), rgba(38,158,198,0.02)); border-color: var(--line-strong); }
  .overview-card h2 { margin: 6px 0 12px; }
  .overview-card .lede { margin-bottom: 22px; }
  .overview-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .overview-fact { border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 14px 16px; background: var(--panel); }
  .overview-fact b { display: block; font-family: var(--font-display); color: var(--ink); font-size: 1.05rem; }
  .overview-fact span { color: var(--mute); font-size: 0.82rem; }
  .faq-title { margin: 8px 0 22px; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .faq-item { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--panel); padding: 4px 20px; }
  .faq-item summary { cursor: pointer; padding: 16px 0; font-weight: 600; color: var(--ink); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { color: var(--cyan); }
  .faq-item p { color: var(--mute); padding: 0 0 16px; line-height: 1.65; margin: 0; }
  .faq-more { color: var(--mute); margin-top: 18px; font-size: 0.92rem; }
  .faq-more a { color: var(--cyan); }
  .page-head h1 { margin: 8px 0 18px; max-width: 20ch; }
  .trust-grid { gap: 24px; }
  .trust-card { text-decoration: none; display: flex; flex-direction: column; cursor: pointer; }
  .trust-card h3 { margin-bottom: 10px; }
  .trust-card p { color: var(--mute); font-size: 0.95rem; line-height: 1.6; }
  .trust-card .link-arrow { margin-top: auto; padding-top: 14px; }
  .policies-card { background: linear-gradient(120deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02)); border-color: var(--line-strong); }
  .policies-card h2 { margin: 6px 0 14px; }
  .policy-links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 20px; }
  .policy-link { font-size: 0.9rem; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-strong); padding-bottom: 2px; }
  .policy-link:hover { color: var(--cyan); border-color: var(--cyan); }
  .policy-link--all { color: var(--cyan); border: none; font-weight: 500; }
  .cta-block {
    text-align: center;
    padding: clamp(36px, 6vw, 64px);
    background: linear-gradient(160deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02));
    border-color: var(--line-strong);
  }
  .cta-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--cyan); margin-bottom: 16px;
  }
  .cta-block h2 { margin-bottom: 14px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .cta-block .lede { margin: 0 auto 28px; max-width: 540px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .contact-line { font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-top: 22px; }
  @media (max-width: 700px) {
    .trust-grid { grid-template-columns: 1fr; }
    .overview-card { grid-template-columns: 1fr; }
  }
</style>
