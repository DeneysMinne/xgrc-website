---
import Base from '../layouts/Base.astro';
import { milestones, people, stats } from '../data/site.js';

const visibleStats = import.meta.env.DEV ? stats : stats.filter((s) => s.confirmed);

const divisions = [
  { tag: 'Business Solutions', tagline: 'Run the business', color: '#2f5fb0' },
  { tag: 'Application Solutions', tagline: 'Govern & comply', color: '#21895a' },
  { tag: 'Technology Solutions', tagline: 'Build & protect', color: '#6b3fa0' },
  { tag: 'Data Solutions', tagline: 'Know your data', color: '#d97a1f' },
];

const offices = [
  { city: 'Johannesburg', country: 'South Africa', icon: 'ponte' },
  { city: 'Cape Town', country: 'South Africa', icon: 'mountain' },
  { city: 'Milton Keynes', country: 'United Kingdom', icon: 'bigben' },
];
---

<Base title="About Us | XGRC® Software" description="The story of XGRC Software since 2015, and the humans behind the code.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>About Us</span>
      <h1>Built to make governance executable.</h1>
      <p class="lede">XGRC® Software is built and owned by Strategix. Since 2015 we have helped organisations replace fragmented oversight with one secure, auditable platform. ISO 27001:2022 certified, with a presence in Johannesburg, Cape Town and the United Kingdom.</p>
    </div>
  </section>

  <!-- Proof-stats band -->
  {visibleStats.length > 0 && (
    <section class="stats-band">
      <div class="container stats-inner">
        {visibleStats.map((s) => (
          <div class="stat-cell">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Vertical timeline -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Our journey</span>
        <h2>A decade of Driving Compliance®.</h2>
      </div>
      <ol class="timeline">
        {milestones.map((m, i) => (
          <li class={`event ${i % 2 === 0 ? 'is-left' : 'is-right'}`}>
            <div class="node" aria-hidden="true"></div>
            <div class="body">
              <div class="year">{m.year}</div>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Backed by Strategix Group -->
  <section class="section--tight">
    <div class="container">
      <div class="grid cols-2 backing-grid">
        <div>
          <span class="eyebrow"><span class="dot"></span>Ownership & backing</span>
          <h2>Built by an accountable group, not a startup on its own.</h2>
          <p class="lede">XGRC® Software is developed and owned by Strategix Application Solutions (Pty) Ltd, part of the Strategix group. Strategix Business Solutions was founded in 2004; XGRC® followed in 2015, founded by Jacob O'Brien and Stefan Venter, together with Deneys Minne as an executive from Strategix. That backing means dedicated engineering, security and support capacity behind the platform, not a side project.</p>
          <a href="/strategix" class="link-arrow">Explore Strategix Group's full capability &rarr;</a>
        </div>
        <div class="backing-facts">
          <div class="fact"><span class="fact-label">XGRC® founded</span><span class="fact-value">2015</span></div>
          <div class="fact"><span class="fact-label">Certification</span><span class="fact-value">ISO 27001:2022</span></div>
        </div>
      </div>

      <div class="division-block">
        <span class="eyebrow"><span class="dot"></span>One group, four divisions</span>
        <div class="division-grid">
          {divisions.map((d) => (
            <a href="/strategix#model" class="division-card" style={`--div-color:${d.color}`}>
              <span class="division-dot"></span>
              <span class="division-tag">{d.tag}</span>
              <span class="division-tagline">{d.tagline}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="office-block">
        <span class="eyebrow"><span class="dot"></span>Where we work</span>
        <div class="office-grid">
          {offices.map((o) => (
            <div class="office-card">
              <span class="office-icon" aria-hidden="true">
                {o.icon === 'ponte' && (
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M6 21 V9 C6 4.5 8.7 2 12 2 C15.3 2 18 4.5 18 9 V21"></path>
                    <circle cx="12" cy="9.5" r="2.4"></circle>
                    <line x1="4" y1="21" x2="20" y2="21"></line>
                  </svg>
                )}
                {o.icon === 'mountain' && (
                  <svg viewBox="0 0 64 64" width="26" height="26" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 54 H60"></path>
                    <path d="M4 54 L12 36 L19 50 L23 50 L28 28 H44 L52 40 L60 54"></path>
                  </svg>
                )}
                {o.icon === 'bigben' && (
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M8 9 L8 6 L10 6 L10 4 L14 4 L14 6 L16 6 L16 9"></path>
                    <rect x="8" y="9" width="8" height="11"></rect>
                    <circle cx="12" cy="12.5" r="2.6"></circle>
                    <line x1="6" y1="20" x2="18" y2="20"></line>
                  </svg>
                )}
              </span>
              <span class="office-city">{o.city}</span>
              <span class="office-country">{o.country}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Humans behind the code — renders nothing until people[] is populated -->
  {people.length > 0 && (
    <section class="section--tight">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="dot"></span>The humans behind the code</span>
          <h2>{people.length} people, one mission.</h2>
          <p class="lede">Every card is a name and a superpower. The team that builds, secures and supports the platform.</p>
        </div>
        <div class="people">
          {people.map((p) => (
            <div class="person">
              <div class="avatar" aria-hidden="true">{p.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</div>
              <div class="pname">{p.name}</div>
              <div class="power">{p.superpower}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .page-head { padding: 130px 0 0; }
  .page-head h1 { margin: 8px 0 18px; }

  /* proof-stats band */
  .stats-band { padding: 48px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .stats-inner { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .stat-cell { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 24px;
    border-right: 1px solid var(--line); text-align: center; }
  .stat-cell:last-child { border-right: none; }
  .stat-value { font-family: var(--font-display); font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 700;
    color: var(--cyan); letter-spacing: -0.03em; line-height: 1; }
  .stat-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  @media (max-width: 600px) {
    .stats-inner { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(3), .stat-cell:nth-child(4) { border-top: 1px solid var(--line); }
  }

  /* backed by Strategix */
  .backing-grid { align-items: center; gap: clamp(28px, 5vw, 56px); margin-bottom: 56px; }
  .backing-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; align-self: start; }
  .fact { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 18px; }
  .fact-label { display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); margin-bottom: 6px; }
  .fact-value { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; }
  @media (max-width: 700px) { .backing-facts { grid-template-columns: 1fr; } }

  /* four divisions */
  .division-block { margin-bottom: 56px; }
  .division-block .eyebrow { display: block; margin-bottom: 18px; }
  .division-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .division-card {
    display: flex; flex-direction: column; gap: 6px; text-decoration: none;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: 18px; transition: 0.25s var(--ease);
  }
  .division-card:hover { border-color: var(--div-color); background: var(--panel-hover); transform: translateY(-2px); }
  .division-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--div-color); margin-bottom: 4px; }
  .division-tag { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .division-tagline { font-family: var(--font-mono); font-size: 11px; color: var(--mute); letter-spacing: 0.03em; }
  @media (max-width: 820px) { .division-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .division-grid { grid-template-columns: 1fr; } }

  /* where we work */
  .office-block .eyebrow { display: block; margin-bottom: 18px; }
  .office-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .office-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: 26px 18px; transition: 0.25s var(--ease);
  }
  .office-card:hover { border-color: var(--line-strong); background: var(--panel-hover); transform: translateY(-2px); }
  .office-icon { color: var(--cyan); display: flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 14px; background: rgba(48,226,244,0.08); margin-bottom: 4px; }
  .office-city { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; }
  .office-country { font-family: var(--font-mono); font-size: 11px; color: var(--mute); letter-spacing: 0.04em; }
  @media (max-width: 700px) { .office-grid { grid-template-columns: 1fr; } }

  /* timeline — centered spine, events alternating left/right */
  .timeline { list-style: none; position: relative; margin: 0 auto; max-width: 880px; padding: 8px 0; }
  .timeline::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%);
    background: linear-gradient(180deg, var(--cyan), var(--blue) 60%, transparent); }
  .event { position: relative; width: 50%; box-sizing: border-box; padding-bottom: 44px; }
  .event.is-left { left: 0; padding-right: 44px; text-align: right; }
  .event.is-right { left: 50%; padding-left: 44px; text-align: left; }
  .event .node { position: absolute; top: 3px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--void); border: 2px solid var(--cyan); box-shadow: 0 0 14px rgba(48,226,244,0.6); }
  .event.is-left .node { right: -7px; }
  .event.is-right .node { left: -7px; }
  .event .year { font-family: var(--font-mono); font-size: 13px; color: var(--cyan); margin-bottom: 6px; }
  .event .body h3 { margin-bottom: 6px; }
  .event .body p { font-size: 0.96rem; }
  .event.is-left .body p { margin-left: auto; }
  .event.is-right .body p { margin-right: auto; }
  .event .body p { max-width: 38ch; }

  @media (max-width: 700px) {
    .timeline { padding-left: 40px; max-width: none; }
    .timeline::before { left: 0; transform: none; }
    .event, .event.is-left, .event.is-right {
      width: 100%; left: 0; padding-right: 0; padding-left: 0; text-align: left;
    }
    .event.is-left .node, .event.is-right .node { left: -47px; right: auto; }
    .event.is-left .body p, .event.is-right .body p { margin-left: 0; margin-right: 0; max-width: 60ch; }
  }

  /* people */
  .people { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .person { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 22px;
    display: flex; flex-direction: column; gap: 4px; transition: 0.3s var(--ease); }
  .person:hover { transform: translateY(-4px); border-color: var(--line-strong); background: var(--panel-hover); }
  .avatar { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--green-ink);
    background: linear-gradient(135deg, var(--green), var(--cyan)); margin-bottom: 12px; }
  .pname { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; }
  .power { font-family: var(--font-mono); font-size: 11.5px; color: var(--cyan); letter-spacing: 0.03em; }

  @media (max-width: 820px) { .people { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .people { grid-template-columns: 1fr; } }
</style>
