---
import Base from '../layouts/Base.astro';
import { tourDashboards } from '../data/site.js';
import TourStrip from '../components/TourStrip.astro';
import ProductFrame from '../components/aig/ProductFrame.astro';
import AiActClassifier from '../components/aig/AiActClassifier.astro';

// Copy follows Deneys' AI Governance website brief (29 Sept 2026) and its claims table:
// starter content (not "always up to date"), certification readiness (not "certifies you"),
// people decide (not "fully automated"). No pricing tiers on this page.

const painPoints = [
  { t: 'No single view of the AI in use', b: 'Tools arrive through procurement, SaaS updates and teams trying things. Nobody can list every system, what it does and who owns it.' },
  { t: 'No defensible answer to "is this high risk?"', b: 'The EU AI Act turns on role, purpose and use area. Without a recorded decision, every audit and customer questionnaire starts from zero.' },
  { t: 'Changes and incidents slip past review', b: 'A model is swapped, a data source added, a new capability switched on. Nothing forces the risk, impact or legal review that change should trigger.' },
];

const steps = [
  { t: 'About the system', b: 'Pulled from your AI register, so nothing is typed twice.' },
  { t: 'What it is', b: 'Its EU AI Act tier and your role: provider or deployer.' },
  { t: 'What applies', b: 'Only the requirements that fit that tier and role.' },
  { t: 'Where we stand', b: 'Met, partly met or not met, with the evidence attached.' },
  { t: 'What to do', b: 'Every gap becomes an owned, dated action.' },
  { t: 'Approvals', b: 'Signed off by the right approver, then locked.' },
];

const proof = [
  { t: 'Classify in minutes, defend for years.', b: 'A guided, 18-question EU AI Act decision tree records every answer against its article, then locks the approved result. Re-classifying creates a new version, never an overwrite.' },
  { t: 'Requirements that scope themselves.', b: 'The approved classification decides what applies, so a low-risk system is not buried in high-risk obligations. A limited-risk deployer sees a short list, not the whole Act.' },
  { t: 'Change triggers governance.', b: 'A new model, data source or purpose opens the right reviews, with due dates, through 39 editable rules. A person always decides the outcome.' },
  { t: 'Oversight you can evidence.', b: 'Human decisions, overrides and interventions are recorded, including events sent from your AI tools. A tool-reported event only counts once a person promotes it.' },
  { t: 'Ready for ISO/IEC 42001.', b: 'The AI management system, a Statement of Applicability, and one control library mapped once across every framework you run.' },
];

const capabilities = [
  { h: 'Assess', items: ['EU AI Act classification', 'Compliance and applicability', 'AI impact assessment', 'AI risk management'] },
  { h: 'Run and watch', items: ['Human oversight evidence', 'AI incident management with regulator clocks', 'AI change governance', 'Controls and evidence testing'] },
  { h: 'Govern', items: ['ISO/IEC 42001 management system', 'Governance library: frameworks and policies', 'Approval authority matrix', 'Dashboard and health rules'] },
];

const facts = [
  { v: '18', l: 'question EU AI Act decision tree' },
  { v: '39', l: 'editable change rules' },
  { v: '34', l: 'editable health rules' },
  { v: '7', l: 'approval types, separate from edit rights' },
  { v: '12', l: 'AI risk categories' },
  { v: '13', l: 'AI incident types' },
];

const frameworks = [
  { n: 'ISO/IEC 42001', r: '65 requirements' },
  { n: 'EU AI Act', r: '32 requirements' },
  { n: 'GDPR', r: '13 requirements' },
  { n: 'POPIA', r: '10 requirements' },
];

const faqs = [
  { q: 'What is AI governance software?', a: 'AI governance software keeps a governed record of every AI system an organisation builds or uses: what it is, which rules apply to it, its risks and impacts, the controls and evidence behind it, who oversees it and how changes are reviewed. XGRC® AI Governance does this inside the XGRC® platform, for the EU AI Act, ISO/IEC 42001, POPIA and GDPR.' },
  { q: 'Do we need the EU AI Act if we are in South Africa?', a: 'If you offer AI outputs into the EU, or serve EU customers, it can apply. XGRC® helps you decide whether it applies to each system and records why, so the answer is defensible later.' },
  { q: 'Does XGRC certify us for ISO/IEC 42001?', a: 'No tool certifies you; only an accredited certification body can. XGRC® gives you the AI management system, the evidence and the Statement of Applicability an auditor looks for.' },
  { q: 'Can we use our own AI policies?', a: 'Yes. Upload your AI policy and map its requirements alongside the standards, so one control can satisfy your policy and the regulations at the same time.' },
  { q: 'Is the framework content kept up to date automatically?', a: 'XGRC® includes starter content for ISO/IEC 42001, the EU AI Act, GDPR and POPIA. Your team adopts it and maintains its own copy, and every published version is recorded with what changed, why, by whom and which records need updating.' },
  { q: 'How is this different from MAIA®?', a: 'MAIA® is governed AI you use inside XGRC®, an AI copilot with a full interaction audit trail. AI Governance governs every AI system your organisation builds or uses, including MAIA®, third-party models and in-house builds. MAIA® is itself one more AI system that goes through the same classification, risk and compliance process.' },
  { q: 'Does XGRC replace our AI register?', a: 'No. Your AI register stays the source of truth for what AI exists. XGRC® connects to it and attaches governance on top: classification, compliance, impact, risk, controls, oversight, incidents and change. If you have no register, systems can be recorded in XGRC® directly.' },
  { q: 'What happens if an AI system changes after it was classified?', a: 'Change Governance judges the change in governance terms. A new capability, for example, forces a legal re-classification within 7 days and an impact reassessment within 21 days; a model replacement forces risk, compliance, control re-testing, oversight and classification reviews. The 39 rules are editable, and a person decides every outcome.' },
  { q: 'Do we need a separate risk register for AI?', a: 'No. AI risk uses the same risk discipline you already run in XGRC®, pointed at 12 AI failure categories such as bias, fabrication, data leakage, performance drift and security or adversarial attacks. A legally prohibited use can never be accepted as a risk.' },
];

const pageUrl = 'https://xgrcsoftware.com/ai-governance/';
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': pageUrl + '#software',
      name: 'XGRC® AI Governance',
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'AI governance software',
      operatingSystem: 'Web',
      url: pageUrl,
      description: 'AI governance software inside the XGRC® platform: EU AI Act classification, ISO/IEC 42001 readiness, POPIA and GDPR compliance, AI impact assessment, AI risk, controls and evidence, human oversight, AI incidents and change governance, connected to your AI register.',
      featureList: capabilities.flatMap((c) => c.items).concat(['AI register connection', 'Governance library with starter content for ISO/IEC 42001, EU AI Act, GDPR and POPIA']),
      isPartOf: { '@type': 'SoftwareApplication', name: 'XGRC® Software', url: 'https://xgrcsoftware.com/grc-software/' },
      provider: { '@type': 'Organization', name: 'XGRC® Software', url: 'https://xgrcsoftware.com' },
      audience: { '@type': 'BusinessAudience', audienceType: 'Risk, compliance, information security, privacy and AI leaders' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://xgrcsoftware.com/solutions/' },
        { '@type': 'ListItem', position: 3, name: 'AI Governance', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
});
---

<Base
  title="AI Governance Software | EU AI Act & ISO 42001 | XGRC"
  description="Govern every AI system in one place. EU AI Act classification, ISO/IEC 42001 readiness, POPIA and GDPR compliance, risk, incidents and oversight."
  ogImage="/assets/og/og-ai-governance.jpg"
>
  <script type="application/ld+json" set:html={schema} />

  <!-- 1. Hero -->
  <section class="aig-hero">
    <div class="container aig-hero-grid">
      <div class="aig-hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/solutions/">Solutions</a><span>/</span><span aria-current="page">AI Governance</span></nav>
        <span class="eyebrow"><span class="dot"></span>XGRC® AI Governance</span>
        <h1>Govern every AI system, <em>from register to regulator.</em></h1>
        <p class="lede">Your teams are already using AI. XGRC® AI Governance software shows what each system is, what the law expects of it, and whether it is under control. EU AI Act, ISO/IEC 42001, POPIA and GDPR in one place.</p>
        <div class="aig-actions">
          <a class="btn btn-primary" href="/demo/">Book an AI Governance demo</a>
          <a class="btn btn-ghost" href="#classify">See how classification works</a>
        </div>
        <ul class="badges" aria-label="Frameworks covered">
          <li>EU AI Act</li><li>ISO/IEC 42001</li><li>POPIA</li><li>GDPR</li>
        </ul>
      </div>
      <div class="aig-hero-visual">
        <ProductFrame active="dashboard" title="AI Governance · Dashboard" label="Illustration of the AI Governance dashboard: estate tiles, system health and EU AI Act categories">
          <div class="ill-dash">
            <div class="ill-title">AI Governance Dashboard</div>
            <div class="ill-alert"><b>Legal or serious, act now</b><span>1 banned-use flag · 1 incident on a regulator clock, 9 days left</span></div>
            <div class="ill-tiles">
              <div><b>24</b><span>AI systems</span></div>
              <div><b>18</b><span>In production</span></div>
              <div class="amb"><b>4</b><span>High risk</span></div>
              <div class="red"><b>1</b><span>Prohibited</span></div>
              <div><b>2</b><span>Never classified</span></div>
              <div class="amb"><b>5</b><span>No approved assessment</span></div>
            </div>
            <div class="ill-row">
              <div class="ill-panel">
                <div class="ill-ph">System health</div>
                <div class="ill-health"><i class="r" style="flex:3"></i><i class="a" style="flex:7"></i><i class="g" style="flex:14"></i></div>
                <div class="ill-legend"><span><i class="r"></i>3 red</span><span><i class="a"></i>7 amber</span><span><i class="g"></i>14 green</span></div>
              </div>
              <div class="ill-panel">
                <div class="ill-ph">EU AI Act category</div>
                <ul class="ill-bars">
                  <li><span>Prohibited</span><i style="--w:4%" class="r"></i><b>1</b></li>
                  <li><span>High risk</span><i style="--w:17%" class="a"></i><b>4</b></li>
                  <li><span>Limited</span><i style="--w:38%" class="c"></i><b>9</b></li>
                  <li><span>Minimal</span><i style="--w:33%" class="g"></i><b>8</b></li>
                  <li><span>Not classified</span><i style="--w:8%" class="m"></i><b>2</b></li>
                </ul>
              </div>
            </div>
          </div>
        </ProductFrame>
      </div>
    </div>
  </section>

  <!-- Definition + facts (clear, citable statements for search and AI answers) -->
  <section class="section--tight aig-define">
    <div class="container">
      <p class="define"><strong>XGRC® AI Governance</strong> is AI governance software built into the XGRC® platform. It takes each AI system from "what is it?" to "approved, controlled and monitored", runs the organisation-level ISO/IEC 42001 management system on top, and is rule-driven end to end: the classification decides what applies, and a change decides what must be reviewed.</p>
      <ul class="facts">
        {facts.map((f) => <li><b>{f.v}</b><span>{f.l}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 2. The problem -->
  <section class="section aig-problem">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>The problem</span>
        <h2>AI moved faster than your governance.</h2>
        <p class="lede">New tools arrive every month. Models change without notice. Regulators now expect you to know which AI you use, what risk it carries and who is watching it. A policy on paper is no longer enough. You need evidence.</p>
      </div>
      <div class="pains">
        {painPoints.map((p, i) => (
          <div class="pain">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              {i === 0 && <path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6zM3 3l18 18" />}
              {i === 1 && <path d="M12 3v18M7 21h10M5 7h14M5 7l-2.5 6a2.5 2.5 0 0 0 5 0zM19 7l-2.5 6a2.5 2.5 0 0 0 5 0z" />}
              {i === 2 && <path d="M4 9h13l-3-3M20 15H7l3 3M12 2v2M12 20v2" />}
            </svg>
            <h3>{p.t}</h3>
            <p>{p.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How it works -->
  <section class="section aig-how" id="how-it-works">
    <div class="container aig-how-grid">
      <div>
        <div class="section-head">
          <span class="eyebrow"><span class="dot"></span>How it works</span>
          <h2>Six steps from "what is it?" to "approved and in hand".</h2>
          <p class="lede">Every AI system follows the same guided path. XGRC® works out where each system stands from the records you already have.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="sn">{i + 1}</span><div><h3>{s.t}</h3><p>{s.b}</p></div></li>
          ))}
        </ol>
      </div>
      <div class="aig-how-visual">
        <ProductFrame active="dashboard" compact title="Govern This AI System" label="Illustration of the Govern This AI System six-step progress view">
          <div class="ill-gov">
            <div class="ill-sys"><span class="ill-ref">AIS-0014</span><b>Customer Support Assistant</b><span class="ill-pill">Limited risk · Deployer</span></div>
            <div class="ill-prog"><span>Governance progress</span><b>58%</b></div>
            <div class="ill-progbar"><i style="width:58%"></i></div>
            <ol class="ill-steps">
              <li class="done"><i>✓</i><div><b>About the system</b><span>From the AI register</span></div></li>
              <li class="done"><i>✓</i><div><b>What it is</b><span>Limited risk, deployer · approved and locked</span></div></li>
              <li class="done"><i>✓</i><div><b>What applies</b><span>2 of 32 EU AI Act requirements · POPIA scoped</span></div></li>
              <li class="now"><i>4</i><div><b>Where we stand</b><span>9 met · 3 partly met · 1 not met</span></div></li>
              <li><i>5</i><div><b>What to do</b><span>4 owned actions</span></div></li>
              <li><i>6</i><div><b>Approvals</b><span>Awaiting compliance sign-off</span></div></li>
            </ol>
          </div>
        </ProductFrame>
      </div>
    </div>
  </section>

  <!-- 3b. Interactive classifier -->
  <section class="section aig-classify" id="classify">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Try it</span>
        <h2>Is your AI system high risk? Find out in five questions.</h2>
        <p class="lede">A simplified version of how XGRC® classifies an AI system under the EU AI Act. Answer for one system and see the indicative tier and the obligations it brings.</p>
      </div>
      <AiActClassifier />
    </div>
  </section>

  <!-- 4. Proof points -->
  <section class="section aig-proof">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Why it works</span>
        <h2>Governance that runs itself, with people in charge.</h2>
      </div>
      <div class="proof-grid">
        {proof.map((p) => <div class="proof"><h3>{p.t}</h3><p>{p.b}</p></div>)}
      </div>
      <div class="proof-visuals">
        <ProductFrame active="classification" compact title="AI Act Classification · AIC-0007" label="Illustration of an approved EU AI Act classification result with tier, role and generated obligations">
          <div class="ill-cls">
            <div class="ill-cls-h"><b>Customer Support Assistant</b><span class="ill-lockd">Approved · v2 · locked</span></div>
            <div class="ill-kv"><span>Tier</span><b class="c">Limited risk</b></div>
            <div class="ill-kv"><span>Role</span><b>Deployer</b></div>
            <div class="ill-kv"><span>Rights impact assessment (Art. 27)</span><b>Not required</b></div>
            <div class="ill-kv"><span>Question set</span><b>2026.10 · 18 of 18 answered</b></div>
            <div class="ill-ph">Generated obligations</div>
            <ul class="ill-list"><li>Transparency to users <em>Art. 50</em></li><li>AI literacy for operators <em>Art. 4</em></li></ul>
          </div>
        </ProductFrame>
        <ProductFrame active="change" compact title="Change Governance · Rule Set" label="Illustration of Change Governance rules turning a change into dated reviews">
          <div class="ill-chg">
            <div class="ill-chg-rec"><span class="ill-ref">Change</span><b>Assistant can now issue refunds</b><span class="ill-pill amb">New capability · significant</span></div>
            <div class="ill-ph">Reviews triggered by rule</div>
            <ul class="ill-rev">
              <li><b>Legal re-classification</b><span>AI Act Classification</span><em>Due in 7 days</em></li>
              <li><b>Impact reassessment</b><span>Impact Assessment</span><em>Due in 21 days</em></li>
            </ul>
            <p class="ill-foot">39 editable rules · a person decides every outcome</p>
          </div>
        </ProductFrame>
      </div>
      <div class="aig-actions center"><a class="btn btn-primary" href="/demo/">Book an AI Governance demo</a></div>
    </div>
  </section>

  <!-- 5. Capability grid -->
  <section class="section aig-caps">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Capabilities</span>
        <h2>Everything AI governance software needs, in one module.</h2>
      </div>
      <div class="caps">
        {capabilities.map((c) => (
          <div class="cap"><h3>{c.h}</h3><ul>{c.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      <p class="caps-note">Connect your AI register, monitoring tools and AI agents so XGRC® stays in step automatically. Connections are configured per source.</p>
      <div class="fw">
        <span class="fw-h">Starter content included</span>
        {frameworks.map((f) => <span class="fw-i"><b>{f.n}</b>{f.r}</span>)}
        <span class="fw-i"><b>Your AI policy</b>map it alongside</span>
      </div>
    </div>
  </section>

  <TourStrip
    items={tourDashboards.filter((d) => d.solution === 'ai-governance')}
    eyebrow="Explore it live"
    heading="See an AI governance dashboard running."
    lede="An interactive demonstration dashboard with fictitious data: EU AI Act classification, ISO/IEC 42001 controls and the gaps between systems. Filter it, open any KPI and export a board pack."
  />

  <!-- 6. Built into XGRC -->
  <section class="section--tight aig-built">
    <div class="container">
      <div class="built">
        <div>
          <span class="eyebrow"><span class="dot"></span>For XGRC® clients</span>
          <h2>Already on XGRC? Add AI Governance.</h2>
          <p class="lede">AI Governance uses the same platform, users, business units, Document Manager and approval flows you already run. It works alongside XGRC® <a href="/erm/">Risk</a>, <a href="/use-cases/incident-management/">Incident</a> and <a href="/compliance-hub/">Compliance</a>, so AI is governed like everything else in your business. No new system to buy, host or train on.</p>
        </div>
        <a class="btn btn-primary" href="/contact/">Talk to us about adding AI Governance</a>
      </div>
    </div>
  </section>

  <!-- 7. Resource -->
  <section class="section--tight aig-resource">
    <div class="container">
      <div class="res">
        <div>
          <span class="eyebrow"><span class="dot"></span>Free checklist</span>
          <h2>Where do you stand on the EU AI Act?</h2>
          <p class="lede">One checklist covering what ISO/IEC 42001 and the EU AI Act actually require: classification and role, management system essentials, Statement of Applicability, impact, controls, oversight, incidents and change.</p>
          <p class="res-links">New to the standard? Read <a href="/insights/what-is-iso-42001/">what ISO/IEC 42001 is</a>, or see <a href="/use-cases/ai-governance-readiness/">the eight steps to AI governance readiness</a>.</p>
        </div>
        <a class="btn btn-ghost" href="/use-cases/ai-governance-readiness/#resource">Download the AI Governance Readiness Checklist</a>
      </div>
    </div>
  </section>

  <!-- 8. Closing + FAQ -->
  <section class="section aig-faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Questions</span>
        <h2>AI governance questions, answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="section aig-close" id="contact">
    <div class="container">
      <div class="close-card">
        <h2>Know your AI. Prove it is under control.</h2>
        <p class="lede">See every AI system, its EU AI Act position and its evidence in one place, inside the platform you already trust.</p>
        <a class="btn btn-primary" href="/demo/">Book an AI Governance demo</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .aig-hero { padding: clamp(40px, 7vw, 88px) 0 clamp(28px, 4vw, 48px); overflow: hidden; }
  .aig-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .crumbs { display: flex; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin-bottom: 18px; }
  .crumbs a { color: var(--mute); text-decoration: none; } .crumbs a:hover { color: var(--cyan); }
  .aig-hero h1 { margin: 18px 0 18px; font-size: clamp(2.3rem, 4.8vw, 3.9rem); text-wrap: balance; }
  .aig-hero h1 em { font-style: normal; color: var(--cyan); }
  .aig-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .aig-actions.center { justify-content: center; margin-top: 36px; }
  .badges { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .badges li { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--ink); border: 1px solid var(--line-strong); border-radius: 7px; padding: 7px 11px; background: rgba(48,226,244,0.05); }
  .aig-hero-visual { transform: perspective(1400px) rotateY(-6deg); transform-origin: left center; }

  /* illustrations (product palette comes from ProductFrame) */
  .ill-title { font-family: var(--font-display); font-weight: 600; font-size: 15px; margin-bottom: 10px; color: #e9eef5; }
  .ill-alert { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; border: 1px solid rgba(255,84,112,0.45); background: rgba(255,84,112,0.10); border-radius: 9px; padding: 8px 10px; font-size: 11px; color: #ffb3c0; margin-bottom: 12px; }
  .ill-alert b { color: #ff8fa3; }
  .ill-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 12px; }
  .ill-tiles div { border: 1px solid rgba(255,255,255,0.08); border-radius: 9px; background: #1b2636; padding: 9px 10px; display: grid; gap: 2px; }
  .ill-tiles b { font-family: var(--font-display); font-size: 20px; color: #e9eef5; line-height: 1.1; }
  .ill-tiles span { font-size: 10px; color: #9aa8ba; }
  .ill-tiles .amb b { color: #ffc96b; } .ill-tiles .red b { color: #ff8fa3; }
  .ill-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 8px; }
  .ill-panel { border: 1px solid rgba(255,255,255,0.08); border-radius: 9px; background: #1b2636; padding: 10px; }
  .ill-ph { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: #9aa8ba; margin: 0 0 8px; font-family: var(--font-mono); }
  .ill-health { display: flex; height: 12px; border-radius: 6px; overflow: hidden; gap: 2px; }
  .ill-health i, .ill-legend i, .ill-bars i { display: block; }
