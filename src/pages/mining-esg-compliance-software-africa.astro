---
import Base from '../layouts/Base.astro';
import LogoTile from '../components/LogoTile.astro';
import { brand } from '../data/site.js';

const faqs = [
  { q: 'What does mining ESG compliance software do?', a: 'It gives mining and heavy-industry operations one auditable system for the environmental, social and governance obligations that investors, lenders and regulators now require, from environmental monitoring and water use licences to social and labour plan commitments and board-level ESG disclosure.' },
  { q: 'Does it support South African and SADC mining regulation?', a: 'Yes. XGRC® is used across Southern Africa and supports the environmental authorisations under NEMA, water use licences under the National Water Act, Mine Health and Safety Act obligations, and the governance disclosures expected under King V and JSE sustainability requirements, alongside international frameworks such as GRI and ICMM.' },
  { q: 'How does it connect environmental data to ESG reporting?', a: 'ENVIRX® captures air, water, waste, energy and biodiversity monitoring across every site, and shares one data foundation with XGRC® ESG, so environmental performance flows straight into sustainability disclosures without re-entry or reconciliation.' },
  { q: 'Is it suitable for multi-country operations?', a: 'Yes. The platform consolidates ESG and compliance data across sites and countries into one auditable view, which suits mining groups operating across South Africa, Namibia, Botswana, Zambia and Mozambique.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const pillars = [
  { t: 'Environmental (E)', b: 'Water use licences, atmospheric emissions, waste, energy and biodiversity monitoring across every operation, aligned to NEMA and ISO 14001.' },
  { t: 'Social (S)', b: 'Social and Labour Plan commitments, community engagement, health, safety and workforce obligations under the Mine Health and Safety Act, tracked to closure.' },
  { t: 'Governance (G)', b: 'Board reporting, risk appetite and disclosure aligned to King V, JSE sustainability requirements and international frameworks such as GRI and ICMM.' },
];

// Real customers in mining and heavy industry (data mirrors the /customers page,
// rendered with the shared LogoTile so the look matches the rest of the site).
const logos = [
  { name: 'African Rainbow Minerals',    logo: 'ARM.jpg',                url: 'https://arm.co.za/' },
  { name: 'Rosh Pinah Zinc Corporation', logo: 'Rosh-Pinah-Zinc.jpg',    url: 'https://www.roshpinahzinc.com/' },
  { name: 'Fraser Alexander',            logo: 'Fraser-Alexander.jpg',   url: 'https://www.fraseralexander.com/' },
  { name: 'Sandton Plant Hire',          logo: 'Sandton-Plant-Hire.jpg', url: 'https://sandtonplant.co.za/', caseStudySlug: 'sandton-plant-hire' },
  { name: 'Scaw Metals Group',           logo: 'SCAW.png',               url: 'https://www.scaw.co.za/' },
  { name: 'WACO Africa',                 logo: 'WacoAfrica.png',         url: 'https://www.wacoafrica.co.za/' },
];
---

<Base
  title="Mining ESG Compliance Software for Africa | XGRC®"
  description="Mining ESG compliance software for Africa, environmental, social and governance obligations on one auditable platform. Built for South African and SADC mining regulation, and trusted by African Rainbow Minerals, Rosh Pinah Zinc and Fraser Alexander."
>
  <script type="application/ld+json" set:html={schema} />

  <section class="geo-hero">
    <div class="geo-hero-glow" aria-hidden="true"></div>
    <div class="container geo-hero-inner">
      <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Mining ESG compliance software (Africa)</span></div>
      <h1>Mining ESG compliance software for Africa.</h1>
      <p class="lede">For mining companies across South Africa and the SADC region, ESG compliance now decides access to capital, not just regulatory standing. XGRC® gives mining and heavy-industry operations one auditable platform for environmental, social and governance obligations, built for local regulation and international disclosure alike.</p>
      <div class="geo-actions">
        <a href="/demo" class="btn btn-primary">Request a demo</a>
        <a href="/esg/" class="btn btn-ghost">Explore ESG &rarr;</a>
      </div>
      <div class="std-strip">
        {['NEMA', 'Mine Health & Safety Act', 'National Water Act', 'King V', 'GRI', 'ICMM'].map((s) => (<span class="std-badge">{s}</span>))}
      </div>
    </div>
  </section>

  <section class="section--tight logo-band">
    <div class="container">
      <p class="logo-lead">Trusted across African mining and heavy industry</p>
      <div class="logo-grid">
        {logos.map((l) => (<LogoTile name={l.name} logo={l.logo} url={l.url} caseStudySlug={l.caseStudySlug} />))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>The full ESG picture</span>
        <h2>Environmental, social and governance, on one platform.</h2>
        <p class="lede">ESG is not a single report. It is a continuous obligation across three fronts, and mining groups lose credibility when the data behind each is scattered across sites, consultants and spreadsheets.</p>
      </div>
      <div class="grid cols-3">
        {pillars.map((p) => (<div class="card"><h3>{p.t}</h3><p class="mute">{p.b}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Why African mining operations choose XGRC®</span>
        <h2>One auditable ESG record, across every site and country.</h2>
        <p class="lede">XGRC® Software is a governance, risk and compliance platform certified to ISO 27001:2022 by BSI. For mining, ENVIRX® captures environmental monitoring across every operation while XGRC® ESG consolidates social and governance disclosure, all on one data foundation. The result is a single, defensible ESG record that stands up to investor due diligence, lender ESG covenants and DMRE scrutiny, whether you operate in one province or across the SADC region.</p>
        <div class="geo-actions">
          <a href="/esg/" class="link-arrow">Explore XGRC® ESG &rarr;</a>
          <a href="/envirx/" class="link-arrow">Explore ENVIRX® &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head"><span class="eyebrow"><span class="dot"></span>Frequently asked</span><h2>Mining ESG compliance in Africa.</h2></div>
      <div class="faq-list">
        {faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-block">
        <div class="cta-tag"><span class="dot"></span>Mining ESG compliance</div>
        <h2>See XGRC® against your own ESG obligations.</h2>
        <p class="lede">Talk to an XGRC® specialist about how ESG and ENVIRX® fit your operations, disclosure duties and lender requirements across Africa.</p>
        <div class="cta-actions"><a href="/demo" class="btn btn-primary">Request a live demo</a><a href="/esg/" class="btn btn-ghost">Explore ESG</a></div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .geo-hero { padding: 130px 0 56px; position: relative; overflow: hidden; }
  .geo-hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 55% at 15% 0%, rgba(48,226,244,0.08) 0%, transparent 65%); }
  .geo-hero-inner { max-width: 820px; position: relative; }
  .geo-hero h1 { font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -0.04em; line-height: 1.02; margin: 12px 0 18px; background: linear-gradient(135deg, var(--ink) 45%, var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .geo-hero .lede { max-width: 720px; margin-bottom: 28px; }
  .geo-actions { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 26px; align-items: center; }
  .std-strip { display: flex; flex-wrap: wrap; gap: 10px; }
  .std-badge { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--cyan); border: 1px solid rgba(48,226,244,0.25); border-radius: 100px; padding: 6px 14px; background: rgba(48,226,244,0.05); }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin-bottom: 18px; }
  .breadcrumb a { color: var(--mute); text-decoration: none; } .breadcrumb a:hover { color: var(--cyan); }
  .logo-band { padding-top: 8px; }
  .logo-lead { text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); margin-bottom: 22px; }
  .logo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; max-width: 800px; margin: 0 auto; }
  .card h3 { color: var(--ink); margin-bottom: 8px; font-size: 1.05rem; }
  .mute { color: var(--mute); font-size: 0.95rem; line-height: 1.6; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .faq-item { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--panel); padding: 4px 20px; }
  .faq-item summary { cursor: pointer; padding: 16px 0; font-weight: 600; color: var(--ink); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { color: var(--cyan); }
  .faq-item p { color: var(--mute); padding: 0 0 16px; line-height: 1.65; }
  .cta-block { text-align: center; padding: clamp(36px, 6vw, 64px); background: linear-gradient(160deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02)); border-color: var(--line-strong); }
  .cta-tag { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cyan); margin-bottom: 16px; }
  .cta-block h2 { margin-bottom: 14px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .cta-block .lede { margin: 0 auto 28px; max-width: 540px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .contact-line { font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-top: 22px; }
  @media (max-width: 640px) { .logo-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; } }
</style>
