---
import Base from '../layouts/Base.astro';
import SsotConvergence from '../components/SsotConvergence.astro';
import { brand, caseStudies, tourDashboards } from '../data/site.js';
import { publishedComparisons } from '../data/comparisons.js';

const compareLinks = publishedComparisons.filter((c) => c.linkFrom.includes('grc-software'));

const capabilities = [
  {
    tag: 'Governance',
    title: 'Policy, Governance & Board Reporting',
    body: 'Manage policies, document controls, board reporting, and stakeholder oversight from a single governance hub.',
    href: '/msx/',
  },
  {
    tag: 'Risk',
    title: 'Enterprise Risk Management',
    body: 'Identify, assess, and treat enterprise risk using a consistent framework aligned to ISO 31000 and COSO.',
    href: '/erm/',
  },
  {
    tag: 'Compliance',
    title: 'Compliance & Regulation',
    body: 'Track obligations across ISO standards, GDPR, POPIA, PAIA, and industry regulations with real-time compliance status.',
    href: '/compliance-hub/',
  },
  {
    tag: 'Data Protection',
    title: 'Data Protection & Privacy',
    body: 'Manage GDPR and POPIA obligations, data subject access requests, privacy impact assessments, and data breach response.',
    href: '/msxcyber/',
  },
  {
    tag: 'Assurance',
    title: 'Internal Audit & Assurance',
    body: 'Plan, execute, and manage the full internal audit lifecycle, linked to risks, controls, and corrective actions.',
    href: '/integrated-assurance/',
  },
  {
    tag: 'ESG',
    title: 'ESG, Safety & Operations',
    body: 'Collect and report ESG data, manage safety incidents and inspections, aligned to ISO 45001, ISO 14001, and GRI.',
    href: '/esg/',
  },
];

// What GRC software does, mapped to the XGRC® solution that delivers each job.
const grcJobs = [
  { title: 'Risk management', body: 'Risk registers, likelihood and impact scoring, risk appetite thresholds, key risk indicators and treatment plans, aligned to ISO 31000 and COSO.', href: '/erm/', label: 'Enterprise risk management software' },
  { title: 'Compliance obligations', body: 'Obligations across ISO standards, GDPR, POPIA, PAIA and industry regulations with real-time compliance status, plus jurisdiction-specific regulatory intelligence from Libryo.', href: '/use-cases/regulatory-compliance/', label: 'Regulatory compliance' },
  { title: 'Policies and governance execution', body: 'XLOGIC® converts policies, frameworks, controls and obligations into structured workflows with accountability, evidence capture and auditability.', href: '/xlogic/', label: 'XLOGIC®' },
  { title: 'Audit and assurance', body: 'Risk-based internal audit planning, fieldwork, findings and a combined assurance matrix that maps every assurance provider to the risks they cover.', href: '/integrated-assurance/', label: 'Integrated Assurance' },
  { title: 'Incidents and corrective actions', body: 'Incidents, inspections and non-conformances captured in the field, including offline in the SHEQX® iOS and Android apps, with corrective actions assigned and tracked to closure.', href: '/sheqx/', label: 'SHEQX®' },
  { title: 'Reporting, evidence and governed AI', body: 'Executive dashboards and board reporting from live data, an audit trail behind every record, and MAIA® governed AI with a full AI interaction audit trail.', href: '/tour/', label: 'Take the live tour' },
];

// Buyer's checklist: how to choose GRC software.
const checklist = [
  { title: 'One data model, not a bundle', body: 'Ask whether risks, controls, obligations, audits and actions share one data model, or are separate modules sold together. Integrated GRC software links them without reconciliation.' },
  { title: 'Your frameworks and laws', body: 'Check coverage of the standards and regulations you answer to, for example ISO 27001, ISO 9001, ISO 14001, ISO 45001 and ISO 31000, GDPR, and in South Africa POPIA, PAIA and King V.' },
  { title: 'Start small, then expand', body: 'You should be able to go live with one discipline and add others module by module, rather than commit to a single big-bang rollout.' },
  { title: 'Board-ready reporting', body: 'Dashboards and board packs should draw on current data, with an audit trail behind every figure, instead of being assembled by hand each quarter.' },
  { title: 'Adoption by real users', body: 'Look for single sign-on, mobile capture for field teams and the languages your people work in. XGRC® supports Microsoft Entra ID sign-on and runs in English, Portuguese, French and Spanish.' },
  { title: 'Integration with what you run', body: 'The platform should sit alongside your HR, ERP and IT systems rather than replace them, with API-based integration for data exchange where required.' },
  { title: 'Independent security assurance', body: 'Ask for current certification and the hosting region. XGRC® is certified to ISO/IEC 27001:2022 and hosted in Microsoft Azure West Europe (Netherlands).' },
];

// GRC software compared with the usual alternatives (factual, no vendor names).
const comparison = [
  ['Spreadsheets and email', 'Early-stage programmes with few obligations, risks and owners.', 'No reliable change history, no enforced ownership and no links between risks, controls and evidence. Audit evidence is assembled reactively, and the spreadsheet becomes a source of risk in its own right.'],
  ['Point solutions (separate risk, audit, ESG and compliance tools)', 'Solving one discipline quickly.', 'Each tool has its own data model, so the links between a risk, its controls, its audit findings and its actions are rebuilt by hand every reporting cycle.'],
  ['Integrated GRC platform', 'Organisations with several regulations, business units or sites that need one defensible view of governance, risk and compliance.', 'Plan the rollout in phases: start with one discipline, agree common classifications and owners, then expand module by module.'],
];

const globalFrameworks = ['GDPR', 'ISO 27001', 'ISO 9001', 'ISO 14001', 'ISO 45001', 'ISO 22000', 'ISO 31000'];
const localFrameworks  = ['POPIA', 'PAIA', 'King V'];


const whyPoints = [
  { stat: '800+',        label: 'Companies',     body: 'Organisations across Africa, Europe, Australia and the Americas trust XGRC® to drive compliance at enterprise scale, a global platform, wherever they operate.' },
  { stat: 'ISO 27001',    label: ':2022 Certified', body: 'The XGRC® platform is certified to the latest international standard for information security management.' },
  { stat: '1',           label: 'Platform',       body: 'One auditable data layer across governance, risk, compliance, ESG, and data protection, no double-entry, no tool sprawl.' },
  { stat: 'SA + UK',     label: 'Regulations',    body: 'Purpose-built for South African and UK regulatory environments, POPIA, PAIA, King V, and GDPR, in a single platform.' },
];

const faqs = [
  { q: 'What is GRC software?', a: 'GRC software brings governance, risk management and compliance activities onto one platform, so policies, risks, controls, audits and obligations are tracked in one auditable place instead of spreadsheets and email. XGRC® adds ESG and data protection (GDPR/POPIA) on the same foundation.' },
  { q: 'What is the purpose of a GRC tool?', a: 'A GRC tool gives leadership one auditable view of governance, risk and compliance. It holds the risk register, controls, policies, obligations, audits and actions together, assigns owners and tracks every action to closure, so evidence is ready when auditors, regulators or the board ask for it.' },
  { q: 'What are GRC software solutions?', a: 'GRC software solutions are the applications that run governance, risk and compliance work: risk registers, policy and obligation management, internal audit, incident and corrective action tracking, and board reporting. They are sold either as separate point solutions or as one integrated GRC platform. XGRC® provides them as specialist solutions on one shared data foundation.' },
  { q: 'What is a GRC platform?', a: 'A GRC platform is GRC software built on one data foundation that several disciplines share, so risk, compliance, audit, ESG and data protection teams work from the same records. Unlike a collection of separate tools, a control, the risk it treats, the obligation it satisfies and the audit that tested it stay linked automatically.' },
  { q: 'What is integrated GRC software?', a: 'Integrated GRC software manages governance, risk and compliance on one connected system rather than in separate tools. A compliance failure updates the risk picture, an audit finding raises a tracked corrective action, and the board sees one current view. XGRC® is built this way, with Enterprise Risk Management, Integrated Assurance, SHEQX®, MSXCyber®, ESG and other solutions sharing one auditable data layer.' },
  { q: 'How do I choose GRC software?', a: 'Start with the frameworks and regulations you must meet. Then check whether the platform holds risks, controls, obligations, audits and actions on one data model, whether you can go live with one discipline and expand, how board reporting is produced, how it handles sign-on, mobile use and languages, how it integrates with your existing systems, and what independent security certification it holds.' },
  { q: 'What is the difference between GRC software and ERM software?', a: 'ERM software focuses on enterprise risk: the risk register, risk appetite, key risk indicators, treatment and board reporting. GRC software is broader and covers governance and compliance as well as risk. In XGRC®, Enterprise Risk Management is the risk pillar of the GRC platform, so you can start with ERM and connect compliance and assurance later.', link: { href: '/erm/', label: 'Enterprise risk management software' } },
  { q: 'Is GRC software only for large enterprises?', a: 'No. XGRC® customers range from a single regional operation to the multinational headquarters it reports into. Smaller organisations usually start with one discipline and add more as their obligations grow.' },
  { q: 'How is XGRC® different from point solutions?', a: 'Most organisations run separate tools for risk, audit, ESG and compliance, each with its own data model. XGRC® connects them on one data layer, so a risk links to its controls, its audit findings, and its remediation actions automatically, no duplicate entry, no reconciliation between systems.' },
  { q: 'Does XGRC® support POPIA and GDPR?', a: 'Yes. XGRC® is purpose-built for South African and UK/EU regulatory environments, with dedicated workflows for POPIA, PAIA, King V and GDPR data protection obligations, including data subject access requests and privacy impact assessments.' },
  { q: 'How long does implementation take?', a: 'Implementation scope depends on how many disciplines (risk, audit, ESG, compliance, safety) and business units you bring onto the platform at once. Most customers start with one discipline live within weeks, then expand module by module rather than a single big-bang rollout.' },
  { q: 'Is XGRC® secure and independently certified?', a: 'Yes. The XGRC® platform is certified to ISO/IEC 27001:2022 for information security management, and customer data is hosted in Azure West Europe (Netherlands).' },
  { q: 'Does XGRC® support single sign-on?', a: 'Yes. Users can sign in to the XGRC® platform with their Microsoft work accounts through single sign-on with Microsoft Entra ID (Azure Active Directory), so they use the same sign-in they already have.' },
  { q: 'Which languages is XGRC® available in?', a: 'The XGRC® platform is multilingual. It is available in English, Portuguese, French and Spanish, and can be translated into further languages on request.' },
  { q: 'Can XGRC® be used on mobile devices?', a: 'Yes. SHEQX® has native iOS and Android apps for field work, including offline capture on sites with no signal that syncs when the device reconnects. The rest of the platform runs in any modern browser.' },
  { q: 'Can XGRC® integrate with our existing systems?', a: 'Yes. XGRC® is designed to sit alongside your existing HR, ERP and IT systems rather than replace them, with API-based integration available for data exchange where required.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'XGRC® GRC Software Platform',
      applicationCategory: 'BusinessApplication',
      description: 'GRC software to manage governance, risk, compliance, ESG and data protection (GDPR, POPIA) in one platform.',
      operatingSystem: 'Web',
      provider: { '@type': 'Organization', name: 'XGRC® Software', url: 'https://xgrcsoftware.com' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'GRC Platform' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---
<Base
  title="GRC Software | Integrated GRC Platform & Solutions | XGRC®"
  description="GRC software that unites governance, risk, compliance, ESG and data protection on one integrated GRC platform. ISO 27001:2022 certified, 800+ companies."
  ogImage="/assets/og/og-grc-software.jpg"
>
  <script type="application/ld+json" set:html={schema} />

  <!-- ── Hero ───────────────────────────────────────────── -->
  <section class="grc-hero">
    <div class="container grc-hero-inner">
      <div class="grc-hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><b>GRC Platform</b>
        </nav>
        <span class="eyebrow"><span class="dot"></span>GRC Platform</span>
        <h1>GRC software.<br>Governance, risk &amp; compliance, unified.</h1>
        <p class="lede">GRC software (governance, risk and compliance software) is a platform that manages an organisation's policies, risks, controls, obligations, audits and actions in one connected, auditable system, instead of spreadsheets and separate tools. XGRC® is an integrated GRC platform that adds ESG and data protection on the same foundation, giving your organisation a single version of the truth.</p>
        <div class="hero-actions">
          <a href="/demo/" class="btn btn-primary">Book a Demo</a>
          <a href="/tour/" class="btn btn-ghost">Take the live tour <span aria-hidden="true">&rarr;</span></a>
          <a href="/solutions/" class="btn btn-ghost">Explore solutions</a>
        </div>
        {compareLinks.length > 0 && (
          <p class="compare-links">Comparing options? {compareLinks.map((c, n) => (<>{n > 0 && ' · '}<a href={`/compare/${c.slug}/`}>XGRC® vs {c.competitor}</a></>))}</p>
        )}
      </div>

      <figure class="grc-hero-visual">
        <a class="frame" href="/tour/it-risk-performance.html" aria-label="Open the live IT Risk & Performance Committee dashboard">
          <span class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>xgrcsoftware.com/tour</span></span>
          <img
            src="/assets/tour/hero-itrisk-900-v1.webp"
            srcset="/assets/tour/hero-itrisk-900-v1.webp 900w, /assets/tour/hero-itrisk-1600-v1.webp 1600w"
            sizes="(max-width: 860px) 92vw, 560px"
            width="1600" height="1000"
            alt="XGRC® IT Risk & Performance Committee dashboard showing an inherent vs residual risk heat map and risk appetite by category"
            loading="eager"
          />
        </a>
        <figcaption>Illustrative data. <a href="/tour/">Click through all {tourDashboards.length} dashboards &rarr;</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Platform concept ──────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>The platform</span>
        <h2>One platform. One source of truth.</h2>
        <p class="lede">Most organisations run governance, risk, compliance, and ESG in isolation: separate tools, disconnected data, duplicate effort. XGRC® consolidates every discipline into one foundation, so decisions are based on the same data, controls link to the right risks, and your compliance status is always current.</p>
      </div>
      <SsotConvergence />
    </div>
  </section>

  <!-- ── Capability cards ──────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>What XGRC® covers</span>
        <h2>Six disciplines. One foundation.</h2>
      </div>
      <div class="grid cols-3">
        {capabilities.map((c) => (
          <a class="card cap-card" href={c.href}>
            <span class="tag">{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <span class="link-arrow">Explore &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What GRC software does ───────────────────────── -->
  <section class="section--tight" id="what-grc-software-does">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>What GRC software does</span>
        <h2>What a GRC platform does, day to day.</h2>
        <p class="lede">Whichever discipline you start with, GRC software solutions do the same core jobs. In XGRC® each one runs on the same data, so a risk links to its controls, its obligations, its audit findings and its corrective actions without double entry.</p>
      </div>
      <div class="grid cols-3">
        {grcJobs.map((j) => (
          <div class="card job-card">
            <h3>{j.title}</h3>
            <p>{j.body}</p>
            <a href={j.href} class="link-arrow">{j.label} &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Platform in action ───────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>The platform in action</span>
        <h2>Real dashboards. Real decisions.</h2>
        <p class="lede">Every discipline has a dedicated intelligence layer, executive dashboards built for decision-makers, not data analysts. These are live, click-through demonstrations, not screenshots.</p>
      </div>
      <div class="dash-tabs" id="dashTabs">
        <button class="dash-tab is-active" data-img="/assets/tour/enterprise-risk-v1.webp" data-label="Enterprise Risk Intelligence" data-href="/tour/enterprise-risk.html">Enterprise Risk</button>
        <button class="dash-tab" data-img="/assets/tour/sherq-v1.webp" data-label="SHERQ Landscape" data-href="/tour/sherq.html">SHEQ &amp; Safety</button>
        <button class="dash-tab" data-img="/assets/tour/esg-v1.webp" data-label="ESG Performance" data-href="/tour/esg.html">ESG</button>
        <button class="dash-tab" data-img="/assets/tour/vendor-risk-v1.webp" data-label="Vendor &amp; Third-Party Risk" data-href="/tour/vendor-risk.html">Compliance Hub</button>
        <button class="dash-tab" data-img="/assets/tour/ai-governance-v1.webp" data-label="AI Governance KPI Dashboard" data-href="/tour/ai-governance.html">AI Governance</button>
      </div>
      <a class="dash-frame" id="dashFrame" href="/tour/enterprise-risk.html" aria-label="Open the live Enterprise Risk dashboard">
        <div class="dash-chrome">
          <span class="dc-dot dc-red"></span>
          <span class="dc-dot dc-yellow"></span>
          <span class="dc-dot dc-green"></span>
          <span class="dc-url" id="dashUrl">xgrcsoftware.com/tour &nbsp;·&nbsp; Enterprise Risk Intelligence</span>
          <span class="dc-open">Open live dashboard &rarr;</span>
        </div>
        <div class="dash-screen">
          <img id="dashImg" src="/assets/tour/enterprise-risk-v1.webp" alt="XGRC Enterprise Risk Intelligence dashboard" width="1900" height="1017" loading="lazy" />
        </div>
      </a>
      <p class="dash-note">Illustrative data. <a href="/tour/">See all {tourDashboards.length} live dashboards &rarr;</a></p>
    </div>
  </section>

  <!-- ── Frameworks ────────────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Standards & regulations</span>
        <h2>Built for global standards and local law.</h2>
        <p class="lede">XGRC® supports the frameworks your organisation must comply with, from international ISO standards to South African legislation.</p>
      </div>
      <div class="fw-split">
        <div class="fw-panel">
          <span class="fw-region">Global</span>
          <ul class="fw-chips">
            {globalFrameworks.map((f) => <li class="fw-chip">{f}</li>)}
          </ul>
        </div>
        <div class="fw-divider" aria-hidden="true"></div>
        <div class="fw-panel">
          <span class="fw-region">South Africa</span>
          <ul class="fw-chips">
            {localFrameworks.map((f) => <li class="fw-chip fw-chip--sa">{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How to choose ─────────────────────────────────── -->
  <section class="section--tight" id="how-to-choose-grc-software">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Buyer's checklist</span>
        <h2>How to choose GRC software.</h2>
        <p class="lede">GRC software solutions vary widely in scope and depth. Use these questions to compare them on what matters once the system is live, not only in the demo.</p>
      </div>
      <ol class="checklist">
        {checklist.map((c) => (
          <li class="card check-card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Comparison ────────────────────────────────────── -->
  <section class="section--tight" id="grc-software-compared">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Compare the options</span>
        <h2>Integrated GRC software compared with spreadsheets and point solutions.</h2>
        <p class="lede">Most organisations reach integrated GRC software from one of two starting points: spreadsheets, or a growing set of single-purpose tools. Here is how the three approaches compare.</p>
      </div>
      <div class="cmp-table" role="table" aria-label="GRC software compared with spreadsheets and point solutions">
        <div class="cmp-row cmp-row--head" role="row">
          <span role="columnheader">Approach</span><span role="columnheader">Best suited to</span><span role="columnheader">Limits and what to plan for</span>
        </div>
        {comparison.map((r) => (
          <div class="cmp-row" role="row">{r.map((c) => <span role="cell">{c}</span>)}</div>
        ))}
      </div>
      <p class="cmp-links">
        <a href="/insights/what-is-grc-software/" class="link-arrow">What is GRC software? &rarr;</a>
        <a href="/insights/grc-vs-risk-management-software-why-the-difference-matters/" class="link-arrow">GRC vs risk management software &rarr;</a>
        <a href="/insights/erm-vs-grc/" class="link-arrow">ERM vs GRC &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ── Case studies ─────────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Case studies</span>
        <h2>Outcomes, not just software.</h2>
        <p class="lede">How organisations across manufacturing, mining, logistics, and facilities management use XGRC® in practice.</p>
      </div>
      <div class="cs-grid">
        {caseStudies.map((c) => (
          <div class="card cs-card">
            <div class="cs-meta">
              <span class="tag">{c.sector}</span>
              <span class="cs-solution">{c.solution}</span>
            </div>
            <h3 class="cs-company">{c.company}</h3>
            <p>{c.summary}</p>
            {c.pdf && (
              <a href={`/case-studies/${c.slug}.pdf`} class="link-arrow" download>Download case study &rarr;</a>
            )}
          </div>
        ))}
      </div>
      <div style="margin-top:28px;">
        <a href="/use-cases/" class="btn btn-ghost">Explore use cases &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── Why XGRC ──────────────────────────────────────── -->
  <section class="section--tight why-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Why XGRC®</span>
        <h2>Specific reasons to choose XGRC®.</h2>
        <p class="lede">The XGRC® platform is certified to ISO/IEC 27001:2022, customer data is hosted in Microsoft Azure West Europe (Netherlands), and organisations such as KAP Ltd, African Rainbow Minerals, RCL Foods, Servest, Interwaste and Toyota South Africa rely on it. <a href="/customers/">See our customers</a> or <a href="/trust/">review our security and hosting</a>.</p>
      </div>
      <div class="why-grid">
        {whyPoints.map((w) => (
          <div class="why-card">
            <div class="why-stat">
              <span class="stat-val">{w.stat}</span>
              <span class="stat-sub">{w.label}</span>
            </div>
            <p class="why-body">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Frequently asked</span>
        <h2>Common questions about the platform.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
            {f.link && <p><a href={f.link.href} class="link-arrow">{f.link.label} &rarr;</a></p>}
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────── -->
  <section class="section" id="contact">
    <div class="container">
      <div class="card cta">
        <h2>Take control of governance, risk, compliance and data protection.</h2>
        <p class="lede">Whether you are addressing a single risk domain or coordinating assurance across the enterprise, XGRC® gives you the foundation to move forward with confidence.</p>
        <div class="cta-actions">
          <a href="/demo/" class="btn btn-primary">Request a live demo</a>
          <a href="/use-cases/" class="btn btn-ghost">See use cases</a>
        </div>
        <p class="contactline">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
<script>
  const tabs  = document.querySelectorAll('.dash-tab');
  const img   = document.getElementById('dashImg');
  const url   = document.getElementById('dashUrl');
  const frame = document.getElementById('dashFrame');
  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      tabs.forEach(t => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      img.classList.add('is-switching');
      setTimeout(() => {
        img.src = tab.dataset.img;
        img.alt = 'XGRC ' + tab.dataset.label + ' dashboard';
