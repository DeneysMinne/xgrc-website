---
// Feature article with its own design. The site.js entry (feature: true) keeps it
// in the Insights listing, sitemap and Markdown twin; [slug].astro skips it.
import Base from '../../layouts/Base.astro';
import { articles, articleFaqs } from '../../data/site.js';
import { articleContent } from '../../data/articleContent.js';
import { articleSeo } from '../../data/articleSeo.js';
import { articleChecklists } from '../../data/articleChecklists.js';
import { useCaseRegistry } from '../../data/useCaseRegistry.js';

const slug = 'iso-27001-iso-42001-iso-27090-one-management-system';
const article = articles.find((a) => a.slug === slug);
const faqs = articleFaqs[slug] || [];
const seo = articleSeo[slug] || {};
const seoTitle = seo.seoTitle || `${article.title} | XGRC® Insights`;
const metaDescription = seo.metaDescription || article.excerpt;
const imageFile = article.image;
const pageUrl = `https://xgrcsoftware.com/insights/${slug}/`;
const checklistCase = (Array.isArray(useCaseRegistry) ? useCaseRegistry : Object.values(useCaseRegistry))
  .find((u) => u.slug === articleChecklists[slug] && u.resource);

const words = (articleContent[slug] || '').replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(words / 220));
const formattedDate = new Date(article.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const furtherReading = ['iso-42001-vs-iso-27001', 'iso-42001-implementation-ai-governance', 'king-v-and-the-rise-of-ai-governance']
  .map((s) => articles.find((a) => a.slug === s))
  .filter(Boolean);

// Hero: the Harmonized Structure drawn as a ring of ten clause segments.
const C = 280;
const R = 252;
const pt = (deg, r) => {
  const rad = (deg * Math.PI) / 180;
  return [C + r * Math.cos(rad), C + r * Math.sin(rad)].map((n) => n.toFixed(2));
};
const clauseArcs = Array.from({ length: 10 }, (_, i) => {
  const a0 = -90 + i * 36 + 2;
  const a1 = -90 + (i + 1) * 36 - 2;
  const [x0, y0] = pt(a0, R);
  const [x1, y1] = pt(a1, R);
  const [lx, ly] = pt((a0 + a1) / 2, R - 22);
  return { n: i + 1, d: `M ${x0} ${y0} A ${R} ${R} 0 0 1 ${x1} ${y1}`, lx, ly, req: i >= 3 };
});

const clauses = [
  { n: 4, name: 'Context of the organisation', asks: 'Issues, interested parties, scope', share: 'yes', note: 'one context; the scope names both information security and AI' },
  { n: 5, name: 'Leadership', asks: 'Commitment, policy, roles', share: 'yes', note: 'two policies, or one policy with both commitments' },
  { n: 6, name: 'Planning', asks: 'Risks, opportunities, objectives', share: 'partly', note: 'one risk method, but AI adds an impact assessment' },
  { n: 7, name: 'Support', asks: 'Resources, competence, awareness, documented information', share: 'yes', note: 'one document control, one competence record' },
  { n: 8, name: 'Operation', asks: 'Running the processes and controls', share: 'partly', note: 'different controls, one way of running them' },
  { n: 9, name: 'Performance evaluation', asks: 'Monitoring, internal audit, management review', share: 'yes', note: 'one audit programme, one management review' },
  { n: 10, name: 'Improvement', asks: 'Nonconformity, corrective action, continual improvement', share: 'yes', note: 'one corrective action process' },
];

const threats = [
  { name: 'Data poisoning', text: 'corrupting training or fine-tuning data so the model learns the wrong behaviour.', target: 'Training data', icon: 'poison' },
  { name: 'Evasion', text: 'inputs crafted to make a model misclassify or misjudge.', target: 'Model inputs', icon: 'evasion' },
  { name: 'Model extraction and inversion', text: 'recovering a model, or the data it was trained on, by querying it.', target: 'The model itself', icon: 'extract' },
  { name: 'Membership inference', text: 'working out whether a specific person’s data was used in training.', target: 'Personal data', icon: 'member' },
  { name: 'Prompt injection', text: 'instructions hidden in content that make a generative AI system act against its purpose.', target: 'Generative AI', icon: 'inject' },
];

const steps = [
  { name: 'Inventory', text: 'Add AI systems, models, datasets and AI services to the asset inventory (ISO/IEC 27002 control 5.9), including AI features inside software you buy.', refs: ['27002 · 5.9'] },
  { name: 'Risk assessment', text: 'Add ISO/IEC 27090 threat scenarios to the existing method in clause 6.1.2, so AI risks are scored and owned like any other.', refs: ['27001 · 6.1.2'] },
  { name: 'Suppliers', text: 'Extend supplier security (controls 5.19 to 5.22) to AI providers: where data goes, whether it trains their models, and how they handle incidents.', refs: ['5.19', '5.20', '5.21', '5.22'] },
  { name: 'Development and change', text: 'Apply secure development and testing (8.25 to 8.29) to model changes, prompts and training data, not only to code.', refs: ['8.25 to 8.29'] },
  { name: 'Monitoring', text: 'Log and monitor AI system behaviour (8.15 and 8.16) for signs of misuse, drift or injection.', refs: ['8.15', '8.16'] },
  { name: 'One review', text: 'Report AI security risks into the same internal audit and management review that ISO/IEC 42001 and ISO/IEC 27001 already share.', refs: ['Clause 9.2', 'Clause 9.3'] },
];

const register = [
  { ref: 'R-014', risk: 'Ransomware encrypts shared file servers', kind: 'sec', kindLabel: 'Information security', std: 'ISO/IEC 27001', owner: 'IT Operations', rating: 'High' },
  { ref: 'R-031', risk: 'Prompt injection through the customer support chatbot', kind: 'threat', kindLabel: 'AI threat', std: 'ISO/IEC 27090', owner: 'Digital Channels', rating: 'High' },
  { ref: 'R-032', risk: 'AI supplier trains its model on uploaded client data', kind: 'threat', kindLabel: 'AI threat', std: 'ISO/IEC 27090', owner: 'Procurement', rating: 'Medium' },
  { ref: 'R-047', risk: 'Automated CV screening disadvantages some applicant groups', kind: 'impact', kindLabel: 'AI impact', std: 'ISO/IEC 42001', owner: 'Human Resources', rating: 'Medium' },
  { ref: 'R-052', risk: 'Privileged access not reviewed each quarter', kind: 'sec', kindLabel: 'Information security', std: 'ISO/IEC 27001', owner: 'IT Security', rating: 'Medium' },
];

const toc = [
  { id: 'same-frame', n: '01', label: 'Same frame, different requirements' },
  { id: 'iso-27090', n: '02', label: 'Where ISO/IEC 27090 fits' },
  { id: 'one-system', n: '03', label: 'One system, fewer gaps' },
  { id: 'faqs', n: '04', label: 'Frequently asked questions' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: metaDescription,
  image: `https://xgrcsoftware.com/assets/images/insights/${imageFile}`,
  datePublished: article.date,
  dateModified: article.dateModified || article.date,
  author: { '@type': 'Organization', name: 'XGRC® Software', url: 'https://xgrcsoftware.com' },
  contributor: [
    { '@type': 'Person', name: 'Bernard Coetzee', jobTitle: 'Independent cybersecurity, governance and risk consultant' },
    { '@type': 'Person', name: 'Wikus van Niekerk', jobTitle: 'Group General Counsel', worksFor: { '@type': 'Organization', name: 'Strategix Group' } },
  ],
  about: ['ISO/IEC 27001', 'ISO/IEC 42001', 'ISO/IEC 27090', 'Harmonized Structure'],
  publisher: { '@type': 'Organization', name: 'XGRC® Software', url: 'https://xgrcsoftware.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: 'https://xgrcsoftware.com/insights/' },
    { '@type': 'ListItem', position: 3, name: article.title },
  ],
});
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<Base title={seoTitle} description={metaDescription} ogImage={`/assets/images/insights/${imageFile}`} mdPath={`/insights/${slug}.md`}>
  <script type="application/ld+json" set:html={schema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={faqSchema} />

  <div class="feat" id="feat">
    <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

    <!-- ── Hero ─────────────────────────────────────────── -->
    <header class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <nav class="crumb" aria-label="Breadcrumb">
            <a href="/insights/">Insights</a><span aria-hidden="true">/</span><span>AI &amp; Governance</span><span aria-hidden="true">/</span><span class="crumb-tag">Expert contributors</span>
          </nav>
          <h1 class="hero-title">
            <span class="ht-a">One Management System for AI and Information Security:</span>
            <span class="ht-b">ISO 27001, ISO 42001 and ISO/IEC&nbsp;27090</span>
          </h1>
          <p class="hero-dek">With contributions from <strong>Bernard Coetzee</strong> and <strong>Wikus van Niekerk</strong></p>
          <div class="hero-meta">
            <div class="avatars" aria-hidden="true">
              <span class="av av-b">BC</span><span class="av av-w">WvN</span>
            </div>
            <p>
              <span>By XGRC® Software</span>
              <span class="dot" aria-hidden="true">·</span>
              <time datetime={article.date}>{formattedDate}</time>
              <span class="dot" aria-hidden="true">·</span>
              <span>{readTime} min read</span>
            </p>
          </div>
          <div class="std-chips" aria-label="Standards covered">
            <span class="chip c1">ISO/IEC 27001</span><span class="chip c2">ISO/IEC 42001</span><span class="chip c3">ISO/IEC 27090</span>
          </div>
        </div>

        <figure class="hero-fig">
          <svg viewBox="0 0 560 560" role="img" aria-labelledby="hero-fig-title">
            <title id="hero-fig-title">The Harmonized Structure as a ring of ten clauses, with ISO/IEC 27001, ISO/IEC 42001 and ISO/IEC 27090 overlapping inside it as one management system</title>
            <defs>
              <radialGradient id="g-core" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                <stop offset="45%" stop-color="#7af3ff" stop-opacity="0.55" />
                <stop offset="100%" stop-color="#7af3ff" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="g-r1" cx="50%" cy="50%" r="50%"><stop offset="60%" stop-color="#30e2f4" stop-opacity="0" /><stop offset="100%" stop-color="#30e2f4" stop-opacity="0.16" /></radialGradient>
              <radialGradient id="g-r2" cx="50%" cy="50%" r="50%"><stop offset="60%" stop-color="#a78bfa" stop-opacity="0" /><stop offset="100%" stop-color="#a78bfa" stop-opacity="0.18" /></radialGradient>
              <radialGradient id="g-r3" cx="50%" cy="50%" r="50%"><stop offset="60%" stop-color="#2fe88a" stop-opacity="0" /><stop offset="100%" stop-color="#2fe88a" stop-opacity="0.16" /></radialGradient>
              <filter id="f-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4" /></filter>
            </defs>

            <circle class="orbit" cx="280" cy="280" r="272" />
            <g class="clauses">
              {clauseArcs.map((a) => (
                <g class={a.req ? 'cl req' : 'cl'} style={`--i:${a.n}`}>
                  <path d={a.d} />
                  <text x={a.lx} y={a.ly}>{a.n}</text>
                </g>
              ))}
            </g>

            <g class="ring r1"><circle cx="280" cy="214" r="122" fill="url(#g-r1)" /><circle cx="280" cy="214" r="122" class="stroke" /></g>
            <g class="ring r2"><circle cx="223" cy="313" r="122" fill="url(#g-r2)" /><circle cx="223" cy="313" r="122" class="stroke" /></g>
            <g class="ring r3"><circle cx="337" cy="313" r="122" fill="url(#g-r3)" /><circle cx="337" cy="313" r="122" class="stroke" /></g>

            <g class="rlabel l1"><text x="280" y="146">ISO/IEC 27001</text><text x="280" y="163" class="sub">Information security</text></g>
            <g class="rlabel l2"><text x="173" y="374">ISO/IEC 42001</text><text x="173" y="390" class="sub">AI management</text></g>
            <g class="rlabel l3"><text x="387" y="374">ISO/IEC 27090</text><text x="387" y="390" class="sub">AI threats</text></g>

            <g class="core">
              <circle cx="280" cy="280" r="46" fill="url(#g-core)" filter="url(#f-glow)" />
              <circle cx="280" cy="280" r="5" fill="#fff" />
              <text x="280" y="306">ONE SYSTEM</text>
            </g>
          </svg>
          <figcaption>Ten Harmonized Structure clauses. Clauses 4 to 10 (lit) carry the requirements.</figcaption>
        </figure>
      </div>
    </header>

    <!-- ── Body ─────────────────────────────────────────── -->
    <div class="container layout">
      <aside class="toc" aria-label="In this article">
        <p class="toc-h">In this article</p>
        <ol>
          {toc.map((t) => (
            <li><a href={`#${t.id}`} data-toc={t.id}><span class="toc-n">{t.n}</span>{t.label}</a></li>
          ))}
        </ol>
        <div class="toc-share">
          <a href={shareUrl} target="_blank" rel="noopener" class="share-btn">Share on LinkedIn</a>
          <button type="button" class="share-btn" data-copy={pageUrl}>Copy link</button>
        </div>
      </aside>

      <article class="prose">
        <p class="lede rv">Our recent article on <a href="/insights/iso-42001-vs-iso-27001/">ISO/IEC 42001 vs ISO/IEC 27001</a> set out what separates the two standards: one governs artificial intelligence, the other information security. Two industry practitioners responded with points that deserve an article of their own.</p>
        <p class="statement rv">The differences are real. The way to manage them, however, is not <em>two separate systems.</em></p>

        <!-- 01 ─────────────────────────────────────────── -->
        <section id="same-frame" class="sec">
          <div class="sec-head rv">
            <span class="sec-n">01</span>
            <h2>Same frame, different requirements</h2>
          </div>

          <p class="rv">Bernard Coetzee, an independent cybersecurity, governance and risk consultant with close to two decades of information security experience across financial services, retail and technology, pointed out that the ISO management system standards share a common foundation. That means they can be seen, and run, together.</p>

          <figure class="quote q-b rv">
            <svg class="q-mark" viewBox="0 0 64 48" aria-hidden="true"><path d="M0 48V28C0 12 8 2 26 0l2 7C18 10 14 16 14 24h12v24H0zm36 0V28c0-16 8-26 26-28l2 7c-10 3-14 9-14 17h12v24H36z" /></svg>
            <blockquote>
              <p>Every ISO management system standard is built on the same frame. Once you see that, ISO 27001 and ISO 42001 stop being two projects. <mark>Risk does not respect the boundaries between standards,</mark> so run them as one system, and AI risk lands in the same register the business already watches.</p>
            </blockquote>
            <figcaption>
              <span class="av av-b av-lg" aria-hidden="true">BC</span>
              <span><strong>Bernard Coetzee</strong><span>Independent cybersecurity, governance and risk consultant</span></span>
            </figcaption>
          </figure>

          <p class="rv">That common foundation is ISO’s Harmonized Structure, known until 2021 as Annex SL. Every recent ISO management system standard uses it, including ISO 9001, ISO 14001, ISO 45001, ISO/IEC 27001:2022 and ISO/IEC 42001:2023.</p>

          <div class="family rv" aria-hidden="true">
            {['ISO 9001', 'ISO 14001', 'ISO 45001', 'ISO/IEC 27001:2022', 'ISO/IEC 42001:2023'].map((s, i) => (
              <span class={i >= 3 ? 'fam hi' : 'fam'}>{s}</span>
            ))}
            <span class="fam-line"></span>
            <span class="fam-base">Harmonized Structure · 10 clauses · core text · core definitions</span>
          </div>

          <p class="rv">Each has the same ten clauses, the same core text and the same core definitions. Clauses 4 to 10 carry the requirements:</p>

          <figure class="clauses-fig rv">
            <div class="cf-top">
              <div class="cf-legend" aria-hidden="true">
                <span><i class="sw sw-yes"></i>Shared</span>
                <span><i class="sw sw-part"></i>Partly shared</span>
              </div>
              <div class="cf-filter" role="group" aria-label="Filter clauses">
                <button type="button" class="on" data-filter="all" aria-pressed="true">All</button>
                <button type="button" data-filter="yes" aria-pressed="false">Shared</button>
                <button type="button" data-filter="partly" aria-pressed="false">Partly</button>
              </div>
            </div>
            <table class="ctable" id="ctable">
              <caption class="sr-only">Harmonized Structure clauses 4 to 10 and whether ISO/IEC 27001 and ISO/IEC 42001 can share them</caption>
              <thead>
                <tr><th scope="col">Clause</th><th scope="col">What it asks for</th><th scope="col">Shared between ISO 27001 and ISO 42001?</th></tr>
              </thead>
              <tbody>
                {clauses.map((c) => (
                  <tr data-share={c.share}>
                    <th scope="row"><span class="c-num">{c.n}</span><span class="c-name">{c.name}</span></th>
                    <td class="c-asks">{c.asks}</td>
                    <td class="c-share">
                      <span class="merge" aria-hidden="true"><i class="m1"></i><i class="m2"></i></span>
                      <span><strong class={c.share === 'yes' ? 'pill yes' : 'pill part'}>{c.share === 'yes' ? 'Yes' : 'Partly'}</strong><span class="c-note">: {c.note}</span></span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </figure>

          <h3 class="rv">What can be shared</h3>
          <p class="rv">An organisation already certified to ISO/IEC 27001 has most of the machinery ISO/IEC 42001 needs. These can be extended rather than rebuilt:</p>
          <ul class="tiles rv">
            <li><span class="t-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 3v18M3 12h18" /></svg></span>The context analysis and the risk method</li>
            <li><span class="t-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M9 11h7M9 15h7" /></svg></span>Document control and competence records</li>
            <li><span class="t-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg></span>Internal audit and management review</li>
            <li><span class="t-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7" /><path d="M20 4v5h-5" /></svg></span>Corrective action and continual improvement</li>
          </ul>
          <p class="rv">One internal audit programme can cover both standards, and one management review can consider both sets of results. This is the same logic behind PAS 99 and integrated management systems: one skeleton, with each discipline’s specific requirements attached to it.</p>

          <h3 class="rv">What stays separate</h3>
          <p class="rv">Sharing the frame does not make the standards interchangeable. Each keeps requirements the other does not have:</p>
          <ul class="split rv">
            <li class="sp-a"><span class="sp-tag">ISO/IEC 27001</span>ISO/IEC 27001 keeps its Annex A of 93 information security controls, and the Statement of Applicability that justifies each one.</li>
            <li class="sp-b"><span class="sp-tag">ISO/IEC 42001</span>ISO/IEC 42001 adds an AI system impact assessment, looking at effects on individuals, groups and society. It also has its own Annex A of AI-specific controls, covering areas such as data for AI systems, the AI system life cycle and the use of AI by third parties.</li>
            <li class="sp-c"><span class="sp-tag">Objectives</span>Objectives and metrics differ. Information security objectives measure confidentiality, integrity and availability; AI objectives also cover fairness, transparency and human oversight.</li>
          </ul>

          <aside class="test rv" aria-label="The practical test">
            <p class="test-eyebrow">The practical test</p>
            <div class="test-grid" aria-hidden="true">
              <div class="tg tg-a"><span>How the organisation governs</span><strong>Shared</strong></div>
              <div class="tg tg-b"><span>What is protected or assessed</span><strong>Specific</strong></div>
            </div>
            <p>The practical test is simple: anything that describes how the organisation governs is shared; anything that describes what is being protected or assessed stays specific.</p>
          </aside>
        </section>

        <!-- 02 ─────────────────────────────────────────── -->
        <section id="iso-27090" class="sec">
          <div class="sec-head rv">
            <span class="sec-n">02</span>
            <h2>Where ISO/IEC 27090 fits</h2>
          </div>

          <p class="question rv">If ISO/IEC 42001 tells an organisation how to govern AI, and ISO/IEC 27001 provides the framework for managing information security, a practical question remains: how should AI-specific security threats be identified, assessed and incorporated into the ISMS and risk register already maintained by the organisation?</p>

          <p class="rv">Wikus van Niekerk, Group General Counsel at Strategix (the XGRC parent group), whose work took Strategix Technology Solutions to ISO/IEC 27001:2022 certification, pointed to the answer: ISO/IEC 27090.</p>

          <figure class="quote q-w rv">
            <svg class="q-mark" viewBox="0 0 64 48" aria-hidden="true"><path d="M0 48V28C0 12 8 2 26 0l2 7C18 10 14 16 14 24h12v24H0zm36 0V28c0-16 8-26 26-28l2 7c-10 3-14 9-14 17h12v24H36z" /></svg>
            <blockquote>
              <p>The introduction of AI does not necessarily create a separate compliance regime. POPIA, King IV™ (and especially the new King V™) and ISO/IEC 27001 already require an organisation to determine who is accountable for information and how it is protected. Most organisations already make use of AI through enterprise applications, cloud services and productivity tools, and as such should already form part of their compliance and risk management programmes. The purpose of ISO/IEC 27090 is thus complementary as it provides the ISMS team with a specific and practical way to identify and treat specific AI threats and compromises. <mark>The framework, in essence requires the organisation to name the AI threat, assess it, put a control and an owner against it, all while continuously monitoring and improving them.</mark></p>
            </blockquote>
            <figcaption>
              <span class="av av-w av-lg" aria-hidden="true">WvN</span>
              <span><strong>Wikus van Niekerk</strong><span>Group General Counsel, Strategix</span></span>
            </figcaption>
          </figure>

          <figure class="loop rv">
            <svg viewBox="0 0 720 150" role="img" aria-labelledby="loop-t">
              <title id="loop-t">The cycle in four steps: name the AI threat, assess it, put a control and an owner against it, then monitor and improve, and repeat</title>
              <defs>
                <linearGradient id="g-loop" x1="0" x2="1"><stop offset="0" stop-color="#30e2f4" /><stop offset="1" stop-color="#2fe88a" /></linearGradient>
                <marker id="arw" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#2fe88a" /></marker>
              </defs>
              <path class="loop-back" d="M 630 104 C 630 146, 90 146, 90 104" marker-end="url(#arw)" />
              {['Name the threat', 'Assess it', 'Control and owner', 'Monitor and improve'].map((t, i) => (
                <g class="ln" style={`--i:${i}`}>
                  {i < 3 && <line x1={90 + i * 180 + 52} y1="62" x2={90 + (i + 1) * 180 - 56} y2="62" stroke="#2fe88a" stroke-opacity="0.7" marker-end="url(#arw)" />}
                  <circle cx={90 + i * 180} cy="62" r="40" />
                  <text x={90 + i * 180} y="58" class="ln-n">{`0${i + 1}`}</text>
                  <text x={90 + i * 180} y="76" class="ln-l">{t.split(' ').slice(0, 2).join(' ')}</text>
                  <text x={90 + i * 180} y="90" class="ln-l">{t.split(' ').slice(2).join(' ')}</text>
                </g>
              ))}
            </svg>
            <ol class="loop-list" aria-hidden="true">
              {['Name the threat', 'Assess it', 'Control and owner', 'Monitor and improve'].map((t, i) => <li><span>{`0${i + 1}`}</span>{t}</li>)}
            </ol>
            <figcaption>The framework in four steps, from Wikus van Niekerk’s summary.</figcaption>
          </figure>

          <div class="spec rv">
            <div class="spec-doc" aria-hidden="true">
