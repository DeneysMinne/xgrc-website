                  {t.icon === 'evasion' && <svg viewBox="0 0 48 48"><path d="M4 24s7-12 20-12 20 12 20 12-7 12-20 12S4 24 4 24z" /><circle cx="24" cy="24" r="6" /><path class="bad" d="M8 40L40 8" /></svg>}
                  {t.icon === 'extract' && <svg viewBox="0 0 48 48"><path d="M24 6l14 8v16l-14 8-14-8V14z" /><path d="M24 22v16M10 14l14 8 14-8" /><path class="bad" d="M38 30l6 6m0-6v6h-6" /></svg>}
                  {t.icon === 'member' && <svg viewBox="0 0 48 48"><circle cx="20" cy="16" r="7" /><path d="M6 40c0-8 6-13 14-13s14 5 14 13" /><path class="bad" d="M36 14a5 5 0 1 1 6 5c-2 1-2 2-2 4M40 28v1" /></svg>}
                  {t.icon === 'inject' && <svg viewBox="0 0 48 48"><path d="M6 10h36v22H22l-10 8v-8H6z" /><path class="bad" d="M18 18l-4 3 4 3M30 18l4 3-4 3M26 16l-4 10" /></svg>}
                </span>
                <span class="th-target">{t.target}</span>
                <strong>{t.name}:</strong> {t.text}
