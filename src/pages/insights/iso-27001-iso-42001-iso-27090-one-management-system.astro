  .sec-head h2 { font-family: var(--font-display); font-size: clamp(1.6rem, 3.2vw, 2.4rem); font-weight: 800; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink); margin: 0; }
  .small-h { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: var(--ink); margin: 0 0 18px; letter-spacing: -0.01em; }

  /* Quotes */
  .quote {
    position: relative; margin: 36px 0 40px; padding: clamp(26px, 4vw, 40px); border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)); border: 1px solid var(--line);
    overflow: hidden;
  }
  .quote::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; }
  .q-b::before { background: linear-gradient(var(--c1), transparent); }
  .q-w::before { background: linear-gradient(var(--c3), transparent); }
  .q-mark { position: absolute; top: 22px; right: 26px; width: 64px; opacity: 0.12; }
  .q-b .q-mark { fill: var(--c1); }
  .q-w .q-mark { fill: var(--c3); }
  .quote blockquote { margin: 0 0 24px; }
  .quote blockquote p { margin: 0; font-family: var(--font-display); font-weight: 500; color: var(--ink); letter-spacing: -0.01em; }
  .q-b blockquote p { font-size: clamp(1.2rem, 2.1vw, 1.55rem); line-height: 1.45; }
  .q-w blockquote p { font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.6; }
  .quote mark { color: inherit; background: none; padding: 0 2px; }
  .q-b mark { box-shadow: inset 0 -0.42em 0 rgba(48, 226, 244, 0.22); }
  .q-w mark { box-shadow: inset 0 -0.42em 0 rgba(47, 232, 138, 0.2); }
  .quote figcaption { display: flex; align-items: center; gap: 14px; }
  .quote figcaption strong { display: block; color: var(--ink); font-size: 15px; }
  .quote figcaption span span { display: block; color: var(--mute); font-size: 13px; line-height: 1.4; }

  /* Standard family */
  .family { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 30px; }
  .fam { font-family: var(--font-mono); font-size: 12px; color: var(--mute); padding: 6px 11px; border-radius: 8px; background: var(--panel); border: 1px solid var(--line); }
  .fam.hi { color: var(--ink); border-color: rgba(167, 139, 250, 0.45); background: rgba(167, 139, 250, 0.08); }
  .fam-line { flex-basis: 100%; margin-top: 6px; height: 2px; background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3)); border-radius: 2px; }
  .fam-base { flex-basis: 100%; font-family: var(--font-mono); font-size: 11px; color: var(--faint); letter-spacing: 0.04em; }

  /* Clause table */
  .clauses-fig { margin: 8px 0 12px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.02); overflow: hidden; }
  .cf-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .cf-legend { display: flex; gap: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--mute); }
  .cf-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .sw { width: 22px; height: 8px; border-radius: 4px; display: inline-block; }
  .sw-yes { background: linear-gradient(90deg, var(--c1), var(--c2)); }
  .sw-part { background: linear-gradient(90deg, var(--c1) 50%, var(--c2) 50%); opacity: 0.85; }
  .cf-filter { display: inline-flex; background: var(--panel); border: 1px solid var(--line); border-radius: 99px; padding: 3px; }
  .cf-filter button { font: 500 12px var(--font-mono); color: var(--mute); background: none; border: 0; border-radius: 99px; padding: 6px 12px; cursor: pointer; }
  .cf-filter button.on { color: var(--void); background: var(--c1); }
  .ctable { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  .ctable thead th { text-align: left; font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--faint); padding: 12px 18px; border-bottom: 1px solid var(--line); }
  .ctable tbody tr { border-bottom: 1px solid var(--line); transition: opacity 0.3s, background 0.2s; }
  .ctable tbody tr:last-child { border-bottom: 0; }
  .ctable tbody tr:hover { background: rgba(255, 255, 255, 0.025); }
  .ctable tbody tr.dim { opacity: 0.22; }
  .ctable th[scope='row'], .ctable td { padding: 16px 18px; vertical-align: top; text-align: left; }
  .ctable th[scope='row'] { display: flex; align-items: baseline; gap: 12px; font-weight: 600; color: var(--ink); min-width: 210px; }
  .c-num { font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1; color: var(--c1); min-width: 32px; }
  .c-asks { color: var(--mute); }
  .c-share { display: flex; gap: 12px; align-items: flex-start; color: color-mix(in srgb, var(--ink) 85%, transparent); }
  .merge { position: relative; flex: none; width: 46px; height: 10px; margin-top: 7px; }
  .merge i { position: absolute; top: 0; height: 10px; border-radius: 5px; }
  tr[data-share='yes'] .m1 { left: 0; width: 46px; background: linear-gradient(90deg, var(--c1), var(--c2)); }
  tr[data-share='yes'] .m2 { display: none; }
  tr[data-share='partly'] .m1 { left: 0; width: 30px; background: var(--c1); opacity: 0.9; }
  tr[data-share='partly'] .m2 { right: 0; width: 30px; background: var(--c2); opacity: 0.75; mix-blend-mode: screen; }
  .pill { font-weight: 700; }
  .pill.yes { color: var(--c3); }
  .pill.part { color: var(--amber); }

  /* Tiles */
  .tiles { list-style: none; padding: 0; margin: 4px 0 26px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tiles li { display: flex; gap: 14px; align-items: center; padding: 16px 18px; border-radius: var(--radius-md); background: var(--panel); border: 1px solid var(--line); color: var(--ink); line-height: 1.45; font-size: 15px; }
  .t-ic { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(135deg, rgba(48, 226, 244, 0.18), rgba(167, 139, 250, 0.18)); border: 1px solid rgba(122, 243, 255, 0.25); }
  .t-ic svg { width: 20px; height: 20px; fill: none; stroke: var(--cyan-hi); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  /* Split */
  .split { list-style: none; padding: 0; margin: 4px 0 28px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .split li { padding: 20px 20px 22px; border-radius: var(--radius-md); border: 1px solid var(--line); background: var(--panel); font-size: 15px; line-height: 1.6; }
  .sp-tag { display: block; font: 500 11px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
  .sp-a { border-top: 2px solid var(--c1) !important; }
  .sp-a .sp-tag { color: var(--c1); }
  .sp-b { border-top: 2px solid var(--c2) !important; }
  .sp-b .sp-tag { color: var(--c2); }
  .sp-c { grid-column: 1 / -1; border-image: linear-gradient(90deg, var(--c1), var(--c2)) 1; border-top: 2px solid; border-left: 0; border-right: 0; border-bottom: 0; background: linear-gradient(90deg, rgba(48, 226, 244, 0.05), rgba(167, 139, 250, 0.05)); }
  .sp-c .sp-tag { color: var(--ink); }

  /* Practical test */
  .test { margin: 36px 0 8px; padding: clamp(22px, 3.5vw, 32px); border-radius: var(--radius-lg); background: radial-gradient(120% 140% at 0% 0%, rgba(48, 226, 244, 0.12), transparent 55%), radial-gradient(120% 140% at 100% 100%, rgba(167, 139, 250, 0.12), transparent 55%), var(--abyss); border: 1px solid var(--line-strong); }
  .test-eyebrow { font: 500 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--c1); margin: 0 0 16px !important; }
  .test-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }
  .tg { padding: 16px 18px; border-radius: var(--radius-md); background: rgba(6, 15, 28, 0.6); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .tg span { color: var(--mute); font-size: 13px; line-height: 1.4; }
  .tg strong { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1.1; }
  .tg-a strong { background: linear-gradient(90deg, var(--c1), var(--c2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tg-b strong { color: var(--amber); }
  .test > p:last-child { margin: 0; color: var(--ink); }

  /* 27090 */
  .question { font-family: var(--font-display); font-size: clamp(1.15rem, 1.9vw, 1.4rem); font-weight: 500; line-height: 1.5; color: var(--ink); padding-left: 22px; border-left: 3px solid var(--c3); }
  .loop { margin: -8px 0 40px; }
  .loop svg { width: 100%; height: auto; display: block; overflow: visible; }
  .loop line { stroke-width: 2; }
  .loop-back { fill: none; stroke: rgba(47, 232, 138, 0.45); stroke-width: 1.5; stroke-dasharray: 4 6; }
  .ln circle { fill: rgba(47, 232, 138, 0.06); stroke: rgba(47, 232, 138, 0.55); stroke-width: 1.5; }
  .ln-n { font-family: var(--font-mono); font-size: 12px; fill: var(--c3); text-anchor: middle; }
  .ln-l { font-family: var(--font-body); font-size: 12px; fill: var(--ink); text-anchor: middle; }
  .loop-list { display: none; list-style: none; padding: 0; margin: 0 0 8px; grid-template-columns: 1fr 1fr; gap: 8px; }
  .loop-list li { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(47, 232, 138, 0.4); background: rgba(47, 232, 138, 0.06); color: var(--ink); font-size: 14px; line-height: 1.3; }
  .loop-list span { font: 500 12px var(--font-mono); color: var(--c3); }
  .loop figcaption { text-align: center; font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin-top: 4px; }
  .fx .loop.in .ln { animation: popIn 0.5s var(--ease) both; animation-delay: calc(var(--i) * 140ms); }
  @keyframes popIn { from { opacity: 0; transform: translateY(8px); } }

  .spec { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 26px; align-items: center; margin: 8px 0 32px; padding: 24px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--panel); }
  .spec-doc {
    position: relative; aspect-ratio: 0.72; border-radius: 6px; padding: 14px 12px; display: flex; flex-direction: column;
    background: linear-gradient(170deg, #0f2a3f, #071624); border: 1px solid rgba(47, 232, 138, 0.35);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 8px 8px 0 -2px rgba(47, 232, 138, 0.12); transform: rotate(-3deg);
  }
  .spec-org { font: 500 10px var(--font-mono); color: var(--mute); letter-spacing: 0.1em; }
  .spec-no { font-family: var(--font-display); font-weight: 800; font-size: 34px; line-height: 1; color: var(--c3); margin-top: 6px; }
  .spec-yr { font: 500 12px var(--font-mono); color: var(--ink); }
  .spec-lines { margin-top: auto; display: flex; flex-direction: column; gap: 5px; }
  .spec-lines i { height: 3px; border-radius: 2px; background: rgba(120, 170, 200, 0.25); }
  .spec-lines i:nth-child(2) { width: 80%; }
  .spec-lines i:nth-child(3) { width: 55%; }
  .spec-body p { margin: 0 0 16px; }
  .spec-body em { color: var(--ink); }
  .spec-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; }
  .spec-facts div { padding: 10px 12px; border-radius: 10px; background: rgba(6, 15, 28, 0.55); border: 1px solid var(--line); }
  .spec-facts dt { font: 500 10px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .spec-facts dd { margin: 4px 0 0; color: var(--ink); font-size: 13px; line-height: 1.4; }

  .threats { list-style: none; padding: 0; margin: 4px 0 8px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .threat { grid-column: span 2; position: relative; padding: 20px 18px; border-radius: var(--radius-md); background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015)); border: 1px solid var(--line); font-size: 14px; line-height: 1.55; color: var(--mute); transition: border-color 0.25s, transform 0.25s; }
  .threat:nth-child(4), .threat:nth-child(5) { grid-column: span 3; }
  .threat:hover { border-color: rgba(47, 232, 138, 0.4); transform: translateY(-2px); }
  .threat strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; margin: 2px 0 6px; }
  .th-ic { display: block; width: 44px; height: 44px; margin-bottom: 14px; }
  .th-ic svg { width: 44px; height: 44px; fill: none; stroke: var(--c1); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .th-ic .bad { stroke: #fb7185; }
  .th-ic circle.bad { fill: rgba(251, 113, 133, 0.25); }
  .th-target { position: absolute; top: 20px; right: 16px; font: 500 10px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); border: 1px solid var(--line); border-radius: 99px; padding: 3px 8px; }
  .fx .threat.rv { transition-delay: var(--d, 0ms); }

  .steps-wrap { position: relative; margin: 8px 0 36px; }
  .steps { list-style: none; padding: 0; margin: 0; }
  .steps-rail { position: absolute; left: 19px; top: 20px; bottom: 20px; width: 2px; background: var(--line); border-radius: 2px; }
  .steps-rail span { display: block; height: 100%; background: linear-gradient(var(--c1), var(--c3)); transform: scaleY(0); transform-origin: 50% 0; border-radius: 2px; }
  .step { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 20px; padding: 10px 0 18px; }
  .st-n { position: relative; z-index: 1; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 700 15px var(--font-display); color: var(--void); background: linear-gradient(135deg, var(--c1), var(--c3)); box-shadow: 0 0 0 6px var(--void), 0 0 24px rgba(48, 226, 244, 0.35); }
  .step p { margin: 6px 0 8px; }
  .step strong { color: var(--ink); }
  .refs { display: flex; flex-wrap: wrap; gap: 6px; }
  .refs code { font: 500 11px var(--font-mono); color: var(--c1); background: rgba(48, 226, 244, 0.07); border: 1px solid rgba(48, 226, 244, 0.25); border-radius: 6px; padding: 3px 8px; }

  .reg { margin: 8px 0 26px; border-radius: var(--radius-lg); border: 1px solid var(--line-strong); background: var(--abyss); overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7); }
  .reg-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid var(--line); background: rgba(255, 255, 255, 0.03); }
  .reg-dots { display: flex; gap: 6px; }
  .reg-dots i { width: 9px; height: 9px; border-radius: 50%; background: rgba(120, 170, 200, 0.3); }
  .reg-title { font: 600 13px var(--font-display); color: var(--ink); }
  .reg-key { margin-left: auto; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font: 500 11px var(--font-mono); color: var(--mute); }
  .reg-key .k { width: 8px; height: 8px; border-radius: 50%; margin-left: 8px; }
  .k.kd-sec, .kind.kd-sec::before { background: var(--c1); }
  .k.kd-threat, .kind.kd-threat::before { background: var(--c3); }
  .k.kd-impact, .kind.kd-impact::before { background: var(--c2); }
  .reg .nowrap { white-space: nowrap; }
  .reg-scroll { overflow-x: auto; }
  .reg table { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 13px; line-height: 1.45; }
  .reg th { text-align: left; font: 500 10px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--faint); padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .reg td { padding: 12px 14px; border-bottom: 1px solid var(--line); color: var(--ink); vertical-align: top; }
  .reg tr:last-child td { border-bottom: 0; }
  .reg .mono { font-family: var(--font-mono); color: var(--mute); }
  .kind { display: inline-flex; flex-direction: column; padding-left: 14px; position: relative; white-space: nowrap; }
  .kind::before { content: ''; position: absolute; left: 0; top: 6px; width: 7px; height: 7px; border-radius: 50%; }
  .kind small { font-family: var(--font-mono); font-size: 10px; color: var(--faint); }
  .rate { font: 600 11px var(--font-mono); padding: 3px 8px; border-radius: 6px; }
  .rate.high { color: #fb7185; background: rgba(251, 113, 133, 0.12); }
  .rate.medium { color: var(--amber); background: rgba(251, 191, 36, 0.1); }
  .reg figcaption { padding: 10px 16px; font: 500 11px var(--font-mono); color: var(--faint); border-top: 1px solid var(--line); }

  .hl { color: var(--ink); font-weight: 600; }

  .cta { position: relative; overflow: hidden; margin: 32px 0 12px; padding: clamp(28px, 5vw, 48px); border-radius: var(--radius-lg); border: 1px solid var(--line-strong); background: radial-gradient(80% 120% at 100% 0%, rgba(47, 232, 138, 0.14), transparent 60%), radial-gradient(70% 100% at 0% 100%, rgba(48, 226, 244, 0.12), transparent 60%), var(--abyss); }
  .cta-rings { position: absolute; right: -60px; top: -60px; width: 240px; height: 240px; opacity: 0.5; pointer-events: none; }
  .cta-rings i { position: absolute; width: 140px; height: 140px; border-radius: 50%; border: 1.5px solid; }
  .cta-rings i:nth-child(1) { left: 50px; top: 20px; border-color: var(--c1); }
  .cta-rings i:nth-child(2) { left: 10px; top: 80px; border-color: var(--c2); }
  .cta-rings i:nth-child(3) { left: 90px; top: 80px; border-color: var(--c3); }
  .cta-eyebrow { font: 500 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--c3); margin: 0 0 12px !important; }
  .cta-text { position: relative; font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.55; color: var(--ink); max-width: 56ch; }
  .cta-btns { position: relative; display: flex; flex-wrap: wrap; gap: 10px; }

  .contrib { margin-top: 64px; padding-top: 36px; border-top: 1px solid var(--line); }
  .contrib-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .person { display: flex; gap: 16px; align-items: flex-start; padding: 20px; border-radius: var(--radius-md); background: var(--panel); border: 1px solid var(--line); }
  .p-name { margin: 2px 0 6px !important; font-family: var(--font-display); font-weight: 700; color: var(--ink); font-size: 1.05rem; }
  .p-role { margin: 0 !important; font-size: 14px; color: var(--mute); line-height: 1.55; }

  .faqs { margin-top: 56px; scroll-margin-top: 90px; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--panel); padding: 0 20px; transition: border-color 0.2s; }
  .faq[open] { border-color: var(--line-strong); }
  .faq summary { list-style: none; cursor: pointer; padding: 18px 28px 18px 0; position: relative; font-weight: 600; color: var(--ink); font-size: 15px; line-height: 1.45; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 14px; font: 400 22px var(--font-mono); color: var(--c1); transition: transform 0.25s; }
  .faq[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: 0 0 18px; color: var(--mute); font-size: 15px; line-height: 1.65; }

  .checklist { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin: 40px 0 28px; padding: 24px 26px; border-radius: var(--radius-lg); border: 1px dashed rgba(47, 232, 138, 0.4); background: rgba(47, 232, 138, 0.04); }
  .checklist p { margin: 0 !important; }
  .ck-eyebrow { font: 500 11px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--c3); }
  .ck-title { font: 700 1.15rem var(--font-display); color: var(--ink); margin: 4px 0 !important; }
  .ck-list { margin: 8px 0 0; padding-left: 18px; font-size: 14px; color: var(--mute); line-height: 1.55; max-width: 52ch; }

  .share-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 22px 0 8px; border-top: 1px solid var(--line); font-family: var(--font-mono); font-size: 12px; color: var(--faint); }
  .share-row span { margin-right: 6px; }

  .more { padding: 64px 0 96px; margin-top: 48px; border-top: 1px solid var(--line); background: linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent); }
  .more-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .more-card { display: flex; flex-direction: column; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--line); background: var(--panel); text-decoration: none; transition: transform 0.25s, border-color 0.25s; }
  .more-card:hover { transform: translateY(-3px); border-color: var(--line-strong); }
  .more-img img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; }
  .more-body { display: flex; flex-direction: column; gap: 8px; padding: 16px 18px 20px; }
  .more-cat { font: 500 10px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: #60a5fa; }
  .more-title { font: 600 1rem var(--font-display); color: var(--ink); line-height: 1.35; }
  .more-go { font: 500 12px var(--font-mono); color: var(--c1); }
  .more-back { margin: 28px 0 0; font-family: var(--font-mono); font-size: 13px; }
  .more-back a { color: var(--mute); text-decoration: none; }
