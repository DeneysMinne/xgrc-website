<script>
  const root = document.getElementById('feat');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveal (content stays visible without JS or with reduced motion).
  if (root && 'IntersectionObserver' in window && !reduce) {
    root.classList.add('fx');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    root.querySelectorAll('.rv').forEach((el) => io.observe(el));
  }

  // Reading progress and the steps rail.
  const bar = document.getElementById('progress-bar');
  const steps = document.getElementById('steps');
  const fill = document.getElementById('steps-fill');
  const prose = document.querySelector('.feat .prose');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      if (bar && prose) {
        const r = prose.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight)));
        bar.style.transform = `scaleX(${p})`;
      }
      if (steps && fill) {
        const r = steps.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (window.innerHeight * 0.6 - r.top) / r.height));
        fill.style.transform = `scaleY(${p})`;
      }
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Table of contents: mark the section being read.
  const links = document.querySelectorAll('.toc a[data-toc]');
  if ('IntersectionObserver' in window && links.length) {
    const tio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('active', l.dataset.toc === e.target.id));
      });
    }, { rootMargin: '-35% 0px -60% 0px' });
    links.forEach((l) => { const s = document.getElementById(l.dataset.toc); if (s) tio.observe(s); });
  }

  // Clause filter.
  const table = document.getElementById('ctable');
  document.querySelectorAll('.cf-filter button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      document.querySelectorAll('.cf-filter button').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      table?.querySelectorAll('tbody tr').forEach((tr) => {
        tr.classList.toggle('dim', f !== 'all' && tr.dataset.share !== f);
      });
    });
  });

  // Copy link.
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const t = btn.textContent;
        btn.textContent = 'Link copied';
        setTimeout(() => { btn.textContent = t; }, 1800);
      } catch { /* clipboard blocked: nothing to do */ }
    });
  });
</script>

