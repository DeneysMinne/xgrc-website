---
import Base from '../../layouts/Base.astro';
import { articles, articleFaqs, solutions } from '../../data/site.js';
import { articleContent } from '../../data/articleContent.js';
import { articleChecklists } from '../../data/articleChecklists.js';
import { articleSeo } from '../../data/articleSeo.js';
import { useCaseRegistry } from '../../data/useCaseRegistry.js';

export function getStaticPaths() {
  // Feature articles (feature: true) have their own bespoke page in this folder.
  return articles.filter((a) => !a.feature).map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { slug } = Astro.params;
const { article } = Astro.props;
const body = articleContent[slug] ?? '';
const faqs = articleFaqs[slug];
const imageFile = article.image || `${slug}.jpg`;
const relatedSolutions = (article.relatedSolutions || [])
  .map((s) => solutions.find((sol) => sol.slug === s))
  .filter(Boolean);

const wordCount = body.split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(wordCount / 220));

const dateObj = new Date(article.date);
const formattedDate = dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const updatedDate = article.dateModified && article.dateModified !== article.date
  ? new Date(article.dateModified).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const related = articles
  .filter((a) => a.category === article.category && a.slug !== slug)
  .slice(0, 3);

// Convert plain-text article body to structured HTML. Headings get an id and a
// section number so the contents list can link to them; the words are untouched.
const headings = [];
const slugify = (t) => t.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
function renderBody(text) {
  const blocks = text.trim().split(/\n\n+/);
  return blocks
    .map((block) => {
      const trimmed = block.trim();
      if (!trimmed) return '';
      const lines = trimmed.split('\n');

      // Bullet list: every line starts with '- '
      if (lines.length > 0 && lines.every((l) => l.trim().startsWith('- '))) {
        const items = lines.map((l) => `<li>${l.trim().slice(2).trim()}</li>`).join('');
        return `<ul>${items}</ul>`;
      }

      // Heading: single short line that doesn't end with sentence punctuation
      if (
        lines.length === 1 &&
        trimmed.length < 120 &&
        !/[.,:;]$/.test(trimmed) &&
        !trimmed.startsWith('-')
      ) {
        let id = slugify(trimmed) || `section-${headings.length + 1}`;
        if (headings.some((h) => h.id === id)) id = `${id}-${headings.length + 1}`;
        const n = String(headings.length + 1).padStart(2, '0');
        headings.push({ id, n, label: trimmed.replace(/<[^>]+>/g, '') });
        return `<h2 id="${id}" class="sec-h"><span class="sec-n" aria-hidden="true">${n}</span><span>${trimmed}</span></h2>`;
      }

      // Paragraph
      return `<p>${trimmed.replace(/\n/g, ' ')}</p>`;
    })
    .join('');
}

const bodyHtml = renderBody(body);

// "Free checklist" card (data/articleChecklists.js): once after the opening
// section (before the second heading) and once after the article text.
const checklistCase = (Array.isArray(useCaseRegistry) ? useCaseRegistry : Object.values(useCaseRegistry))
  .find((u) => u.slug === articleChecklists[slug] && u.resource);
const checklist = checklistCase && {
  title: checklistCase.resource.title,
  href: `/use-cases/${checklistCase.slug}/?from=${slug}#download`,
  includes: (checklistCase.resource.includes || []).slice(0, 3),
};
const secondH2 = bodyHtml.indexOf('<h2', bodyHtml.indexOf('<h2') + 1);
const [bodyIntro, bodyRest] = checklist && secondH2 > 0
  ? [bodyHtml.slice(0, secondH2), bodyHtml.slice(secondH2)]
  : [bodyHtml, ''];

// SEO overrides (data/articleSeo.js) win over the article's own fields.
const seo = articleSeo[slug] || {};
const metaDescription = seo.metaDescription || article.metaDescription || article.excerpt;
const seoTitle = seo.seoTitle || article.seoTitle || `${article.title} | XGRC® Insights`;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: metaDescription,
  image: `https://xgrcsoftware.com/assets/images/insights/${imageFile}`,
  datePublished: article.date,
  dateModified: article.dateModified || article.date,
  author: { '@type': 'Organization', name: 'XGRC® Software' },
  publisher: {
    '@type': 'Organization',
    name: 'XGRC® Software',
    url: 'https://xgrcsoftware.com',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://xgrcsoftware.com/insights/${slug}/` },
});

const faqSchema = faqs ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}) : null;

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: 'https://xgrcsoftware.com/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: 'https://xgrcsoftware.com/insights/' },
    { '@type': 'ListItem', position: 3, name: article.title },
  ],
});

const categoryColors = {
  'ESG': '#3ecf8e',
  'GRC': '#30e2f4',
  'Cyber': '#a78bfa',
  'ERM': '#fb923c',
  'SHEQ': '#fbbf24',
  'Environment': '#34d399',
  'Food Safety': '#86efac',
  'Mining': '#d97706',
  'AI & Governance': '#60a5fa',
  'Risk': '#f87171',
};
const catColor = categoryColors[article.category] || '#30e2f4';

// The first paragraph opens with a drop cap.
const firstP = bodyHtml.indexOf('<p>');
const toc = [...headings, ...(faqs ? [{ id: 'faqs', n: String(headings.length + 1).padStart(2, '0'), label: 'Frequently asked questions' }] : [])];
const pageUrl = `https://xgrcsoftware.com/insights/${slug}/`;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
const solIcon = (s) => ['msx', 'msxcyber', 'esg', 'sheqx', 'erm', 'integrated-assurance', 'envirx', 'compliance-hub', 'xlogic', 'maia', 'xrm'].includes(s.slug) ? `/assets/logos/solutions/icons/${s.slug}.png` : null;
// Split the title at its first colon or question mark for the two-tone headline.
const tm = article.title.match(/^(.+?[:?])\s+(.+)$/);
const titleA = tm ? tm[1] : article.title;
const titleB = tm ? tm[2] : '';
const moreArticles = related.length ? related : articles.filter((a) => a.slug !== slug && !a.feature).slice(0, 3);
---

<Base title={seoTitle} description={metaDescription} ogImage={`/assets/images/insights/${imageFile}`} mdPath={`/insights/${slug}.md`}>
  <script type="application/ld+json" set:html={schema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}

  <div class="art" id="art" style={`--acc: ${catColor}`}>
    <div class="progress" aria-hidden="true"><span id="art-progress"></span></div>

    <!-- ── Hero ─────────────────────────────────────────── -->
    <header class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <nav class="crumb" aria-label="Breadcrumb">
            <a href="/insights/">Insights</a><span aria-hidden="true">/</span><span class="crumb-cat">{article.category}</span>
          </nav>
          <h1 class="hero-title">
            <span class="ht-a">{titleA}</span>
            {titleB && <span class="ht-b">{titleB}</span>}
          </h1>
          <p class="hero-dek">{article.excerpt}</p>
          <div class="hero-meta">
            <img class="av" src="/assets/xgrc-cube.png" alt="" width="40" height="40" />
            <p>
              <span>By XGRC® Software</span>
              <span class="dot" aria-hidden="true">·</span>
              <time datetime={article.date}>{formattedDate}</time>
              {updatedDate && (<><span class="dot" aria-hidden="true">·</span><span>Updated <time datetime={article.dateModified}>{updatedDate}</time></span></>)}
              <span class="dot" aria-hidden="true">·</span>
              <span>{readTime} min read</span>
            </p>
          </div>
        </div>
        <figure class="hero-fig">
          <div class="halo" aria-hidden="true"></div>
          <img
            src={`/assets/images/insights/${imageFile}`}
            alt={article.imageAlt || article.title}
            class="hero-img"
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </header>

    <!-- ── Body ─────────────────────────────────────────── -->
    <div class="container layout">
      <aside class="toc" aria-label="In this article">
        {toc.length > 1 && (
          <>
            <p class="toc-h">In this article</p>
            <ol>
              {toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}><span class="toc-n">{t.n}</span>{t.label}</a></li>)}
            </ol>
          </>
        )}
        {checklist && (
          <a class="toc-check" href={checklist.href} data-checklist-cta="side">
            <span class="tc-eb">Free checklist</span>
            <span class="tc-t">{checklist.title}</span>
            <span class="tc-go">Download →</span>
          </a>
        )}
        <div class="toc-share">
          <a href={shareUrl} target="_blank" rel="noopener" class="share-btn">Share on LinkedIn</a>
          <button type="button" class="share-btn" data-copy={pageUrl}>Copy link</button>
        </div>
      </aside>

      <article class="prose">
        <div class="content" set:html={bodyIntro} />
        {checklist && bodyRest && (
          <aside class="check rv" aria-label="Free checklist">
            <div class="check-doc" aria-hidden="true"><i></i><i></i><i></i><i></i><b>✓</b></div>
            <div class="check-body">
              <p class="check-eb">Free checklist</p>
              <p class="check-title">{checklist.title}</p>
              {checklist.includes.length > 0 && (
                <ul class="check-list">{checklist.includes.map((i) => <li>{i}</li>)}</ul>
              )}
              <a href={checklist.href} class="btn btn-primary" data-checklist-cta="mid">Get the free checklist →</a>
            </div>
          </aside>
        )}
        {bodyRest && <div class="content" set:html={bodyRest} />}
        {checklist && (
          <aside class="check rv" aria-label="Free checklist">
            <div class="check-doc" aria-hidden="true"><i></i><i></i><i></i><i></i><b>✓</b></div>
            <div class="check-body">
              <p class="check-eb">Free checklist</p>
              <p class="check-title">{checklist.title}</p>
              {checklist.includes.length > 0 && (
                <ul class="check-list">{checklist.includes.map((i) => <li>{i}</li>)}</ul>
              )}
              <a href={checklist.href} class="btn btn-primary" data-checklist-cta="end">Get the free checklist →</a>
            </div>
          </aside>
        )}

        {relatedSolutions.length > 0 && (
          <section class="sols rv" aria-label="Related solutions">
            <p class="small-eb">Related solutions</p>
            <div class="sol-grid">
              {relatedSolutions.map((s) => (
                <a href={`/${s.slug}/`} class="sol">
                  {solIcon(s) ? <img src={solIcon(s)} alt="" width="44" height="44" loading="lazy" /> : <span class="sol-mono" aria-hidden="true">{s.name.slice(0, 2)}</span>}
                  <span class="sol-body"><span class="sol-tag">{s.tag}</span><span class="sol-name">{s.name}</span></span>
                  <span class="sol-go" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {faqs && (
          <section id="faqs" class="faqs">
            <h2 class="sec-h rv"><span class="sec-n" aria-hidden="true">{String(headings.length + 1).padStart(2, '0')}</span><span>Frequently asked questions</span></h2>
            <div class="faq-list">
              {faqs.map((f, i) => (
                <details class="faq rv">
                  <summary><span class="fq-n">{String(i + 1).padStart(2, '0')}</span><span class="fq-q">{f.q}</span><span class="fq-ic" aria-hidden="true"></span></summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <div class="share-row">
          <span>Share this article</span>
          <a href={shareUrl} target="_blank" rel="noopener" class="share-btn">Share on LinkedIn</a>
          <button type="button" class="share-btn" data-copy={pageUrl}>Copy link</button>
        </div>
      </article>
    </div>

    <!-- ── CTA ──────────────────────────────────────────── -->
    <section class="container cta-wrap">
      <div class="cta rv">
        <div class="cta-bg" aria-hidden="true"></div>
        <p class="cta-eb">Take the next step</p>
        <h2>Ready to strengthen your {article.category} programme?</h2>
        <p>See how XGRC® gives your team the visibility, accountability, and control it needs, without the spreadsheet chaos.</p>
        <div class="cta-actions">
          <a href="/demo/" class="btn btn-primary">Book a Demo</a>
          <a href="/solutions/" class="btn btn-ghost">Explore Solutions →</a>
        </div>
      </div>
    </section>

    <!-- ── More ─────────────────────────────────────────── -->
    <section class="container more">
      <div class="more-head">
        <p class="small-eb">{related.length ? `More on ${article.category}` : 'More insights'}</p>
        <a href="/insights/" class="more-all">All Insights →</a>
      </div>
      <div class="more-grid">
        {moreArticles.map((r) => (
          <a href={`/insights/${r.slug}/`} class="more-card rv">
            <span class="more-img"><img src={`/assets/images/insights/${r.image || `${r.slug}.jpg`}`} alt={r.title} loading="lazy" decoding="async" /></span>
            <span class="more-body">
              <span class="more-cat">{r.category}</span>
              <span class="more-title">{r.title}</span>
              <span class="more-go">Read →</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  const root = document.getElementById('art');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal on scroll (content stays visible without JS or with reduced motion).
  if (root && 'IntersectionObserver' in window && !reduce) {
    root.querySelectorAll('.content > h2, .content > ul, .content > ol').forEach((el) => el.classList.add('rv'));
    root.classList.add('fx');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    root.querySelectorAll('.rv').forEach((el) => io.observe(el));
  }

  // Reading progress.
  const bar = document.getElementById('art-progress');
  const prose = document.querySelector('.art .prose');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      if (bar && prose) {
        const r = prose.getBoundingClientRect();
        bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight)))})`;
      }
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Contents: mark the section being read.
  const links = document.querySelectorAll('.art .toc a[data-toc]');
  if ('IntersectionObserver' in window && links.length) {
    const tio = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) links.forEach((l) => l.classList.toggle('active', l.dataset.toc === e.target.id)); });
    }, { rootMargin: '-25% 0px -70% 0px' });
    links.forEach((l) => { const s = document.getElementById(l.dataset.toc); if (s) tio.observe(s); });
  }

  // Copy link.
  document.querySelectorAll('.art [data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const t = btn.textContent;
        btn.textContent = 'Link copied';
        setTimeout(() => { btn.textContent = t; }, 1800);
      } catch { /* clipboard blocked */ }
    });
  });
</script>

<style>
  .art { --c1: #30e2f4; --c2: #a78bfa; --c3: #2fe88a; padding-top: 74px; overflow-x: clip; }

  /* ── Progress ─────────────────────────────────────── */
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 101; pointer-events: none; }
  .progress span { display: block; height: 100%; background: linear-gradient(90deg, var(--acc), var(--c1), var(--c2)); transform: scaleX(0); transform-origin: 0 50%; }

  /* ── Hero ─────────────────────────────────────────── */
  .hero { position: relative; padding: clamp(28px, 5vw, 60px) 0 clamp(36px, 5vw, 64px); isolation: isolate; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(42% 55% at 78% 45%, color-mix(in srgb, var(--acc) 20%, transparent), transparent 70%),
      radial-gradient(35% 45% at 92% 80%, rgba(167, 139, 250, 0.10), transparent 70%),
      radial-gradient(40% 50% at 10% 10%, rgba(48, 226, 244, 0.08), transparent 70%),
      linear-gradient(rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px;
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: clamp(28px, 4vw, 60px); align-items: center; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 12px; color: var(--mute); margin-bottom: 24px; }
  .crumb a { color: var(--mute); text-decoration: none; }
  .crumb a:hover { color: var(--acc); }
  .crumb-cat { color: var(--acc); border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent); background: color-mix(in srgb, var(--acc) 10%, transparent); padding: 2px 10px; border-radius: 99px; }
  .hero-title { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; line-height: 1.06; margin: 0 0 20px; color: var(--ink); }
  .ht-a { display: block; font-size: clamp(1.9rem, 4vw, 3.3rem); }
  .ht-b { display: block; margin-top: 12px; font-size: clamp(1.2rem, 2.2vw, 1.8rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.22; background: linear-gradient(90deg, var(--acc), var(--c1) 55%, var(--c2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-dek { font-size: clamp(1rem, 1.35vw, 1.12rem); line-height: 1.7; color: var(--mute); margin: 0 0 24px; max-width: 60ch; }
  .hero-meta { display: flex; align-items: center; gap: 14px; }
  .hero-meta p { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--mute); display: flex; flex-wrap: wrap; gap: 8px; }
  .dot { color: var(--faint); }
  .av { width: 40px; height: 40px; border-radius: 50%; object-fit: contain; padding: 5px; background: var(--abyss); box-shadow: 0 0 0 2px color-mix(in srgb, var(--acc) 70%, transparent); flex: none; }
  .hero-fig { position: relative; margin: 0; }
  .halo { position: absolute; inset: 6% 4%; z-index: -1; background: radial-gradient(closest-side, color-mix(in srgb, var(--acc) 35%, transparent), transparent); filter: blur(34px); }
  .hero-img { display: block; width: 100%; height: auto; border-radius: 18px; border: 1px solid color-mix(in srgb, var(--acc) 35%, var(--line)); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5); animation: lift 1.2s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes lift { from { opacity: 0; transform: translateY(26px) scale(0.98); } }

  /* ── Layout ───────────────────────────────────────── */
  .layout { display: grid; grid-template-columns: 240px minmax(0, 740px); gap: 64px; justify-content: center; padding-top: 28px; }
  .toc { position: sticky; top: 104px; align-self: start; font-size: 13px; max-height: calc(100vh - 124px); overflow: auto; scrollbar-width: none; }
  .toc-h { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--faint); margin: 0 0 14px; }
  .toc ol { list-style: none; margin: 0 0 22px; padding: 0; border-left: 1px solid var(--line); }
  .toc li a { display: flex; gap: 10px; padding: 7px 0 7px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--mute); text-decoration: none; line-height: 1.4; transition: color 0.2s, border-color 0.2s; }
  .toc li a:hover { color: var(--ink); }
  .toc li a.active { color: var(--ink); border-left-color: var(--acc); }
  .toc-n { font-family: var(--font-mono); font-size: 11px; color: var(--faint); padding-top: 2px; }
  .toc a.active .toc-n { color: var(--acc); }
  .toc-check { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; margin-bottom: 18px; border-radius: 14px; text-decoration: none; border: 1px solid color-mix(in srgb, var(--acc) 40%, transparent); background: linear-gradient(150deg, color-mix(in srgb, var(--acc) 12%, transparent), transparent); transition: transform 0.2s var(--ease); }
  .toc-check:hover { transform: translateY(-2px); }
  .tc-eb { font: 500 10.5px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--acc); }
  .tc-t { color: var(--ink); font-weight: 600; line-height: 1.35; }
  .tc-go { color: var(--acc); font-size: 12.5px; }
  .toc-share { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .share-btn { font: 500 12px var(--font-mono); color: var(--mute); background: var(--panel); border: 1px solid var(--line); border-radius: 99px; padding: 7px 14px; cursor: pointer; text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .share-btn:hover { color: var(--ink); border-color: var(--line-strong); }

  /* ── Prose ────────────────────────────────────────── */
  .prose { min-width: 0; }
  .content { font-size: clamp(1rem, 1.2vw, 1.08rem); line-height: 1.8; color: color-mix(in srgb, var(--ink) 86%, transparent); }
  .content :global(p) { margin: 0 0 1.35em; }
  .content :global(a) { color: var(--c1); text-decoration: underline; text-decoration-color: rgba(48, 226, 244, 0.35); text-underline-offset: 3px; }
  .content :global(a:hover) { text-decoration-color: var(--c1); }
  .prose > .content:first-child :global(p:first-of-type) { font-size: clamp(1.1rem, 1.5vw, 1.24rem); line-height: 1.7; color: var(--ink); }
  .prose > .content:first-child :global(p:first-of-type::first-letter) {
