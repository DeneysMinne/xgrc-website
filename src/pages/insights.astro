---
import Base from '../layouts/Base.astro';
import { articles } from '../data/site.js';

const categoryColors = {
  'ESG':            '#3ecf8e',
  'GRC':            '#30e2f4',
  'Cyber':          '#a78bfa',
  'ERM':            '#fb923c',
  'SHEQ':           '#fbbf24',
  'Environment':    '#34d399',
  'Food Safety':    '#86efac',
  'Mining':         '#d97706',
  'AI & Governance':'#60a5fa',
  'Risk':           '#f87171',
};

function articleDate(iso) {
  return new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}

function readTime(slug) {
  // Approximate read time based on typical article length (~1200-1800 words → 6-9 min)
  // We use a deterministic hash of the slug for slight variation without importing content here
  const n = slug.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
  return (n % 4) + 5; // 5–8 min
}

const categories = ['All', ...Array.from(new Set(articles.map((a) => a.category)))];
---

<Base
  title="Insights | XGRC® Software"
  description={`Practical thinking on GRC, ESG, ISO standards, risk frameworks, SHEQ and cyber from the XGRC® team. ${articles.length} articles.`}
>

  <!-- ── Page header ──────────────────────────────────── -->
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>Insights</span>
      <h1>Perspective on governance, risk and compliance.</h1>
      <p class="lede">Practical thinking on ESG, ISO standards, risk frameworks, SHEQ and cyber — written for the people who carry the compliance load.</p>
      <div class="head-stats">
        <span class="hs-item"><strong>{articles.length}</strong> articles</span>
        <span class="hs-sep" aria-hidden="true">·</span>
        <span class="hs-item">ESG · GRC · Cyber · SHEQ · ERM</span>
      </div>
    </div>
  </section>

  <!-- ── Featured video ───────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="featured-video-card">
        <div class="fv-meta">
          <span class="fv-label">Video · May 2026</span>
          <h2 class="fv-title">AI is not the risk. Lack of governance is.</h2>
          <p class="fv-desc">Our perspective on why AI adoption is not the threat — and why the absence of governance frameworks is the real exposure organisations face right now.</p>
        </div>
        <div class="fv-player">
          <div class="yt-wrap">
            <iframe
              src="https://www.youtube-nocookie.com/embed/2qmLbCaUNtw"
              title="XGRC insight: AI is not the risk — lack of governance is"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Secondary videos ─────────────────────────────── -->
  <section class="section--tight">
    <div class="container">
      <div class="vid-grid">
        <div class="vid-card">
          <div class="yt-wrap">
            <iframe
              src="https://www.youtube-nocookie.com/embed/hW3EPWIKj9s"
              title="XGRC® Software – Digital SHEQ Systems Centralise Incident Reporting"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="vid-meta">
            <span class="fv-label">Video · June 2026</span>
            <h3 class="vid-title">Digital SHEQ Systems Centralise Incident Reporting</h3>
          </div>
        </div>
        <div class="vid-card">
          <div class="yt-wrap">
            <iframe
              src="https://www.youtube-nocookie.com/embed/v3_97N3WUuI"
              title="The Future of ESG Is Digital with XGRC® Software"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="vid-meta">
            <span class="fv-label">Video · June 2026</span>
            <h3 class="vid-title">The Future of ESG Is Digital with XGRC® Software</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Articles grid ────────────────────────────────── -->
  <section class="section articles-section">
    <div class="container">
      <div class="articles-header">
        <h2 class="articles-heading">All Articles</h2>
        <span class="articles-count">{articles.length}</span>
      </div>

      <div class="article-grid">
        {articles.map((a) => {
          const color = categoryColors[a.category] || '#30e2f4';
          const mins = readTime(a.slug);
          return (
            <a href={`/insights/${a.slug}`} class="art-card">
              <div class="art-card-img">
                <img
                  src={`/assets/images/insights/${a.image || `${a.slug}.jpg`}`}
                  alt={a.title}
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="360"
                />
              </div>
              <div class="art-card-body">
                <div class="art-card-top">
                  <span class="art-chip" style={`--chip-color:${color}`}>{a.category}</span>
                  <span class="art-date">{articleDate(a.date)}</span>
                </div>
                <h3 class="art-card-title">{a.title}</h3>
                <p class="art-card-excerpt">{a.excerpt}</p>
                <div class="art-card-footer">
                  <span class="art-read-time">{mins} min read</span>
                  <span class="art-arrow">Read →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Page head ───────────────────────────────────────── */
  .page-head { padding: 130px 0 56px; }
  .page-head h1 { margin: 8px 0 16px; max-width: 22ch; }
  .lede { color: var(--mute); font-size: clamp(1rem, 1.4vw, 1.1rem); line-height: 1.65; max-width: 56ch; margin: 0 0 24px; }

  .head-stats {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
  }
  .head-stats strong { color: var(--cyan); font-weight: 700; }
  .hs-sep { color: var(--faint); }

  /* ── Section spacing ─────────────────────────────────── */
  .section--tight { padding: 0 0 32px; }
  .section { padding: 0 0 80px; }
  .articles-section { padding: 0 0 100px; }

  /* ── Featured video ──────────────────────────────────── */
  .featured-video-card {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 52px;
    align-items: center;
    padding: clamp(32px, 5vw, 56px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(48,226,244,0.04), rgba(38,158,198,0.02));
    margin-bottom: 16px;
  }
  .fv-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 14px;
  }
  .fv-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .fv-desc {
    color: var(--mute);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }
  .fv-player {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(48,226,244,0.12);
    background: #000;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }

  /* ── YouTube wrapper ─────────────────────────────────── */
  .yt-wrap {
    position: relative;
    padding-top: 56.25%;
    background: #000;
  }
  .yt-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ── Secondary vid grid ──────────────────────────────── */
  .vid-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .vid-card { display: flex; flex-direction: column; gap: 16px; }
  .vid-card .yt-wrap {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(48,226,244,0.12);
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
  }
  .vid-meta { display: flex; flex-direction: column; gap: 6px; }
  .vid-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* ── Articles header ─────────────────────────────────── */
  .articles-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .articles-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .articles-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(48,226,244,0.12);
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }

  /* ── Article card grid ───────────────────────────────── */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .art-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    background: color-mix(in srgb, var(--bg, #0a0a0a) 95%, #fff 5%);
  }
  .art-card:hover {
    border-color: var(--line-strong);
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    transform: translateY(-3px);
  }

  .art-card-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--line);
  }
  .art-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .art-card:hover .art-card-img img { transform: scale(1.05); }

  .art-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .art-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .art-chip {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--chip-color) 15%, transparent);
    color: var(--chip-color);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .art-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
  }

  .art-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .art-card-excerpt {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--mute);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .art-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .art-read-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .art-arrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cyan);
    transition: transform 0.2s;
  }
  .art-card:hover .art-arrow { transform: translateX(3px); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .article-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 800px) {
    .featured-video-card { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 680px) {
    .vid-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .article-grid { grid-template-columns: 1fr; }
  }
</style>
