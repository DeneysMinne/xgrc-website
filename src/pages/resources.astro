---
import Base from '../layouts/Base.astro';
import { resources } from '../data/site.js';
import { useCaseRegistry } from '../data/useCaseRegistry.js';

const checklistResources = useCaseRegistry
  .filter((u) => u.resource)
  .sort((a, b) => new Date(b.resource.dateAdded || 0) - new Date(a.resource.dateAdded || 0));
---

<Base title="Resources | XGRC® Software" description="Checklists, gap assessments, booklets and brochures for the XGRC platform and its solutions.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>Resources</span>
      <h1>Guides, checklists and product detail.</h1>
      <p class="lede">Downloadable material across the suite. ISO gap assessments, inspection checklists, booklets, brochures, and the platform release log.</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Checklists &amp; gap assessments</span>
        <h2>Practical resources for every discipline.</h2>
      </div>
      <div class="search-wrap">
        <input
          type="search"
          class="search-input"
          placeholder="Search checklists — e.g. ISO 27001, AI, POPIA, King V…"
          aria-label="Search checklists"
          data-res-search
        />
      </div>
      <div class="filters" role="group" aria-label="Filter by category">
        <button class="filter-chip is-active" data-filter="All" type="button">All</button>
        {[...new Set(checklistResources.map((u) => u.category))].map((c) => (
          <button class="filter-chip" data-filter={c} type="button">{c}</button>
        ))}
      </div>
      <p class="result-count" data-res-count></p>
      <div class="grid cols-2" data-res-grid>
        {checklistResources.map((u) => (
          <a
            class="card res"
            data-category={u.category}
            data-tags={[u.crumbLabel, u.resource.title, ...(u.frameworks || [])].join(' ').toLowerCase()}
            href={`/use-cases/${u.slug}/#resource`}
          >
            <span class="tag">{u.category}</span>
            <h3>{u.resource.title}</h3>
            <p>Related to: {u.crumbLabel}</p>
            <span class="link-arrow">View &amp; download →</span>
          </a>
        ))}
      </div>
      <p class="no-results" data-res-empty hidden>No checklists match that search. Try a different term, e.g. a framework name like "ISO 9001" or "GDPR".</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Product material</span>
        <h2>Booklets and brochures.</h2>
      </div>
      <div class="grid cols-2">
        {resources.map((r) => (
          <div class="card res">
            <span class="tag">{r.type}</span>
            <h3>{r.title}</h3>
            <p>{r.note}</p>
            <a
              href={r.href}
              class="link-arrow"
              {...(r.download ? { target: '_blank', rel: 'noopener', download: true } : {})}
            >{r.cta || 'Download →'}</a>
          </div>
        ))}
      </div>
      <p class="note"><a href="/videos/" class="link-arrow">Looking for videos? Visit the Video Hub →</a></p>
    </div>
  </section>
</Base>

<script>
  const grid = document.querySelector('[data-res-grid]');
  const chips = document.querySelectorAll('.filter-chip');
  const search = document.querySelector('[data-res-search]');
  const count = document.querySelector('[data-res-count]');
  const empty = document.querySelector('[data-res-empty]');
  const cards = grid.querySelectorAll('[data-category]');
  let activeCategory = 'All';

  function applyFilters() {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const categoryMatch = activeCategory === 'All' || card.dataset.category === activeCategory;
      const searchMatch = !q || card.dataset.tags.includes(q);
      const show = categoryMatch && searchMatch;
      card.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} checklist${visible === 1 ? '' : 's'}`;
    if (empty) empty.hidden = visible !== 0;
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    activeCategory = chip.dataset.filter;
    applyFilters();
  }));

  search?.addEventListener('input', applyFilters);
  applyFilters();
</script>

<style>
  .page-head { padding: 130px 0 0; }
  .page-head h1 { margin: 8px 0 18px; }
  .res { text-decoration: none; display: flex; flex-direction: column; }
  .res .link-arrow { display: inline-block; margin-top: auto; padding-top: 14px; }
  .note { font-size: 0.85rem; color: var(--faint); margin-top: 28px; }
  code { font-family: var(--font-mono); color: var(--cyan); font-size: 0.85em; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .filter-chip { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--mute); border: 1px solid var(--line); border-radius: 100px; padding: 9px 16px; background: transparent; cursor: pointer; transition: 0.2s; }
  .filter-chip:hover { color: var(--ink); border-color: var(--line-strong); }
  .filter-chip.is-active { color: var(--cyan); border-color: var(--line-strong); background: rgba(48,226,244,0.06); }
  .search-wrap { margin-bottom: 18px; }
  .search-input { width: 100%; max-width: 420px; font-family: var(--font-body, inherit); font-size: 15px; color: var(--ink); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; background: rgba(255,255,255,0.02); transition: 0.2s; }
  .search-input::placeholder { color: var(--faint); }
  .search-input:focus { outline: none; border-color: var(--line-strong); background: rgba(48,226,244,0.04); }
  .result-count { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--faint); margin-bottom: 18px; }
  .no-results { color: var(--mute); padding: 20px 0; }
</style>
