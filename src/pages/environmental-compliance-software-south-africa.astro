---
import Base from '../layouts/Base.astro';
import FeatureReveal from '../components/FeatureReveal.astro';
import SolutionVisual from '../components/SolutionVisual.astro';
import '../styles/feature.css';
import { solutionDetails } from '../data/site.js';
import { solutionIcon } from '../data/solutionLooks.js';
import ProofCards from '../components/ProofCards.astro';
import { brand } from '../data/site.js';

const faqs = [
  { q: 'What is environmental compliance software in the South African context?', a: 'It is a system for tracking environmental legal obligations, monitoring data and evidence against South African legislation such as NEMA, the National Water Act, the Air Quality Act and the Waste Act, so that compliance can be demonstrated to the DFFE and provincial regulators rather than assembled manually before each inspection.' },
  { q: 'Does ENVIRX® cover NEMA and the NEMA specific environmental management acts?', a: 'Yes. ENVIRX® tracks obligations aligned to NEMA and its specific acts, including atmospheric emission licences under the Air Quality Act, water use licences under the National Water Act and waste obligations under the Waste Act, with continuous updates as legislation changes.' },
  { q: 'Can it support carbon tax and King V reporting?', a: 'Yes. ENVIRX® consolidates emissions and environmental performance data that feeds carbon tax calculations under the Carbon Tax Act and the environmental disclosures expected under the King V governance code and JSE sustainability requirements.' },
  { q: 'Is it suitable for multi-site operations across South Africa?', a: 'Yes. ENVIRX® consolidates air, water, waste, noise, biodiversity and energy monitoring across every site into one auditable system, so provincial and national reporting is drawn from a single source rather than reconciled by hand.' },
];

const vis = solutionDetails['envirx'];
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const laws = [
  { t: 'NEMA (Act 107 of 1998)', b: 'Track the duty of care, environmental authorisations and EIA conditions as live obligations with owners and evidence, not paperwork in a drawer.' },
  { t: 'Air Quality Act (AQA)', b: 'Manage atmospheric emission licence (AEL) conditions, emissions monitoring and reporting to the licensing authority in one place.' },
  { t: 'National Water Act', b: 'Hold water use licence (WUL) conditions, abstraction and discharge monitoring, and compliance evidence against each authorisation.' },
  { t: 'Waste Act & Carbon Tax Act', b: 'Record waste manifests and classification, and consolidate the emissions data that underpins carbon tax and King V disclosure.' },
];
---

<Base
  title="Environmental Compliance Software South Africa | ENVIRX®"
  description="Environmental compliance software for South African law: NEMA, the Air Quality Act, the National Water Act and the Waste Act, on one auditable platform."
>
  <script type="application/ld+json" set:html={schema} />

  <div class="fp fp-geo" style="--acc: #34d399">
  <section class="geo-hero">
    <div class="geo-hero-glow" aria-hidden="true"></div>
    <div class="container fp-hero-grid geo-grid">
      <div class="geo-hero-inner">
      <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Environmental compliance software (South Africa)</span></div>
      <h1>Environmental compliance software<span class="fp-hl"> for South African operations.</span></h1>
      <p class="lede">South African environmental law moves quickly, and the evidence a regulator asks for is rarely where you left it. ENVIRX® is environmental compliance software that gives operations across South Africa one auditable system for environmental obligations, monitoring data and reporting, aligned to NEMA and the specific environmental management acts.</p>
      <div class="geo-actions">
        <a href="/demo/" class="btn btn-primary">Request a demo</a>
        <a href="/envirx/" class="btn btn-ghost">Explore ENVIRX® &rarr;</a>
      </div>
      <div class="std-strip">
        {['NEMA', 'Air Quality Act', 'National Water Act', 'Waste Act', 'King V', 'GHG Protocol'].map((s) => (<span class="std-badge">{s}</span>))}
      </div>
      </div>
      <div class="geo-vis">
        <SolutionVisual slug="envirx" standards={vis.standards} groups={vis.moduleGroups.map((g) => g.category)} icon={vis.icon || solutionIcon('envirx')} />
      </div>
    </div>
  </section>

  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
        <span class="fp-eb">Built for local legislation</span>
        <h2 class="fp-h2">The South African environmental framework, tracked continuously.</h2>
        <p class="lede">Most environmental non-compliances are not deliberate. They happen because obligations sit in spreadsheets that nobody updates when the law changes. ENVIRX® holds each obligation as a live, owned record.</p>
      </div>
      <div class="grid cols-2">
        {laws.map((l) => (
          <div class="card gcard rv">
            <h3>{l.t}</h3>
            <p class="mute">{l.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
        <span class="fp-eb">Why South African operations choose ENVIRX®</span>
        <h2 class="fp-h2">One auditable environmental record, across every site.</h2>
        <p class="lede">ENVIRX® is the environmental data and emissions engine within XGRC® Software, a platform certified to ISO 27001:2022 by BSI. It captures air, water, waste, noise, biodiversity and energy data from manual entry, business systems and IoT devices across all your sites, calculates emissions, links each data point to the legal obligation it serves, and produces the evidence a DFFE or provincial inspector expects, on demand. Because it shares one data foundation with XGRC® risk, ESG and assurance, your environmental data is governed as part of the wider compliance picture rather than in isolation.</p>
        <p class="lede">How do licence conditions become a register you can manage? Read <a href="/insights/environmental-compliance-software-for-regulatory-management/">how environmental obligations software works</a>.</p>
        <a href="/envirx/" class="link-arrow">See the full ENVIRX® capabilities &rarr;</a>
      </div>
    </div>
  </section>

  <ProofCards companies={["Servest", "Interwaste"]} heading="South African operations already running on XGRC®." />

  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
        <span class="fp-eb">Frequently asked</span>
        <h2 class="fp-h2">Environmental compliance in South Africa.</h2></div>
      <div class="fp-faqs">
        {faqs.map((f, i) => (
          <details class="fp-faq rv">
            <summary><span class="fp-fq-n">{String(i + 1).padStart(2, '0')}</span><span class="fp-fq-q">{f.q}</span><span class="fp-fq-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fp-sec">
    <div class="container">
      <div class="fp-cta cta-block rv">
        <div class="cta-tag"><span class="dot"></span>Environmental compliance</div>
        <h2>See ENVIRX® against your own compliance obligations.</h2>
        <p class="lede">Talk to an XGRC® specialist about how ENVIRX® fits your sites, permits and reporting duties under South African environmental law.</p>
        <div class="cta-actions"><a href="/demo/" class="btn btn-primary">Request a live demo</a><a href="/envirx/" class="btn btn-ghost">Explore ENVIRX®</a></div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
  </div>
</Base>
<FeatureReveal />

<style>
  .lede a { color: var(--cyan); }
</style>
