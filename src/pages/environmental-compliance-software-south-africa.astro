---
import Base from '../layouts/Base.astro';
import ProofCards from '../components/ProofCards.astro';
import { brand } from '../data/site.js';

const faqs = [
  { q: 'What is environmental compliance software in the South African context?', a: 'It is a system for tracking environmental legal obligations, monitoring data and evidence against South African legislation such as NEMA, the National Water Act, the Air Quality Act and the Waste Act, so that compliance can be demonstrated to the DFFE and provincial regulators rather than assembled manually before each inspection.' },
  { q: 'Does ENVIRX® cover NEMA and the NEMA specific environmental management acts?', a: 'Yes. ENVIRX® tracks obligations aligned to NEMA and its specific acts, including atmospheric emission licences under the Air Quality Act, water use licences under the National Water Act and waste obligations under the Waste Act, with continuous updates as legislation changes.' },
  { q: 'Can it support carbon tax and King V reporting?', a: 'Yes. ENVIRX® consolidates emissions and environmental performance data that feeds carbon tax calculations under the Carbon Tax Act and the environmental disclosures expected under the King V governance code and JSE sustainability requirements.' },
  { q: 'Is it suitable for multi-site operations across South Africa?', a: 'Yes. ENVIRX® consolidates air, water, waste, noise, biodiversity and energy monitoring across every site into one auditable system, so provincial and national reporting is drawn from a single source rather than reconciled by hand.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const laws = [
  { t: 'NEMA (Act 107 of 1998)', b: 'Track the duty of care, environmental authorisations and EIA conditions as live obligations with owners and evidence, not paperwork in a drawer.' },
  { t: 'Air Quality Act (AQA)', b: 'Manage atmospheric emission licence (AEL) conditions, emissions monitoring and reporting to the licensing authority in one place.' },
  { t: 'National Water Act', b: 'Hold water use licence (WUL) conditions, abstraction and discharge monitoring, and compliance evidence against each authorisation.' },
  { t: 'Waste Act & Carbon Tax Act', b: 'Record waste manifests and classification, and consolidate the emissions data that underpins carbon tax and King V disclosure.' },
];
---

<Base
  title="Environmental Compliance Software in South Africa | XGRC® ENVIRX®"
  description="Environmental compliance software built for South African legislation, NEMA, the Air Quality Act, the National Water Act and the Waste Act, on one auditable platform. Trusted by Servest and Interwaste."
>
  <script type="application/ld+json" set:html={schema} />

  <section class="geo-hero">
    <div class="geo-hero-glow" aria-hidden="true"></div>
    <div class="container geo-hero-inner">
      <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Environmental compliance software (South Africa)</span></div>
      <h1>Environmental compliance software for South African operations.</h1>
      <p class="lede">South African environmental law moves quickly, and the evidence a regulator asks for is rarely where you left it. ENVIRX® gives operations across South Africa one auditable system for environmental obligations, monitoring data and reporting, aligned to NEMA and the specific environmental management acts.</p>
      <div class="geo-actions">
        <a href="/demo" class="btn btn-primary">Request a demo</a>
        <a href="/envirx/" class="btn btn-ghost">Explore ENVIRX® &rarr;</a>
      </div>
      <div class="std-strip">
        {['NEMA', 'Air Quality Act', 'National Water Act', 'Waste Act', 'King V', 'ISO 14001'].map((s) => (<span class="std-badge">{s}</span>))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Built for local legislation</span>
        <h2>The South African environmental framework, tracked continuously.</h2>
        <p class="lede">Most environmental non-compliances are not deliberate. They happen because obligations sit in spreadsheets that nobody updates when the law changes. ENVIRX® holds each obligation as a live, owned record.</p>
      </div>
      <div class="grid cols-2">
        {laws.map((l) => (
          <div class="card">
            <h3>{l.t}</h3>
            <p class="mute">{l.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Why South African operations choose ENVIRX®</span>
        <h2>One auditable environmental record, across every site.</h2>
        <p class="lede">ENVIRX® is the environmental compliance and monitoring solution within XGRC® Software, a platform certified to ISO 27001:2022 by BSI. It captures air, water, waste, noise, biodiversity and energy data across all your sites, links each data point to the legal obligation it serves, and produces the evidence a DFFE or provincial inspector expects, on demand. Because it shares one data foundation with XGRC® risk, ESG and assurance, your environmental data is governed as part of the wider compliance picture rather than in isolation.</p>
        <a href="/envirx/" class="link-arrow">See the full ENVIRX® capabilities &rarr;</a>
      </div>
    </div>
  </section>

  <ProofCards companies={["Servest", "Interwaste"]} heading="South African operations already running on XGRC®." />

  <section class="section--tight">
    <div class="container">
      <div class="section-head"><span class="eyebrow"><span class="dot"></span>Frequently asked</span><h2>Environmental compliance in South Africa.</h2></div>
      <div class="faq-list">
        {faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-block">
        <div class="cta-tag"><span class="dot"></span>Environmental compliance</div>
        <h2>See ENVIRX® against your own compliance obligations.</h2>
        <p class="lede">Talk to an XGRC® specialist about how ENVIRX® fits your sites, permits and reporting duties under South African environmental law.</p>
        <div class="cta-actions"><a href="/demo" class="btn btn-primary">Request a live demo</a><a href="/envirx/" class="btn btn-ghost">Explore ENVIRX®</a></div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .geo-hero { padding: 130px 0 56px; position: relative; overflow: hidden; }
  .geo-hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 55% at 15% 0%, rgba(48,226,244,0.08) 0%, transparent 65%); }
  .geo-hero-inner { max-width: 820px; position: relative; }
  .geo-hero h1 { font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -0.04em; line-height: 1.02; margin: 12px 0 18px; background: linear-gradient(135deg, var(--ink) 45%, var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .geo-hero .lede { max-width: 680px; margin-bottom: 28px; }
  .geo-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 26px; }
  .std-strip { display: flex; flex-wrap: wrap; gap: 10px; }
  .std-badge { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--cyan); border: 1px solid rgba(48,226,244,0.25); border-radius: 100px; padding: 6px 14px; background: rgba(48,226,244,0.05); }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin-bottom: 18px; }
  .breadcrumb a { color: var(--mute); text-decoration: none; } .breadcrumb a:hover { color: var(--cyan); }
  .card h3 { color: var(--ink); margin-bottom: 8px; font-size: 1.05rem; }
  .mute { color: var(--mute); font-size: 0.95rem; line-height: 1.6; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .faq-item { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--panel); padding: 4px 20px; }
  .faq-item summary { cursor: pointer; padding: 16px 0; font-weight: 600; color: var(--ink); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { color: var(--cyan); }
  .faq-item p { color: var(--mute); padding: 0 0 16px; line-height: 1.65; }
  .cta-block { text-align: center; padding: clamp(36px, 6vw, 64px); background: linear-gradient(160deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02)); border-color: var(--line-strong); }
  .cta-tag { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cyan); margin-bottom: 16px; }
  .cta-block h2 { margin-bottom: 14px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .cta-block .lede { margin: 0 auto 28px; max-width: 540px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .contact-line { font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-top: 22px; }
</style>
