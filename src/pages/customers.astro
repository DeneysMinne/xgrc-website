---
import Base from '../layouts/Base.astro';
import FeatureReveal from '../components/FeatureReveal.astro';
import '../styles/feature.css';
import LogoTile from '../components/LogoTile.astro';
import Testimonials from '../components/Testimonials.astro';
import { customerGroups } from '../data/site.js';

// Hero mosaic: the first logo from each sector.
const mosaic = customerGroups.map((g) => g.customers.find((c) => c.logo)).filter(Boolean).slice(0, 9);
---

<Base
  title="Customers | XGRC® Software"
  description="Trusted by 800+ companies across mining, manufacturing, food, logistics, finance and technology, from single-site teams to multinationals worldwide."
>
  <!-- Hero -->
  <div class="fp" style="--acc: #30e2f4">
  <header class="fp-hero">
    <div class="fp-hero-bg" aria-hidden="true"></div>
    <div class="container fp-hero-grid">
      <div>
        <span class="fp-chip">Customers</span>
        <h1 class="fp-title">Trusted by more than<br><span class="fp-hl">800 companies</span> globally.</h1>
        <p class="fp-dek">Organisations across mining, steel, food, logistics, finance and technology rely on XGRC® to unify compliance — from a single regional operation to the multinational headquarters it reports into, across Africa, Europe, Australia and the Americas.</p>
      </div>
      <div class="mosaic" aria-hidden="true">
        <div class="mosaic-halo"></div>
        <div class="mosaic-grid">
          {mosaic.map((c, i) => (<span class="mosaic-tile" style={`--d: ${i * 90}ms`}><img src={`/assets/logos/customers/${c.logo}`} alt="" loading="eager" decoding="async" /></span>))}
        </div>
      </div>
    </div>
  </header>

  <!-- Sticky sector filter chips -->
  <div class="chip-bar" id="chipBar" role="navigation" aria-label="Filter by sector">
    <div class="container chip-inner">
      <button class="chip-btn is-active" data-sector="all">All sectors</button>
      {customerGroups.map(g => (
        <button class="chip-btn" data-sector={g.id}>{g.chip}</button>
      ))}
    </div>
  </div>

  <!-- Sector logo grids -->
  <div class="sectors-wrap" id="sectorsStart">
    {customerGroups.map((g, i) => (
      <section class="sector-section" id={g.id} data-sector={g.id}>
        <div class="container">
          <header class="sector-hd">
            <span class="sector-idx">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="sector-name">{g.sector}</h2>
          </header>
          <div class="logo-grid">
            {g.customers.map(c => (
              <LogoTile name={c.name} logo={c.logo} url={c.url} caseStudySlug={c.caseStudySlug} />
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Every published testimonial (the homepage shows three) -->
  <div class="stories-gap"></div>
  <Testimonials />

  <!-- CTA -->
  <section class="fp-sec">
    <div class="container">
      <div class="fp-cta rv">
        <span class="fp-eb">Join them</span>
        <h2>Your organisation belongs here.</h2>
        <p>Whether you are starting with one discipline or coordinating assurance enterprise-wide, XGRC® gives you the foundation to move forward with confidence.</p>
        <div class="fp-actions"><a href="/demo/" class="btn btn-primary">Book a demo</a></div>
      </div>
    </div>
  </section>
  </div>
</Base>
<FeatureReveal />

<style>
  .mosaic { position: relative; }
  .mosaic-halo { position: absolute; inset: 8%; background: radial-gradient(closest-side, rgba(48, 226, 244, 0.3), transparent); filter: blur(36px); z-index: -1; }
  .mosaic-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; transform: perspective(1400px) rotateY(-12deg) rotateX(6deg); }
  .mosaic-tile { aspect-ratio: 1.3; border-radius: 16px; background: #fff; display: grid; place-items: center; padding: 14%; box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(48, 226, 244, 0.25); animation: tileIn 0.8s calc(0.2s + var(--d)) cubic-bezier(0.16, 1, 0.3, 1) both, tileFloat 6s calc(1s + var(--d) * 3) ease-in-out infinite; }
  .mosaic-tile:nth-child(even) { translate: 0 14px; }
  .mosaic-tile img { max-width: 100%; max-height: 100%; object-fit: contain; }
  @keyframes tileIn { from { opacity: 0; transform: translateY(20px) scale(0.9); } }
  @keyframes tileFloat { 50% { transform: translateY(-6px); } }
  @media (max-width: 640px) { .mosaic-grid { transform: none; gap: 10px; } }
  @media (prefers-reduced-motion: reduce) { .mosaic-tile { animation: none; } }

  .stories-gap { height: clamp(48px, 8vw, 96px); }

  /* ── Sticky chip bar ──────────────────────────────────── */
  .chip-bar {
    position: sticky;
    top: 74px;
    z-index: 60;
    background: rgba(6, 15, 28, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .chip-inner {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 11px;
    padding-bottom: 11px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chip-inner::-webkit-scrollbar { display: none; }

  .chip-btn {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: 100px;
    color: var(--mute);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    padding: 6px 14px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .chip-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .chip-btn.is-active {
    color: var(--void);
    background: var(--cyan);
    border-color: var(--cyan);
  }

  /* ── Sectors ──────────────────────────────────────────── */
  .sectors-wrap { padding-bottom: 20px; }

  .sector-section {
    padding: 52px 0 40px;
    border-top: 1px solid var(--line);
  }
  .sector-section:first-child { border-top: none; }

  .sector-hd {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 32px;
  }
  .sector-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cyan);
    opacity: 0.65;
    flex-shrink: 0;
  }
  .sector-name {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  /* ── Logo grid ────────────────────────────────────────── */
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  /* ── CTA ──────────────────────────────────────────────── */
  .cust-cta {
    text-align: center;
    padding: clamp(40px, 6vw, 68px);
    background: linear-gradient(160deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02));
    border-color: var(--line-strong);
  }
  .cust-cta h2 { margin: 10px 0 16px; }
  .cust-cta .lede { margin: 0 auto 28px; max-width: 52ch; }

  /* ── Mobile ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .logo-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
  }
</style>

<script>
  const chipBar  = document.getElementById('chipBar');
  const chips    = document.querySelectorAll('.chip-btn');
  const sections = document.querySelectorAll('.sector-section');

  // Click chip → smooth scroll to sector (offset for sticky nav + chip bar)
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const id = chip.dataset.sector;
      if (id === 'all') {
        document.getElementById('sectorsStart').scrollIntoView({ behavior: 'smooth' });
      } else {
        const target = document.getElementById(id);
        if (target) {
          const offset = 74 + (chipBar ? chipBar.offsetHeight : 50) + 16;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    });
  });

  // Scroll → highlight active chip + scroll chip into view in chip bar
  function updateActive() {
    const offset = 74 + (chipBar ? chipBar.offsetHeight : 50) + 24;
    let activeId = 'all';
    sections.forEach(section => {
      if (section.getBoundingClientRect().top <= offset) {
        activeId = section.dataset.sector;
      }
    });
    chips.forEach(c => {
      const active = c.dataset.sector === activeId;
      c.classList.toggle('is-active', active);
      if (active) {
        c.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });
  }

  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
</script>
