---
import Base from '../layouts/Base.astro';
import ProofCards from '../components/ProofCards.astro';
import { brand } from '../data/site.js';

const faqs = [
  { q: 'What is SHEQ software and why do South African operations need it?', a: 'SHEQ software manages safety, health, environment and quality processes through structured, auditable workflows. In South Africa it is used to evidence compliance with the Occupational Health and Safety Act, the Mine Health and Safety Act and ISO 45001, 9001 and 14001, replacing the spreadsheets and paper forms that fall apart under an inspection or audit.' },
  { q: 'Does SHEQX® support the OHS Act and legal appointments?', a: 'Yes. SHEQX® manages legal appointments, MSDS records, permits, inspections and incidents aligned to the Occupational Health and Safety Act (Act 85 of 1993), with clear ownership and expiry tracking so appointments and permits never lapse unnoticed.' },
  { q: 'Does SHEQX® work on remote sites with no signal?', a: 'Yes. SHEQX® has native apps for iOS and Android, so incidents, inspections and audits can be recorded in the field. The apps capture data offline on sites with no signal and sync it when the device reconnects.' },
  { q: 'Is SHEQX® suitable for mining, construction and high-risk sectors?', a: 'Yes. SHEQX® is used across construction, logistics, manufacturing and industrial services, with modules for incident management, risk assessment, emergency preparedness, medical surveillance and ISO-aligned audits that suit high-risk, multi-site operations.' },
  { q: 'Can SHEQX® give group-level visibility across multiple sites?', a: 'Yes. SHEQX® consolidates SHEQ performance across every site and business unit into real-time dashboards, so group SHEQ managers see incidents, non-conformances and audit findings across the organisation from one place.' },
  { q: 'What is SHEQ management software?', a: 'SHEQ management software helps organisations manage safety, health, environmental and quality processes through structured workflows, auditable records, incident tracking, inspections, audits and compliance monitoring, so the SHEQ management system runs on one connected set of records instead of spreadsheets, email and paper forms.' },
  { q: 'How do we consolidate SHEQ across multiple sites onto one system?', a: 'Agree a common framework first (incident categories, severity ratings, the risk matrix and action statuses), map the group, business unit and site structure, migrate live records such as open actions, legal registers, appointments and permits, then pilot at one or two sites before rolling out in waves. SHEQX® keeps site-specific legal registers, permits and appointments within the same platform that gives the group its consolidated view.' },
];

const consolidation = [
  { t: 'One common SHEQ framework', b: 'Incident categories, severity ratings, risk scoring and action statuses defined once, so performance at every site can be compared fairly.' },
  { t: 'Site-level ownership', b: 'Each site keeps its own legal register, permits, legal appointments and inspections, owned by the people accountable for them, inside the same platform.' },
  { t: 'Group-wide visibility', b: 'Real-time dashboards roll incidents, non-conformances, audit findings and open actions up from site to business unit to group, without manual consolidation.' },
  { t: 'Patterns across operations', b: 'A near miss at one site is seen alongside similar events elsewhere, so a problem developing at several operations is caught before it becomes a serious incident.' },
];

const reading = [
  { href: '/insights/what-is-sheq/', t: 'What is SHEQ?', b: 'What SHEQ means, how it differs from HSE and SHERQ, and how a SHEQ management system works under South African law.' },
  { href: '/insights/how-to-consolidate-sheq-management-across-multiple-sites/', t: 'Consolidating SHEQ across multiple sites', b: 'A practical, step-by-step approach to moving every site onto one SHEQ system without losing local ownership.' },
  { href: '/insights/why-incident-reporting-is-critical-in-sheq-management/', t: 'Why incident reporting is critical', b: 'The legal and operational case for incident and near miss reporting, and how to turn reports into closed actions.' },
  { href: '/insights/what-is-sheq-software-complete-guide/', t: 'What is SHEQ software?', b: 'What modern SHEQ software does, and what it should deliver for compliance-driven organisations.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const laws = [
  { t: 'OHS Act (Act 85 of 1993)', b: 'Manage legal appointments, permits, MSDS records and inspections with owners and expiry dates, so nothing lapses between audits.' },
  { t: 'Mine Health & Safety Act', b: 'Track hazards, incidents, medical surveillance and emergency preparedness to the standard high-risk operations are held to.' },
  { t: 'ISO 45001 · 9001 · 14001', b: 'Run one integrated management system that sustains certification instead of scrambling for evidence before each surveillance audit.' },
  { t: 'COIDA & incident reporting', b: 'Capture incidents once, drive them to closure, and hold the auditable trail that injury and compensation reporting depends on.' },
];
---

<Base
  title="SHEQ Software South Africa | SHEQ Management Software | SHEQX®"
  description="SHEQ software for South Africa: manage safety, health, environment and quality across every site on one auditable system, aligned to the OHS Act and ISO 45001, 9001 and 14001."
>
  <script type="application/ld+json" set:html={schema} />

  <section class="geo-hero">
    <div class="geo-hero-glow" aria-hidden="true"></div>
    <div class="container geo-hero-inner">
      <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>SHEQ software (South Africa)</span></div>
      <h1>SHEQ software built for South African operations.</h1>
      <p class="lede">Safety, health, environment and quality data scattered across email, spreadsheets and paper forms does not survive an inspection. SHEQX® is SHEQ management software that gives South African operations one auditable system, across every site, that closes actions, sustains ISO certification and evidences compliance with the OHS Act and the Mine Health and Safety Act.</p>
      <div class="geo-actions">
        <a href="/demo/" class="btn btn-primary">Request a demo</a>
        <a href="/sheqx/" class="btn btn-ghost">Explore SHEQX® &rarr;</a>
      </div>
      <div class="std-strip">
        {['OHS Act', 'Mine Health & Safety Act', 'ISO 45001', 'ISO 9001', 'ISO 14001', 'COIDA'].map((s) => (<span class="std-badge">{s}</span>))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Built for local legislation</span>
        <h2>The South African SHEQ framework, in one system.</h2>
        <p class="lede">SHEQX® holds every legal appointment, permit, incident and corrective action as a live, owned record, so compliance is continuous rather than reconstructed the week before an audit.</p>
      </div>
      <div class="grid cols-2">
        {laws.map((l) => (
          <div class="card"><h3>{l.t}</h3><p class="mute">{l.b}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Why South African operations choose SHEQX®</span>
        <h2>From reactive paperwork to a proactive safety culture.</h2>
        <p class="lede">SHEQX® is the Safety, Health, Environment and Quality solution within XGRC® Software, a platform certified to ISO 27001:2022 by BSI. It manages the complete SHEQ lifecycle, from hazard identification and incident capture through risk treatment, permits, inspections and ISO-aligned audits, across every site on one platform. Because it shares one data foundation with XGRC® risk, environmental and assurance solutions, SHEQ risks stay connected to enterprise risk rather than trapped in a silo.</p>
        <a href="/sheqx/" class="link-arrow">See the full SHEQX® capabilities &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Multi-site SHEQ consolidation</span>
        <h2>One SHEQ management system across every site.</h2>
        <p class="lede">Growing groups often end up with a different SHEQ system at every site: separate spreadsheets, separate forms and separate ways of scoring risk. SHEQX® brings every site and business unit onto one platform with a common framework, while each site keeps ownership of its own obligations. Interwaste used SHEQX® to unify SHEQ processes across multiple regions, reducing reporting effort, accelerating safety action closure and increasing near-miss reporting volumes.</p>
      </div>
      <div class="grid cols-2">
        {consolidation.map((c) => (
          <div class="card"><h3>{c.t}</h3><p class="mute">{c.b}</p></div>
        ))}
      </div>
      <a href="/insights/how-to-consolidate-sheq-management-across-multiple-sites/" class="link-arrow consolidation-link">How to consolidate SHEQ management across multiple sites &rarr;</a>
    </div>
  </section>

  <ProofCards companies={["Servest", "Sandton Plant Hire", "Interwaste"]} heading="South African operations already running on SHEQX®." />

  <section class="section--tight">
    <div class="container">
      <div class="section-head"><span class="eyebrow"><span class="dot"></span>Frequently asked</span><h2>SHEQ software in South Africa.</h2></div>
      <div class="faq-list">
        {faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>SHEQ guides</span>
        <h2>Understand SHEQ before you choose software.</h2>
        <p class="lede">Practical guides from the XGRC® team on SHEQ management, incident reporting and running SHEQ across multiple sites.</p>
      </div>
      <div class="grid cols-2">
        {reading.map((r) => (
          <a href={r.href} class="card reading-card"><h3>{r.t}</h3><p class="mute">{r.b}</p><span class="reading-arrow">Read the guide &rarr;</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-block">
        <div class="cta-tag"><span class="dot"></span>Safety, Health, Environment &amp; Quality</div>
        <h2>See SHEQX® against your own SHEQ obligations.</h2>
        <p class="lede">Talk to an XGRC® specialist about how SHEQX® fits your sites, legal appointments and ISO certification under South African law.</p>
        <div class="cta-actions"><a href="/demo/" class="btn btn-primary">Request a live demo</a><a href="/sheqx/" class="btn btn-ghost">Explore SHEQX®</a></div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .geo-hero { padding: 130px 0 56px; position: relative; overflow: hidden; }
  .geo-hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 55% at 15% 0%, rgba(48,226,244,0.08) 0%, transparent 65%); }
  .geo-hero-inner { max-width: 820px; position: relative; }
  .geo-hero h1 { font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -0.04em; line-height: 1.02; margin: 12px 0 18px; background: linear-gradient(135deg, var(--ink) 45%, var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .geo-hero .lede { max-width: 700px; margin-bottom: 28px; }
  .geo-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 26px; }
  .std-strip { display: flex; flex-wrap: wrap; gap: 10px; }
  .std-badge { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--cyan); border: 1px solid rgba(48,226,244,0.25); border-radius: 100px; padding: 6px 14px; background: rgba(48,226,244,0.05); }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin-bottom: 18px; }
  .breadcrumb a { color: var(--mute); text-decoration: none; } .breadcrumb a:hover { color: var(--cyan); }
  .card h3 { color: var(--ink); margin-bottom: 8px; font-size: 1.05rem; }
  .mute { color: var(--mute); font-size: 0.95rem; line-height: 1.6; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .faq-item { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--panel); padding: 4px 20px; }
  .faq-item summary { cursor: pointer; padding: 16px 0; font-weight: 600; color: var(--ink); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { color: var(--cyan); }
  .faq-item p { color: var(--mute); padding: 0 0 16px; line-height: 1.65; }
  .cta-block { text-align: center; padding: clamp(36px, 6vw, 64px); background: linear-gradient(160deg, rgba(48,226,244,0.06), rgba(38,158,198,0.02)); border-color: var(--line-strong); }
  .cta-tag { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cyan); margin-bottom: 16px; }
  .cta-block h2 { margin-bottom: 14px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .cta-block .lede { margin: 0 auto 28px; max-width: 540px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .consolidation-link { display: inline-block; margin-top: 22px; }
  .reading-card { display: block; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  .reading-card:hover { border-color: var(--cyan); }
  .reading-arrow { display: inline-block; margin-top: 10px; color: var(--cyan); font-size: 0.9rem; font-weight: 600; }
  .contact-line { font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-top: 22px; }
</style>
