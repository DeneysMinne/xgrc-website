---
import Base from '../../layouts/Base.astro';
import { useCaseRegistry } from '../../data/useCaseRegistry.js';

const isoPages = useCaseRegistry.filter((u) => u.category === 'ISO Readiness');

const standards = [
  { std: 'ISO 9001', topic: 'Quality management', law: 'Customer, contract and product requirements; SABS publishes it locally as a SANS standard.', uc: 'iso-9001-readiness', sol: 'msx', solName: 'MSX®' },
  { std: 'ISO 14001', topic: 'Environmental management', law: 'Compliance obligations under NEMA (Act 107 of 1998), the National Water Act (Act 36 of 1998) and NEM:AQA (Act 39 of 2004).', uc: 'iso-14001-readiness', sol: 'envirx', solName: 'ENVIRX®' },
  { std: 'ISO 45001', topic: 'Occupational health and safety', law: 'Supports, but does not replace, the OHS Act (Act 85 of 1993) and, on mines, the MHSA (Act 29 of 1996).', uc: 'iso-45001-readiness', sol: 'sheqx', solName: 'SHEQX®' },
  { std: 'ISO/IEC 27001', topic: 'Information security', law: 'Evidence for the security safeguards POPIA section 19 requires for personal information.', uc: 'iso-27001-readiness', sol: 'msxcyber', solName: 'MSXCyber®' },
  { std: 'ISO 22000', topic: 'Food safety', law: 'Sits alongside the R638 hygiene regulations under the Foodstuffs, Cosmetics and Disinfectants Act (Act 54 of 1972).', uc: 'iso-22000-readiness', sol: 'msx', solName: 'MSX®' },
  { std: 'ISO 31000', topic: 'Risk management guidelines', law: 'Not certifiable. It gives King IV and King V risk governance a recognised method.', uc: 'iso-31000-risk-management', sol: 'erm', solName: 'Enterprise Risk Management' },
];

const steps = [
  { t: 'Set the scope and context', d: 'Define which sites, activities and products the management system covers, who the interested parties are, and which legal and other requirements apply. Clause 4 of every ISO management system standard starts here.' },
  { t: 'Run the gap assessment', d: 'Test each clause, and for ISO/IEC 27001 each Annex A control, against what you do today. Record a status, the evidence that supports it and an owner for every gap.' },
  { t: 'Close the gaps with evidence', d: 'Turn gaps into actions with due dates. Link documents, records, risk assessments and training to the clause they satisfy, so the evidence is ready before the auditor asks.' },
  { t: 'Audit and review internally', d: 'Complete at least one internal audit cycle and a management review. Certification bodies expect to see both, with findings closed out.' },
  { t: 'Certify, then keep it', d: 'An accredited certification body runs a Stage 1 document review and a Stage 2 audit. Certificates run on a three-year cycle with surveillance audits in between, so the system has to keep working after the certificate arrives.' },
];

const faqs = [
  { q: 'Who can certify us to an ISO standard in South Africa?', a: 'A certification body accredited by SANAS (the South African National Accreditation System) or by another accreditation body that is a member of the IAF. Check that the body is accredited for the specific standard and scope you need, because a certificate from an unaccredited body carries little weight with customers or regulators.' },
  { q: 'Can we manage several ISO standards in one system?', a: 'Yes. ISO management system standards share the same Harmonized Structure (clauses 4 to 10), so one set of processes for context, leadership, planning, support, operation, evaluation and improvement can serve ISO 9001, 14001, 45001 and 27001 at once. PAS 99 describes how to integrate them. See the PAS 99 integrated management system guide.' },
  { q: 'Does ISO certification prove we comply with the law?', a: 'No. ISO 14001 and ISO 45001 require you to identify your compliance obligations and evaluate whether you meet them, but the certificate is not a legal ruling. Legal compliance with Acts such as NEMA or the OHS Act is still tested against the Act itself, which is why the obligations register matters as much as the clause checklist.' },
  { q: 'Is ISO 31000 a certifiable standard?', a: 'No. ISO 31000 provides principles and guidelines for risk management, so organisations align to it rather than certify against it. It is widely used to structure enterprise risk management and to show boards that risk is managed with a recognised method.' },
  { q: 'Which XGRC® solution supports which standard?', a: 'MSX® supports ISO 9001, ISO 22000 and integrated management systems, ENVIRX® supports ISO 14001, SHEQX® supports ISO 45001, MSXCyber® supports ISO/IEC 27001 and Enterprise Risk Management supports ISO 31000. They all run on the same XGRC® platform, so evidence, actions and audits are shared across standards.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'Use Cases', item: 'https://xgrcsoftware.com/use-cases/' },
        { '@type': 'ListItem', position: 3, name: 'ISO Compliance' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title="ISO Compliance Software | Readiness & Gap Assessment | XGRC®" description="ISO 9001, 14001, 45001, 27001, 22000 and 31000 readiness and gap assessment software for South African organisations, from XGRC®.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/use-cases/">Use Cases</a><span>/</span><b>ISO Compliance</b>
      </nav>
      <span class="eyebrow"><span class="dot"></span>ISO Compliance</span>
      <h1>ISO readiness, gap assessment and certification support in one platform.</h1>
      <p class="lede">XGRC® supports readiness and gap assessment across the ISO standards that matter most for quality, safety, environmental, information security and risk management. The same platform carries you from the first gap assessment to certification, and keeps the system working through every surveillance audit after it.</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="grid cols-3">
        {isoPages.map((u) => (
          <a class="card uc-card" href={`/use-cases/${u.slug}/`}>
            <span class="tag">{u.category}</span>
            <h3>{u.crumbLabel}</h3>
            <p>{u.lede}</p>
            <span class="link-arrow">View readiness guide &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>How readiness works</span>
        <h2>From gap assessment to a certificate you keep.</h2>
        <p class="lede">Most certification projects stall for the same reason: the evidence lives in shared drives, inboxes and spreadsheets, and nobody can see which clauses are actually covered. Readiness is quicker when every clause, gap, action and record sits in one place.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>South African context</span>
        <h2>Each standard, and the law it sits beside.</h2>
        <p class="lede">An ISO certificate shows that a management system works. In South Africa it sits beside legislation that auditors, inspectors and customers also test, so readiness should cover both.</p>
      </div>
      <div class="std-table" role="table" aria-label="ISO standards and South African legislation">
        <div class="std-row std-row--head" role="row">
          <span role="columnheader">Standard</span><span role="columnheader">What it covers</span><span role="columnheader">South African link</span><span role="columnheader">Supported by</span>
        </div>
        {standards.map((s) => (
          <div class="std-row" role="row">
            <span role="cell"><a href={`/use-cases/${s.uc}/`}>{s.std}</a></span>
            <span role="cell">{s.topic}</span>
            <span role="cell">{s.law}</span>
            <span role="cell"><a href={`/${s.sol}/`}>{s.solName}</a></span>
          </div>
        ))}
      </div>
      <p class="note">Running more than one standard? The <a href="/use-cases/pas99-integrated-management-system/">PAS 99 integrated management system guide</a> shows how to run them as one system. For data protection, PAIA and King V obligations, see <a href="/use-cases/regulatory-compliance/">regulatory compliance</a>.</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Frequently asked</span>
        <h2>Common questions.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-band">
        <h2>See your ISO readiness in one view.</h2>
        <p class="lede">We will walk you through a gap assessment for the standard you are working towards, using your own scope.</p>
        <a href="/demo/" class="btn btn-primary">Book a demo</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .page-head { padding: 130px 0 0; }
  .page-head h1 { margin: 8px 0 18px; max-width: 26ch; }
  .crumbs { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; color: var(--faint); display: flex; gap: 10px; align-items: center; margin-bottom: 26px; }
  .crumbs a { color: var(--mute); text-decoration: none; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs b { color: var(--ink); font-weight: 500; }
  .uc-card { text-decoration: none; display: flex; flex-direction: column; }
  .uc-card .link-arrow { margin-top: auto; padding-top: 16px; }
  .narrow { max-width: 860px; }
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .steps li { counter-increment: step; position: relative; padding: 18px 20px 18px 64px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255, 255, 255, 0.02); }
  .steps li::before { content: counter(step); position: absolute; left: 20px; top: 18px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-mono); font-size: 13px; color: var(--cyan); border: 1px solid var(--line-strong); }
  .steps h3 { font-size: 1.02rem; margin: 2px 0 6px; }
  .steps p { color: var(--mute); font-size: 0.93rem; line-height: 1.6; margin: 0; }
  .std-table { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .std-row { display: grid; grid-template-columns: 1fr 1.2fr 2.6fr 1fr; gap: 16px; padding: 14px 18px; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--mute); line-height: 1.55; }
  .std-row:first-child { border-top: none; }
  .std-row--head { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--faint); background: rgba(255, 255, 255, 0.03); }
  .std-row a { color: var(--cyan); text-decoration: none; }
  .std-row a:hover { text-decoration: underline; }
  .std-row span:first-child { color: var(--ink); font-weight: 500; }
  .note { color: var(--mute); margin-top: 18px; font-size: 0.95rem; line-height: 1.6; }
  .note a { color: var(--cyan); }
  .cta-band { text-align: center; padding: clamp(40px, 6vw, 64px); background: linear-gradient(120deg, rgba(48,226,244,0.06), rgba(0,92,169,0.05)); border-color: var(--line-strong); }
  .cta-band .lede { margin: 0 auto 26px; }
  @media (max-width: 760px) {
    .std-row { grid-template-columns: 1fr 1fr; }
    .std-row--head { display: none; }
    .std-row span:nth-child(3) { grid-column: 1 / -1; order: 3; }
  }
</style>
