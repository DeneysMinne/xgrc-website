---
import Base from '../../layouts/Base.astro';
import FeatureReveal from '../../components/FeatureReveal.astro';
import '../../styles/feature.css';
import { lookFor, solutionIcon } from '../../data/solutionLooks.js';
import { useCaseRegistry } from '../../data/useCaseRegistry.js';

const regPages = useCaseRegistry.filter((u) => u.category === 'Regulatory');

const laws = [
  { name: 'POPIA', full: 'Protection of Personal Information Act 4 of 2013', what: 'Lawful processing of personal information, security safeguards (section 19) and notifying the Information Regulator and data subjects of security compromises (section 22).', uc: 'popia-compliance' },
  { name: 'PAIA', full: 'Promotion of Access to Information Act 2 of 2000', what: 'A current PAIA manual, and a decision on each access request within 30 days, which can be extended once by up to 30 days.', uc: 'paia-compliance' },
  { name: 'King V', full: 'King Code on Corporate Governance', what: 'Board oversight of risk, compliance, technology and information, with disclosure of how the principles are applied.', uc: 'king-v-governance' },
  { name: 'GDPR', full: 'EU General Data Protection Regulation', what: 'Applies to South African organisations that offer goods or services to people in the EU, or monitor their behaviour.', uc: 'gdpr-compliance' },
];

const beyond = [
  { t: 'Health and safety', d: 'OHS Act 85 of 1993 and, on mines, the MHSA 29 of 1996.', href: '/use-cases/safety-management/', label: 'Safety management' },
  { t: 'Environment', d: 'NEMA 107 of 1998, licences and permit conditions.', href: '/use-cases/environmental-compliance/', label: 'Environmental compliance' },
  { t: 'Suppliers', d: 'B-BBEE verification and supplier documents under the B-BBEE Act 53 of 2003.', href: '/use-cases/vendor-management/', label: 'Vendor management' },
  { t: 'Controls', d: 'Proving that the controls behind your obligations actually work.', href: '/use-cases/internal-controls/', label: 'Internal controls' },
];

const faqs = [
  { q: 'Who enforces POPIA and PAIA in South Africa?', a: 'The Information Regulator. It oversees both POPIA and PAIA, receives security compromise notifications under POPIA section 22, and can investigate complaints, issue enforcement notices and impose administrative fines.' },
  { q: 'How quickly must we answer a PAIA request?', a: 'A private or public body must decide on a request within 30 days of receiving it. The period can be extended once, by up to 30 more days, in the circumstances PAIA allows, and the requester must be told of the extension and the reason for it.' },
  { q: 'Does GDPR apply to a South African company?', a: 'It can. GDPR applies to organisations outside the EU when they offer goods or services to people in the EU or monitor their behaviour there. Many South African organisations therefore manage GDPR and POPIA side by side, and much of the evidence overlaps.' },
  { q: 'Is King V compliance mandatory?', a: 'The King Code is voluntary, but the JSE Listings Requirements reference it for listed companies, and many regulators, funders and public entities expect it. In practice boards need to show how they apply the principles, which takes evidence rather than a policy statement.' },
  { q: 'What does a regulatory compliance platform do that a spreadsheet does not?', a: 'It keeps a live register of obligations, links each one to an owner, a control and the evidence that proves it, schedules reviews, and keeps a full audit trail. When a regulator, auditor or board asks, the answer is a report rather than a hunt through email.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'Use Cases', item: 'https://xgrcsoftware.com/use-cases/' },
        { '@type': 'ListItem', position: 3, name: 'Regulatory Compliance' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title="Regulatory Compliance Software | POPIA, PAIA & King V | XGRC®" description="Regulatory compliance software for South Africa. Manage POPIA, PAIA, King V and GDPR obligations with owners, controls and evidence in XGRC®.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="fp" style="--acc: #f472b6">
  <header class="fp-hero">
    <div class="fp-hero-bg" aria-hidden="true"></div>
    <div class="container fp-hero-grid">
      <div>
        <nav class="fp-crumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/use-cases/">Use Cases</a><span aria-hidden="true">/</span><b>Regulatory Compliance</b>
        </nav>
        <span class="fp-chip">Regulatory Compliance</span>
        <h1 class="fp-title">Regulatory and governance obligations,<span class="fp-hl"> managed on one platform.</span></h1>
        <p class="fp-dek">From data protection to corporate governance, XGRC® gives organisations a structured way to show they comply with the laws and codes that matter most in South Africa and internationally. Every obligation has an owner, a control and the evidence to prove it.</p>
        <div class="fp-actions">
          <a href="#guides" class="btn btn-primary">Explore the guides</a>
          <a href="/demo/" class="btn btn-ghost">Book a demo</a>
        </div>
      </div>
      <div class="reg" aria-hidden="true">
        <div class="reg-halo"></div>
        <div class="reg-panel">
          <div class="reg-bar"><i></i><i></i><i></i><span>Obligations register</span></div>
          {laws.map((l, i) => (
            <div class="reg-row" style={`--d: ${i * 120}ms`}>
              <span class="reg-law">{l.name}</span>
              <span class="reg-full">{l.full}</span>
              <span class="reg-ok">✓</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </header>

  <section class="fp-sec tight" id="guides">
    <div class="container">
      <div class="fp-cards">
        {regPages.map((u) => (
          <a class="fp-card rv" href={`/use-cases/${u.slug}/`} style={`--racc: ${lookFor(u.relatedSolution).acc}`}>
            <span class="fp-card-top">
              {solutionIcon(u.relatedSolution) ? <img src={solutionIcon(u.relatedSolution)} alt="" width="34" height="34" loading="lazy" /> : <span class="fp-mono" aria-hidden="true">AI</span>}
              <span class="fp-tag">{u.category}</span>
            </span>
            <h3>{u.crumbLabel}</h3>
            <p>{u.lede}</p>
            <span class="fp-go">View compliance guide &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="fp-sec fp-band">
    <div class="container fp-split">
      <div class="fp-head rv">
        <span class="fp-eb">What each one asks for</span>
        <h2 class="fp-h2">The obligations behind the acronyms.</h2>
        <p class="fp-lede">Regulators rarely ask whether you have a policy. They ask what you did, when, and who approved it. These are the requirements that most often need evidence.</p>
      </div>
      <div class="law-list">
        {laws.map((l) => (
          <div class="law rv">
            <h3><a href={`/use-cases/${l.uc}/`}>{l.name}</a> <span>{l.full}</span></h3>
            <p>{l.what}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="fp-sec">
    <div class="container narrow">
      <div class="fp-head rv">
        <span class="fp-eb">How XGRC® handles it</span>
        <h2 class="fp-h2">One register, one trail of evidence.</h2>
      </div>
      <div class="prose rv">
        <p>Most compliance teams track obligations in a spreadsheet and prove them with documents scattered across drives and inboxes. That works until a data breach, an access request or an audit arrives, and the team has days to show what happened.</p>
        <p>In XGRC®, each obligation from POPIA, PAIA, King V or GDPR sits in one register. It links to the policy that addresses it, the control that puts it into practice, the person who owns it and the evidence that shows it works. Reviews are scheduled, overdue items are flagged, and every change is recorded in the audit trail.</p>
        <p>When something goes wrong, the same platform runs the response. A POPIA security compromise runs through a structured workflow that includes the Information Regulator notification steps. A PAIA request is logged on the day it arrives and tracked through assessment, decision and any appeal against the statutory timeline. The board sees one picture of regulatory exposure instead of a set of separate reports.</p>
      </div>
      <div class="beyond rv">
        <h3>Beyond data protection and governance</h3>
        <ul>
          {beyond.map((b) => (
            <li><strong>{b.t}.</strong> {b.d} <a href={b.href}>{b.label} &rarr;</a></li>
          ))}
        </ul>
        <p class="note">Working towards certification as well? See <a href="/use-cases/iso-compliance/">ISO compliance</a> for readiness guides to ISO 9001, 14001, 45001, 27001 and more.</p>
      </div>
    </div>
  </section>

  <section class="fp-sec">
    <div class="container fp-split">
      <div class="fp-head rv">
        <span class="fp-eb">Frequently asked</span>
        <h2 class="fp-h2">Common questions.</h2>
      </div>
      <div class="fp-faqs">
        {faqs.map((f, i) => (
          <details class="fp-faq rv">
            <summary><span class="fp-fq-n">{String(i + 1).padStart(2, '0')}</span><span class="fp-fq-q">{f.q}</span><span class="fp-fq-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fp-sec">
    <div class="container">
      <div class="fp-cta rv">
        <h2>See your obligations in one register.</h2>
        <p>We will show you how POPIA, PAIA and King V obligations are owned, evidenced and reported in XGRC®.</p>
        <div class="fp-actions"><a href="/demo/" class="btn btn-primary">Book a demo</a></div>
      </div>
    </div>
  </section>
  </div>
</Base>
<FeatureReveal />
<style>
  .narrow { max-width: 860px; }
  .reg { position: relative; }
  .reg-halo { position: absolute; inset: 6% 4%; z-index: -1; background: radial-gradient(closest-side, rgba(244, 114, 182, 0.28), transparent); filter: blur(40px); }
  .reg-panel { border-radius: 18px; overflow: hidden; background: #0b1726; border: 1px solid color-mix(in srgb, var(--acc) 35%, var(--line)); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55); transform: perspective(1600px) rotateY(-7deg) rotateX(2deg); }
  .reg-bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; background: #0f2034; border-bottom: 1px solid var(--line); }
  .reg-bar i { width: 9px; height: 9px; border-radius: 50%; background: #2a3e55; }
  .reg-bar span { margin-left: 10px; font: 500 12.5px var(--font-body); color: #8aa1b4; }
  .reg-row { display: grid; grid-template-columns: 90px minmax(0, 1fr) 30px; gap: 14px; align-items: center; padding: 18px 22px; border-top: 1px solid var(--line); animation: rowIn 0.7s calc(0.3s + var(--d)) cubic-bezier(0.16, 1, 0.3, 1) both; }
  .reg-row:first-of-type { border-top: none; }
  @keyframes rowIn { from { opacity: 0; transform: translateX(16px); } }
  .reg-law { font: 800 1.1rem var(--font-display); color: var(--acc); }
  .reg-full { font-size: 13px; color: var(--mute); line-height: 1.4; }
  .reg-ok { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--c3); color: var(--void); font-weight: 800; font-size: 14px; box-shadow: 0 0 14px rgba(47, 232, 138, 0.5); }
  .law-list { display: flex; flex-direction: column; gap: 12px; }
  .law { padding: 20px 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); border-left: 3px solid var(--acc); transition: border-color 0.25s, transform 0.25s var(--ease); }
  .law:hover { transform: translateX(4px); }
  .law h3 { font-size: 1.1rem; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .law h3 a { color: var(--acc); text-decoration: none; font: 800 1.25rem var(--font-display); }
  .law h3 a:hover { text-decoration: underline; }
  .law h3 span { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--faint); font-weight: 400; }
  .law p { color: var(--mute); font-size: 0.95rem; line-height: 1.65; margin: 0; }
  .prose p { color: color-mix(in srgb, var(--ink) 84%, transparent); line-height: 1.8; font-size: 1.04rem; margin: 0 0 18px; }
  .prose p:first-child::first-letter { float: left; font: 800 3.6em/0.85 var(--font-display); margin: 0.06em 0.12em 0 0; background: linear-gradient(160deg, var(--acc), var(--c2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .beyond { margin-top: 30px; padding: clamp(22px, 3vw, 32px); border: 1px solid color-mix(in srgb, var(--acc) 35%, var(--line)); border-radius: 22px; background: radial-gradient(60% 120% at 0% 0%, color-mix(in srgb, var(--acc) 12%, transparent), transparent 70%), var(--panel); }
  .beyond h3 { font: 700 1.2rem var(--font-display); margin: 0 0 16px; color: var(--ink); }
  .beyond ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; color: var(--mute); font-size: 0.95rem; line-height: 1.6; }
  .beyond li { position: relative; padding: 12px 16px 12px 42px; border-radius: 12px; background: rgba(255, 255, 255, 0.025); border: 1px solid var(--line); }
  .beyond li::before { content: ''; position: absolute; left: 16px; top: 1.15em; width: 12px; height: 12px; border-radius: 4px; background: color-mix(in srgb, var(--acc) 20%, transparent); border: 1.5px solid var(--acc); }
  .beyond strong { color: var(--ink); font-weight: 600; }
  .beyond a, .note a { color: var(--acc); }
  .note { color: var(--mute); margin: 18px 0 0; font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 640px) { .reg-panel { transform: none; } .reg-row { grid-template-columns: 70px minmax(0, 1fr) 28px; padding: 14px 16px; } }
  @media (prefers-reduced-motion: reduce) { .reg-row { animation: none; } }
</style>
