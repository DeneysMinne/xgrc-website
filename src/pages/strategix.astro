---
import Base from '../layouts/Base.astro';
import FeatureReveal from '../components/FeatureReveal.astro';
import '../styles/feature.css';
import { offices } from '../data/site.js';

const divisions = [
  {
    key: 'business', tag: 'Business Solutions', tagline: 'Run the business', color: '#2f5fb0',
    desc: 'ERP, CRM, AI-driven automation and Microsoft Power Platform — the operational backbone of your enterprise. We implement, integrate and support the core systems your teams rely on every day.',
    caps: [
      { name: 'ERP & Finance', desc: 'Core financial management and enterprise resource planning.', svcs: ['Dynamics 365 Finance & Operations', 'Microsoft 365'] },
      { name: 'CRM & Sales', desc: 'Customer relationship management and sales enablement for revenue growth.', svcs: ['Dynamics 365 Sales', 'Salesforce'] },
      { name: 'AI & Automation', desc: 'Intelligent automation and AI copilots that eliminate manual work.', svcs: ['Microsoft Copilot', 'Power Automate'] },
      { name: 'Power Platform', desc: 'Rapid business application development on Microsoft’s low-code platform.', svcs: ['Power Apps', 'Power Automate', 'Power Virtual Agents', 'Dataverse'] },
      { name: 'HR & Workforce Automation', desc: 'Automated HR processes, from onboarding to payroll.', svcs: ['Factorial'] },
    ],
  },
  {
    key: 'application', tag: 'Application Solutions', tagline: 'Govern & comply', color: '#21895a',
    desc: 'Governance, risk, compliance, ESG, health, safety and quality — delivered through XGRC® Software and specialist advisory. The division that turns regulation into competitive advantage.',
    marker: 'XGRC® Software is the flagship product of this division',
    caps: [
      { name: 'Governance & Risk', desc: 'Enterprise governance, risk management and combined assurance.', svcs: ['XGRC® Software', 'MSX®', 'Enterprise Risk Management'] },
      { name: 'Safety, Health & Environment', desc: 'SHEQ and environmental compliance for regulated, high-risk environments.', svcs: ['SHEQX®', 'ENVIRX®'] },
      { name: 'Cybersecurity Governance', desc: 'ISMS governance, plus AI-powered penetration testing and vulnerability visibility.', svcs: ['MSXCyber®', 'Hakware'] },
      { name: 'Third-Party & Supplier Compliance', desc: 'Structured onboarding, vetting and ongoing compliance of suppliers and contractors.', svcs: ['XGRC® Compliance Hub', 'XLOGIC®'] },
      { name: 'Regulatory Intelligence & Governed AI', desc: 'Jurisdiction-specific regulatory intelligence and governed AI for GRC.', svcs: ['Libryo', 'MAIA®'] },
    ],
  },
  {
    key: 'technology', tag: 'Technology Solutions', tagline: 'Build & protect', color: '#6b3fa0',
    desc: 'Cloud infrastructure, managed IT, prevention-first cyber security and data protection. The foundation layer every other Strategix division — and every enterprise client — depends on.',
    caps: [
      { name: 'Cloud & Virtualisation', desc: 'Enterprise virtualisation and private cloud, delivered as a VMware Premier Partner.', svcs: ['VMware Cloud Foundation (VCF)', 'vSphere', 'vSAN', 'VMware Cloud on AWS/Azure/Google Cloud'] },
      { name: 'Multi-Cloud Platforms', desc: 'Public cloud infrastructure design, migration and management.', svcs: ['Microsoft Azure', 'AWS', 'Google Cloud'] },
      { name: 'Network, Automation & Edge', desc: 'Software-defined networking, edge connectivity and cloud automation.', svcs: ['VMware NSX', 'VeloCloud SD-WAN', 'VMware HCX', 'VMware Tanzu', 'Aria Automation'] },
      { name: 'Prevention-First Security', desc: 'Cybersecurity built around preventing threats before they enter the environment.', svcs: ['Fortinet / FortiGate', 'Hakware'] },
      { name: 'Data Protection & Disaster Recovery', desc: 'Backup, replication and disaster recovery for business continuity.', svcs: ['Veeam', 'Rubrik'] },
      { name: 'Data Centre & Hardware', desc: 'Colocation and enterprise hardware from our data centre and hardware partners.', svcs: ['Teraco (exclusive data centre partner)', 'Lenovo', 'Dell', 'Fujitsu Siemens'] },
    ],
  },
  {
    key: 'data', tag: 'Data Solutions', tagline: 'Know your data', color: '#d97a1f',
    desc: 'Data engineering, business intelligence, data governance and intelligent integration. We help organisations move from raw, fragmented data to auditable, actionable insight.',
    caps: [
      { name: 'Business Intelligence & Reporting', desc: 'Self-service BI and analytics that put insight in the hands of business users.', svcs: ['Power BI'] },
      { name: 'Unified Data Platform & Governance', desc: 'A single platform for data integration, engineering, governance and analytics at enterprise scale.', svcs: ['Microsoft Fabric'] },
      { name: 'AI-Powered Analytics', desc: 'Conversational, AI-assisted analysis directly against your data estate.', svcs: ['Microsoft Copilot'] },
    ],
  },
];

const pillars = [
  { icon: '⚙', h3: 'Connected capability', body: 'Every division shares architecture, methodology and client context. ERP data informs risk registers. Security posture feeds governance reporting. Your systems work together because the teams building and managing them do too — inside one group.' },
  { icon: '◎', h3: 'Single accountability', body: 'One relationship. One commercial engagement. One group that owns the outcome. No finger-pointing between vendors when something goes wrong. No gaps in responsibility. Strategix is accountable for the full technology stack — always.' },
  { icon: '↗', h3: 'Proven at enterprise scale', body: 'Deployed in 60+ countries across mining, financial services, healthcare, manufacturing and government. Offices in Johannesburg, Cape Town and the United Kingdom. Delivering outcomes across six continents.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.strategix.co.za/#organization',
      name: 'Strategix Group',
      alternateName: ['Strategix', 'Strategix Technology Solutions'],
      url: 'https://www.strategix.co.za',
      logo: 'https://xgrcsoftware.com/assets/logos/brand/xgrc-icon-white.png',
      description: 'Strategix is an integrated technology group delivering cloud, security, data, ERP, application and governance solutions for enterprise organisations. Four specialist divisions — Business Solutions, Application Solutions, Technology Solutions and Data Solutions — operate as one accountable group. Business, Simplified.',
      slogan: 'Business, Simplified.',
      areaServed: [
        { '@type': 'Country', name: 'South Africa' },
        { '@type': 'Country', name: 'United Kingdom' },
      ],
      address: offices.map((o) => ({ '@type': 'PostalAddress', streetAddress: o.address, addressCountry: o.city === 'United Kingdom' ? 'GB' : 'ZA' })),
      sameAs: ['https://www.strategix.co.za'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'Strategix Group', item: 'https://xgrcsoftware.com/strategix' },
      ],
    },
  ],
});
---

<Base
  title="Strategix Group | The Technology Partner Behind XGRC® Software"
  description="Strategix is an integrated technology group delivering cloud, security, data, ERP and GRC solutions in South Africa and the UK, and the group behind XGRC®."
  ogImage="/assets/og/og-xgrc-platform.jpg"
>
  <script type="application/ld+json" set:html={schema} />

  <div class="fp strat" style="--acc: #5b8def">
  <section class="fp-hero">
    <div class="fp-hero-bg" aria-hidden="true"></div>
    <div class="container fp-hero-grid">
      <div>
      <nav class="fp-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><b>Strategix Group</b>
      </nav>
      <span class="fp-chip">The group behind XGRC® Software</span>
      <h1 class="fp-title">One group. <span class="fp-hl">Every capability you need.</span></h1>
      <p class="fp-dek">Strategix is an integrated technology group — cloud, security, data, ERP and governance — with XGRC® Software at the centre of our assurance capability. Four specialist divisions. One accountable partner. Business, Simplified.</p>
      <div class="sol-actions head-actions">
        <a href="#model" class="btn btn-primary">Explore our capability</a>
        <a href="https://www.strategix.co.za" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Visit Strategix Group &rarr;</a>
      </div>
      </div>
      <div class="quad" aria-hidden="true">
        <svg class="quad-lines" viewBox="0 0 400 400" preserveAspectRatio="none">
          {divisions.map((d, i) => { const x = i % 2 ? 300 : 100; const y = i < 2 ? 100 : 300; return (<path d={`M200 200 L${x} ${y}`} stroke={d.color} />); })}
        </svg>
        {divisions.map((d, i) => (
          <span class={`quad-tile qt-${i}`} style={`--tc: ${d.color}`}><b>{d.tag}</b><i>{d.tagline}</i><em>{d.caps.length} capabilities</em></span>
        ))}
        <span class="quad-core"><img src="/assets/logos/brand/strategix-group-logo.png" alt="" /></span>
      </div>
    </div>
  </section>

  <!-- ── Stats band ─────────────────────────────────────── -->
  <section class="stats-band rv">
    <div class="container stats-inner">
      <div class="stat-cell"><span class="stat-value">60+</span><span class="stat-label">Countries deployed</span></div>
      <div class="stat-cell"><span class="stat-value">4</span><span class="stat-label">Specialist divisions</span></div>
      <div class="stat-cell"><span class="stat-value">6</span><span class="stat-label">Continents served</span></div>
      <div class="stat-cell"><span class="stat-value">1</span><span class="stat-label">Trusted, accountable group</span></div>
    </div>
  </section>

  <!-- ── Our Model ──────────────────────────────────────── -->
  <section class="fp-sec" id="model">
    <div class="container">
      <div class="fp-head center rv">
        <span class="fp-eb">Our model</span>
        <h2 class="fp-h2">Four divisions. One integrated group.</h2>
        <p class="lede">Navigate Strategix Group's full capability — from business operations to data intelligence. Each division is a specialist practice in its own right, sharing one group delivery backbone. Select a division to explore the capabilities beneath.</p>
      </div>

      <div class="model-hub rv">
        <a href="https://www.strategix.co.za" target="_blank" rel="noopener noreferrer" class="hub-logo-link" aria-label="Visit the Strategix Group website">
          <img src="/assets/logos/brand/strategix-group-logo.png" alt="Strategix Group" class="hub-logo" />
        </a>
        <p class="hub-hint" id="hubHint">Select a division to explore its capabilities.</p>
      </div>

      <div class="model-grid rv" role="tablist" aria-label="Strategix divisions">
        {divisions.map((d) => (
          <button class="model-tile" style={`--tile-color:${d.color}`} data-div={d.key} role="tab" aria-selected="false" aria-controls="modelDetailPanel">
            <span class="model-tile-tag">{d.tag}</span>
            <span class="model-tile-sub">{d.tagline}</span>
          </button>
        ))}
      </div>

      <div class="model-detail" id="modelDetailPanel" hidden aria-live="polite">
        <div class="model-detail-head">
          <div>
            <span class="model-detail-eyebrow" id="modelDetailEyebrow"></span>
            <h3 id="modelDetailTitle"></h3>
            <p id="modelDetailDesc"></p>
            <div class="model-detail-marker" id="modelDetailMarker"></div>
          </div>
          <button class="model-detail-close" id="modelDetailClose" aria-label="Close detail">&times;</button>
        </div>
        <div class="model-cap-grid" id="modelCapGrid"></div>
      </div>
    </div>
  </section>

  <!-- ── Bridge to XGRC ─────────────────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="bridge-box rv">
        <div class="bridge-body">
          <span class="fp-eb"><img src="/assets/logos/brand/xgrc-icon-white.png" alt="" width="20" height="20" class="bridge-ic" />Application Solutions · Built by Strategix since 2015</span>
          <h3>XGRC® Software is our flagship governance and compliance product.</h3>
          <p>Founded in 2015, XGRC® Software was built to solve a problem Strategix observed across every enterprise client engagement: governance, risk and compliance data trapped in silos — invisible to the people who needed it most. A decade later, XGRC® is deployed in 60+ countries across six continents, helping organisations drive compliance, connect assurance and make governance executable.</p>
          <p>ISO 27001:2022 certified. Built on a single auditable foundation. When you work with XGRC® Software, you already work with Strategix — and the full group capability is one conversation away.</p>
        </div>
        <div class="bridge-ctas">
          <a href="/grc-software/" class="btn btn-primary">Explore XGRC® Platform</a>
          <a href="/demo/" class="btn btn-ghost">Book a demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Why Strategix ──────────────────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
        <span class="fp-eb">Why Strategix</span>
        <h2 class="fp-h2">One accountable partner. Every technology layer.</h2>
        <p class="lede">Most enterprise organisations manage six to twelve separate technology vendors. Strategix consolidates them into one integrated group — without sacrificing specialist depth in any domain.</p>
      </div>
      <div class="grid cols-3">
        {pillars.map((p, i) => (
          <div class="card pillar rv">
            <span class="pillar-n">{String(i + 1).padStart(2, '0')}</span>
            <div class="pillar-icon" aria-hidden="true">{p.icon}</div>
            <h3>{p.h3}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Delivery model ──────────────────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
        <span class="fp-eb">How we deliver</span>
        <h2 class="fp-h2">Professional Services. Managed Services.</h2>
        <p class="lede">Strategix delivers through two primary models, matched to where your organisation is today and where it needs to go.</p>
      </div>
      <div class="grid cols-2">
        <div class="card delivery-card dc-pro rv">
          <h3>Professional Services</h3>
          <p>Implementation, advisory, training and change management. For organisations deploying new solutions, undergoing transformation, or needing specialist domain expertise on a scoped basis.</p>
          <ul class="delivery-list">
            <li>Solution implementation and configuration</li>
            <li>GRC, ESG and compliance advisory</li>
            <li>Cloud architecture and migration</li>
            <li>Data platform build and integration</li>
            <li>Training, adoption and change enablement</li>
          </ul>
        </div>
        <div class="card delivery-card dc-man rv">
          <h3>Managed Services</h3>
          <p>Ongoing management, monitoring and optimisation. For organisations who want Strategix to operate and continuously improve their technology environment on an accountable, ongoing basis.</p>
          <ul class="delivery-list">
            <li>Managed cloud infrastructure and IaaS</li>
            <li>24/7 security monitoring and response</li>
            <li>Managed XGRC® platform administration</li>
            <li>Data platform operations and support</li>
            <li>Service desk and end-user support</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ───────────────────────────────────────── -->
  <section class="fp-sec cta-section">
    <div class="container">
      <div class="fp-cta rv">
        <span class="fp-eb">Get started with Strategix</span>
        <h2>Ready to work with the full group?</h2>
        <p>Whether you start with XGRC® Software, a cloud migration, an ERP rollout, or a data transformation — Strategix is the one group that can take you all the way.</p>
        <div class="fp-actions">
          <a href="https://www.strategix.co.za" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Talk to Strategix</a>
          <a href="/demo/" class="btn btn-ghost">Book an XGRC® demo</a>
        </div>
        <p class="contact-line">
          {offices.map((o) => `${o.city} · ${o.phone}`).join('  ·  ')}
        </p>
      </div>
    </div>
  </section>
  </div>
  <FeatureReveal />
</Base>

<style>
  .strat .fp-title { max-width: 16ch; }
  .head-actions { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .strat .fp-head.center { max-width: 680px; }

  /* Hero: four divisions around the group */
  .quad { position: relative; aspect-ratio: 1; max-width: 500px; width: 100%; margin-left: auto; }
  .quad-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .quad-lines path { stroke-width: 2; stroke-dasharray: 5 7; fill: none; opacity: 0.7; animation: dash 14s linear infinite; }
  .quad-tile { position: absolute; width: 44%; display: flex; flex-direction: column; gap: 4px; padding: 18px; border-radius: 20px; background: linear-gradient(160deg, color-mix(in srgb, var(--tc) 38%, #0b1626), #0a1524 90%); border: 1px solid color-mix(in srgb, var(--tc) 65%, transparent); box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 30px color-mix(in srgb, var(--tc) 22%, transparent); animation: qbob 7s ease-in-out infinite; }
  .quad-tile b { font: 700 1rem/1.25 var(--font-display); color: var(--ink); }
  .quad-tile i { font-style: normal; font-size: 12.5px; color: rgba(255,255,255,0.75); }
  .quad-tile em { font-style: normal; margin-top: 8px; font: 500 10px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--tc) 45%, #fff); }
  .qt-0 { left: 0; top: 0; } .qt-1 { right: 0; top: 0; animation-delay: -1.8s; } .qt-2 { left: 0; bottom: 0; animation-delay: -3.6s; } .qt-3 { right: 0; bottom: 0; animation-delay: -5.4s; }
  .quad-core { position: absolute; left: 50%; top: 50%; width: 34%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-items: center; padding: 6%; background: radial-gradient(circle, #13233a, #0a1524 70%); border: 1px solid var(--line-strong); box-shadow: 0 0 0 10px rgba(91,141,239,0.08), 0 0 60px rgba(91,141,239,0.3); z-index: 2; }
  .quad-core img { width: 100%; height: auto; object-fit: contain; }
  @keyframes dash { to { stroke-dashoffset: -240; } }
  @keyframes qbob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }
  @media (prefers-reduced-motion: reduce) { .quad-lines path, .quad-tile { animation: none; } }
  @media (max-width: 1000px) { .quad { margin: 0 auto; } }
  @media (max-width: 480px) { .quad-tile { padding: 12px; border-radius: 14px; } .quad-tile b { font-size: 0.85rem; } .quad-tile i { font-size: 11px; } .quad-tile em { display: none; } }

  /* stats band */
  .stats-band { padding: 48px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: linear-gradient(90deg, transparent, rgba(91,141,239,0.06), transparent); }
  .stats-inner { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat-cell { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; border-right: 1px solid var(--line); padding: 0 12px; }
  .stat-cell:last-child { border-right: none; }
  .stat-value { font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(90deg, var(--acc), var(--c1) 60%, var(--c2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stat-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }

  /* model hub */
  .model-hub { display: flex; flex-direction: column; align-items: center; gap: 14px; margin: 44px 0 36px; }
  .hub-logo-link { display: inline-flex; transition: transform 0.2s var(--ease); }
  .hub-logo-link:hover { transform: translateY(-3px); }
  .hub-logo { width: 100%; max-width: 220px; height: auto; object-fit: contain; filter: drop-shadow(0 0 30px rgba(48, 226, 244, 0.14)); }
  .hub-hint { font-size: 13px; color: var(--faint); }

  /* model tiles */
  .model-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; max-width: 720px; margin: 0 auto; }
  .model-tile {
    position: relative;
    text-align: left;
    padding: 20px 22px;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    background: color-mix(in srgb, var(--tile-color) 24%, var(--panel));
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s;
    font-family: var(--font-body);
    color: var(--ink);
  }
  .model-tile::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--tile-color) 45%, transparent);
    pointer-events: none;
  }
  .model-tile:hover { transform: translateY(-3px); }
  .model-tile.is-active { background: color-mix(in srgb, var(--tile-color) 42%, var(--panel)); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35); }
  .model-tile-tag { display: block; font-weight: 700; font-size: 0.98rem; margin-bottom: 4px; }
  .model-tile-sub { display: block; font-size: 12.5px; color: rgba(255, 255, 255, 0.72); }

  /* model detail panel */
  .model-detail { margin-top: 32px; padding: clamp(24px, 4vw, 36px); background: radial-gradient(60% 90% at 100% 0%, rgba(91,141,239,0.1), transparent 70%), var(--panel); border: 1px solid var(--line-strong); border-radius: 22px; animation: modelDetailIn 0.3s var(--ease) both; }
  .model-detail[hidden] { display: none; }
  @keyframes modelDetailIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .model-detail-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 24px; }
  .model-detail-eyebrow { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--acc); display: block; margin-bottom: 6px; }
  .model-detail-head h3 { margin: 0 0 8px; }
  .model-detail-head p { font-size: 0.94rem; color: var(--mute); max-width: 560px; margin: 0; }
  .model-detail-marker { font-size: 11.5px; color: var(--green); margin-top: 10px; font-weight: 500; }
  .model-detail-close { background: none; border: 1px solid var(--line); border-radius: 8px; color: var(--faint); font-size: 18px; line-height: 1; padding: 6px 11px; cursor: pointer; flex-shrink: 0; transition: border-color 0.15s, color 0.15s; }
  .model-detail-close:hover { border-color: var(--line-strong); color: var(--ink); }
  /* .model-cap-card and everything beneath it is injected client-side by the
     script below, so it never receives Astro's scoping attribute — these
     rules must be :global() or they silently never match. */
  .model-cap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  :global(.model-cap-card) { padding: 18px 20px; border: 1px solid var(--line); border-radius: 10px; transition: background 0.18s, border-color 0.18s; }
  :global(.model-cap-card:hover), :global(.model-cap-card.open) { background: var(--panel-hover); border-color: var(--line-strong); }
  :global(.model-cap-card h4) { font-size: 13.5px; font-weight: 700; color: var(--ink); margin: 0 0 6px; }
  :global(.model-cap-card p) { font-size: 12.5px; color: var(--mute); margin: 0 0 10px; line-height: 1.5; }
  :global(.model-cap-toggle) { font-size: 11px; color: var(--faint); font-weight: 600; letter-spacing: 0.04em; cursor: pointer; }
  :global(.model-cap-card.open .model-cap-toggle) { color: var(--cyan); }
  :global(.model-svc-chips) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  :global(.model-svc-chips[hidden]) { display: none; }
  :global(.model-svc-chip) { font-size: 11px; color: var(--mute); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 4px 9px; }

  /* bridge */
  .bridge-box { position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding: clamp(28px, 5vw, 48px); border-radius: 28px; border: 1px solid rgba(47,232,138,0.4); background: radial-gradient(50% 100% at 0% 0%, rgba(47,232,138,0.14), transparent 70%), radial-gradient(40% 90% at 100% 100%, rgba(48,226,244,0.10), transparent 70%), var(--panel); }
  .bridge-box .fp-eb { color: #2fe88a; display: inline-flex; align-items: center; gap: 10px; }
  .bridge-ic { width: 20px; height: 20px; }
  .bridge-body h3 { margin: 6px 0 14px; font: 800 clamp(1.4rem, 2.6vw, 2rem)/1.2 var(--font-display); letter-spacing: -0.02em; }
  .bridge-body p { color: var(--mute); }
  .bridge-body p { font-size: 0.96rem; }
  .bridge-body p + p { margin-top: 10px; }
  .bridge-ctas { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }

  /* pillars */
  .pillar { position: relative; overflow: hidden; border-radius: 20px; }
  .pillar::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--acc), var(--c2), transparent); }
  .pillar-n { position: absolute; right: 20px; top: 16px; font: 800 2.4rem/1 var(--font-display); color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--acc) 60%, transparent); }
  .pillar-icon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px; font-size: 1.4rem; margin-bottom: 18px; color: var(--acc); background: color-mix(in srgb, var(--acc) 12%, transparent); border: 1px solid color-mix(in srgb, var(--acc) 40%, transparent); }
  .delivery-card { position: relative; overflow: hidden; border-radius: 22px; }
  .dc-pro { --dc: #5b8def; } .dc-man { --dc: #a78bfa; }
  .delivery-card { background: radial-gradient(70% 70% at 100% 0%, color-mix(in srgb, var(--dc) 13%, transparent), transparent 70%), var(--panel); border-color: color-mix(in srgb, var(--dc) 35%, transparent); }
  .delivery-card h3 { color: var(--dc); }

  /* delivery */
  .delivery-card p { margin: 8px 0 0; }
  .delivery-list { list-style: none; margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .delivery-list li { font-size: 13px; color: var(--mute); display: flex; align-items: center; gap: 9px; }
  .delivery-list li::before { content: '→'; color: var(--dc); font-size: 12px; flex-shrink: 0; }

  .contact-line { font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-top: 22px; }

  @media (max-width: 900px) {
    .bridge-box { grid-template-columns: 1fr; }
    .bridge-ctas { flex-direction: row; flex-wrap: wrap; }
  }
  @media (max-width: 600px) {
    .stats-inner { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(3), .stat-cell:nth-child(4) { border-top: 1px solid var(--line); padding-top: 16px; }
  }
  @media (max-width: 560px) {
    .model-grid { grid-template-columns: 1fr; max-width: 420px; }
    .model-cap-grid { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ DIVISIONS: divisions }}>
  (function () {
    const panel = document.getElementById('modelDetailPanel');
    const hint = document.getElementById('hubHint');
    const tiles = document.querySelectorAll('.model-tile');
    const DEFAULT_HINT = 'Select a division to explore its capabilities.';
    let activeKey = null;

    function renderCaps(caps) {
      const grid = document.getElementById('modelCapGrid');
      grid.innerHTML = '';
      caps.forEach((cap) => {
        const card = document.createElement('div');
        card.className = 'model-cap-card';
        const hasSvcs = Array.isArray(cap.svcs) && cap.svcs.length > 0;
        const chips = hasSvcs ? cap.svcs.map((s) => `<span class="model-svc-chip">${s}</span>`).join('') : '';
        card.innerHTML =
          `<h4>${cap.name}</h4><p>${cap.desc}</p>` +
          (hasSvcs ? `<span class="model-cap-toggle">View services &rarr;</span><div class="model-svc-chips" hidden>${chips}</div>` : '');
        const toggle = card.querySelector('.model-cap-toggle');
        if (toggle) {
          toggle.addEventListener('click', () => {
            const open = card.classList.toggle('open');
            const chipsDiv = card.querySelector('.model-svc-chips');
            chipsDiv.hidden = !open;
            toggle.innerHTML = open ? 'Hide services &uarr;' : 'View services &rarr;';
          });
        }
        grid.appendChild(card);
      });
    }

    function closeDetail() {
      activeKey = null;
      panel.hidden = true;
      tiles.forEach((t) => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      hint.textContent = DEFAULT_HINT;
    }

    function selectDivision(key) {
      const d = DIVISIONS.find((x) => x.key === key);
      if (!d) return;
      activeKey = key;
      tiles.forEach((t) => {
        const isActive = t.dataset.div === key;
        t.classList.toggle('is-active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      document.getElementById('modelDetailEyebrow').textContent = d.tagline;
      document.getElementById('modelDetailTitle').textContent = d.tag;
      document.getElementById('modelDetailDesc').textContent = d.desc;
      document.getElementById('modelDetailMarker').textContent = d.marker || '';
      renderCaps(d.caps);
      panel.hidden = false;
      hint.textContent = `Exploring ${d.tag}.`;
      setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
    }

    tiles.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (activeKey === btn.dataset.div) { closeDetail(); return; }
        selectDivision(btn.dataset.div);
      });
    });

    document.getElementById('modelDetailClose').addEventListener('click', closeDetail);
  }());
</script>
