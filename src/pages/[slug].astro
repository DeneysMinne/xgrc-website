---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { solutions, solutionDetails, brand, testimonials, tourDashboards } from '../data/site.js';
import TourStrip from '../components/TourStrip.astro';
import FeatureReveal from '../components/FeatureReveal.astro';
import SolutionVisual from '../components/SolutionVisual.astro';
import '../styles/feature.css';
import { lookFor, solutionIcon } from '../data/solutionLooks.js';
import { whatsNew } from '../data/whatsNew.js';
import { useCaseRegistry } from '../data/useCaseRegistry.js';
import { publishedComparisons } from '../data/comparisons.js';

export function getStaticPaths() {
  return Object.keys(solutionDetails).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const detail   = solutionDetails[slug];
const solution = solutions.find((s) => s.slug === slug);
if (!detail || !solution) return Astro.redirect('/solutions/');

const ogCandidate = path.join(process.cwd(), 'public', 'assets', 'og', `og-${slug}.jpg`);
const ogImage = fs.existsSync(ogCandidate) ? `/assets/og/og-${slug}.jpg` : '/assets/og-default.jpg';

const recentUpdates = (whatsNew[slug] || []).slice(0, 3);
const useCases = useCaseRegistry.filter((u) => u.relatedSolution === slug);
const compareLinks = publishedComparisons.filter((c) => c.linkFrom.includes(slug));

// Live demonstration dashboards for this solution (public/tour/).
const liveDashboards = tourDashboards.filter((d) => d.solution === slug);

const related = detail.related
  .map((r) => solutions.find((s) => s.slug === r))
  .filter(Boolean);

// One real, attributed quote per featured customer (first match, no duplicates).
const featuredTestimonials = (detail.testimonialCompanies || [])
  .map((c) => testimonials.find((t) => t.company === c))
  .filter(Boolean);

// Page accent and per-card icons (src/data/solutionLooks.js).
const acc = lookFor(slug).acc;
const pad = (i) => String(i + 1).padStart(2, '0');

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: `XGRC® ${detail.name}`,
      applicationCategory: 'BusinessApplication',
      description: detail.lede,
      operatingSystem: 'Web',
      provider: { '@type': 'Organization', name: 'XGRC® Software', url: 'https://xgrcsoftware.com' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',      item: 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://xgrcsoftware.com/solutions/' },
        { '@type': 'ListItem', position: 3, name: detail.name },
      ],
    },
    ...(detail.geo?.faqs ? [{
      '@type': 'FAQPage',
      mainEntity: detail.geo.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }] : []),
  ],
});
---

<Base
  title={detail.metaTitle || `${detail.name}: ${detail.tag} | XGRC®`}
  description={detail.metaDescription || detail.lede}
  ogImage={ogImage}
  mdPath={`/${slug}.md`}
>
  <script type="application/ld+json" set:html={schema} />

  <div class="fp sol" style={`--acc: ${acc}`}>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="sol-hero">
    <div class="sol-hero-glow" aria-hidden="true"></div>
    <div class={`container sol-hero-inner ${!detail.screenshot ? 'sol-hero-inner--solo' : ''}`}>

      <!-- Left: copy -->
      <div class="sol-hero-copy">
        <div class="breadcrumb">
          <a href="/solutions/">Solutions</a>
          <span aria-hidden="true">/</span>
          <span>{detail.name}</span>
        </div>
        {detail.icon && (
          <img src={detail.icon} alt={`${detail.name} icon`} aria-hidden="true" class="sol-product-icon" loading="eager" />
        )}
        {detail.poweredBy && (
          <div class="powered-by-badge"><span class="dot"></span>Powered by {detail.poweredBy}</div>
        )}
        <h1>{detail.h1 || detail.name}</h1>
        <p class="sol-headline">{detail.headline}</p>
        <p class="lede sol-lede">{detail.lede}</p>
        <div class="sol-actions">
          <a href="/demo/" class="btn btn-primary">Request a demo</a>
          {detail.freeLink && (
            <a href={detail.freeLink.href} class="btn btn-ghost">{detail.freeLink.label}</a>
          )}
          <a href="/solutions/" class="btn btn-ghost">All solutions &rarr;</a>
        </div>
        {detail.loginLink && (
          <p class="sol-login"><a href={detail.loginLink.href} class="link-arrow">{detail.loginLink.label} &rarr;</a> <span>(same login as XGRC®)</span></p>
        )}
        {(detail.booklet || detail.infographic) && (
          <p class="sol-downloads">
            <span class="dl-label">Download:</span>
            {detail.booklet && (
              <a href={detail.booklet} target="_blank" rel="noopener" download>Brochure (PDF)</a>
            )}
            {detail.infographic && (
              <a href={detail.infographic} target="_blank" rel="noopener" download>Infographic (PDF)</a>
            )}
          </p>
        )}
        <div class="sol-standards-strip">
          {detail.standards.map((s) => (
            <span class="std-badge">{s}</span>
          ))}
        </div>
      </div>

      <!-- Right: dashboard -->
      {detail.screenshot && (
        <div class="sol-dash-col">
          <div class="sol-dash-frame">
            <div class="sol-dash-chrome">
              <span class="dc-dot dc-red"></span>
              <span class="dc-dot dc-yellow"></span>
              <span class="dc-dot dc-green"></span>
              <span class="dc-url">{detail.appUrl || 'v5.xgrc.cloud'} · {detail.name}</span>
            </div>
            <div class="sol-dash-screen">
              <img src={detail.screenshot} alt={`${detail.name} dashboard`} loading="eager" />
            </div>
          </div>
          {detail.stats.slice(0, 2).map((st, i) => (
            <div class={`dash-float df${i}`} aria-hidden="true">
              <span class="df-val">{st.value}</span>
              <span class="df-lbl">{st.label}</span>
            </div>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- ── Definition / usage context (GEO) ────────────────── -->
  {detail.geo && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="geo-block rv">
          <h2>What is {detail.name}?</h2>
          <p class="lede">{detail.geo.definition}</p>
          <p class="lede">{detail.geo.usage}</p>
          {detail.regionalLink && (
            <p class="lede"><a href={detail.regionalLink.href} class="link-arrow">{detail.regionalLink.label} &rarr;</a></p>
          )}
          {detail.learnLink && (
            <p class="lede"><a href={detail.learnLink.href} class="link-arrow">{detail.learnLink.label} &rarr;</a></p>
          )}
          {compareLinks.map((c) => (
            <p class="lede"><a href={`/compare/${c.slug}/`} class="link-arrow">Compare XGRC® vs {c.competitor} &rarr;</a></p>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── The challenge ─────────────────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
          <span class="fp-eb">The challenge</span>
          <h2 class="fp-h2">What breaks without {detail.name}.</h2>
      </div>
      <div class="challenge-grid">
        {detail.challenges.map((c, i) => (
          <div class="challenge-card rv">
            <span class="challenge-icon" aria-hidden="true">×</span><span class="challenge-n" aria-hidden="true">{pad(i)}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Solution overview ─────────────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="overview-split">
        <div class="overview-copy rv">
          <span class="fp-eb">What it does</span>
          <h2 class="fp-h2">How {detail.name} works.</h2>
          <p class="lede">{detail.overview}</p>
          <a href="/demo/" class="link-arrow">See it in action &rarr;</a>
        </div>
        <div class="overview-visual rv">
          <SolutionVisual slug={slug} standards={detail.standards} groups={detail.moduleGroups.map((g) => g.category)} icon={detail.icon || solutionIcon(slug)} />
        </div>
        <div class="overview-stats">
          {detail.stats.map((s) => (
            <div class="stat-block rv">
              <span class="stat-val">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Product tour (real screenshots) ───────────────── -->
  {detail.productShots && detail.productShots.length > 0 && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">Product tour</span>
          <h2 class="fp-h2">{detail.name}, screen by screen.</h2>
        </div>
        <div class="tour-list">
          {detail.productShots.map((shot) => (
            <div class="tour-item rv">
              <div class="tour-copy">
                <h3>{shot.title}</h3>
                <p>{shot.body}</p>
              </div>
              <div class="tour-shot-frame">
                <div class="sol-dash-chrome">
                  <span class="dc-dot dc-red"></span>
                  <span class="dc-dot dc-yellow"></span>
                  <span class="dc-dot dc-green"></span>
                  <span class="dc-url">{detail.appUrl || 'v5.xgrc.cloud'} · {shot.title}</span>
                </div>
                <div class="sol-dash-screen">
                  <img src={shot.image} alt={shot.title} loading="lazy" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── See it in action (video) ────────────────────── -->
  {(detail.youtubeId || detail.video) && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">See it in action</span>
          <h2 class="fp-h2">{detail.name} in practice.</h2>
        </div>
        <div class="sol-video-wrap">
          {detail.youtubeId ? (
            <div class="yt-wrap">
              <button
                class="yt-facade"
                data-ytid={detail.youtubeId}
                type="button"
                aria-label={`Play the ${detail.name} product overview video`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${detail.youtubeId}/maxresdefault.jpg`}
                  onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')"
                  alt={`${detail.name} product overview`}
                  loading="lazy"
                />
                <span class="yt-play" aria-hidden="true"></span>
              </button>
            </div>
          ) : (
            <video
              src={detail.video}
              controls
              playsinline
              preload="none"
              class="sol-video"
              aria-label={`${detail.name} product overview video`}
            />
          )}
        </div>
      </div>
    </section>
  )}

  <TourStrip
    items={liveDashboards}
    heading={`See ${detail.name} running.`}
    lede="An interactive demonstration dashboard with fictitious data. Filter it, open any KPI to see how it is calculated, and export a board pack."
  />

  <!-- ── Modules / What's inside ───────────────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="fp-head rv">
          <span class="fp-eb">What's included</span>
          <h2 class="fp-h2">Everything in {detail.name}.</h2>
        <p class="lede">Core capabilities are configured to your requirements, with the flexibility to expand as your needs grow.</p>
      </div>
      <div class="module-groups">
        {detail.moduleGroups.map((group) => (
          <div class="module-group rv">
            <h3 class="group-label"><span class="gl-n" aria-hidden="true">{String(group.modules.length).padStart(2, '0')}</span>{group.category}</h3>
            <div class="module-chips">
              {group.modules.map((m) => (
                <span class="module-chip">{m}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Recent updates (What's New teaser) ──────────────── -->
  {recentUpdates.length > 0 && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">Recent updates</span>
          <h2 class="fp-h2">{detail.name} keeps shipping.</h2>
        </div>
        <div class="whatsnew-teaser-list">
          {recentUpdates.map((u) => (
            <div class="whatsnew-teaser-item">
              {u.version !== u.date && <span class="whatsnew-teaser-version">v{u.version}</span>}
              <h3 class="whatsnew-teaser-title">{u.title}</h3>
              <p class="whatsnew-teaser-desc">{u.description}</p>
            </div>
          ))}
        </div>
        <a href={`/whats-new/${slug}/`} class="link-arrow">See all updates &rarr;</a>
      </div>
    </section>
  )}

  <!-- ── Extra topic sections (optional, data-driven; SEO Fix Spec T10) ── -->
  {(detail.sections || []).map((sec) => (
    <section class="fp-sec tight" id={sec.id}>
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">{sec.eyebrow}</span>
          <h2 class="fp-h2">{sec.heading}</h2>
          {(sec.body || []).map((para) => <p class="lede">{para}</p>)}
        </div>
        {sec.items && (
          <div class="grid cols-3">
            {sec.items.map((it) => (
              <div class="topic-card rv">
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </div>
            ))}
          </div>
        )}
        {sec.table && (
          <div class="topic-table" role="table" aria-label={sec.heading}>
            <div class="topic-row topic-row--head" role="row">
              {sec.table.head.map((h) => <span role="columnheader">{h}</span>)}
            </div>
            {sec.table.rows.map((r) => (
              <div class="topic-row" role="row">{r.map((c) => <span role="cell">{c}</span>)}</div>
            ))}
          </div>
        )}
        {sec.links && (
          <p class="topic-links">{sec.links.map((l) => <a href={l.href} class="link-arrow">{l.label} &rarr;</a>)}</p>
        )}
      </div>
    </section>
  ))}

  <!-- ── Customer outcome (optional) ──────────────────────── -->
  {detail.outcome && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="outcome-card rv">
          <span class="fp-eb">Customer outcome</span>
          <p class="outcome-figure">{detail.outcome.figure}</p>
          <p class="outcome-label">{detail.outcome.label}</p>
          <p class="lede">{detail.outcome.body}</p>
          {detail.outcome.pdf && (
            <a href={detail.outcome.pdf} class="link-arrow" download>Download the {detail.outcome.company} case study (PDF) &rarr;</a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ── Related use cases ─────────────────────────────── -->
  {useCases.length > 0 && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">Related use cases</span>
          <h2 class="fp-h2">What teams use {detail.name} for.</h2>
          <p class="lede">Each use case explains the problem, the standards and regulations involved, and how {detail.name} handles it in practice.</p>
        </div>
        <div class="fp-cards">
          {useCases.map((u) => (
            <a class="fp-card rv" href={`/use-cases/${u.slug}/`}>
              <span class="fp-card-top"><span class="fp-tag">{u.category}</span></span>
              <h3>{u.crumbLabel}</h3>
              <p>{u.lede}</p>
              <span class="fp-go">View use case &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Platform integration ──────────────────────────── -->
  {related.length > 0 && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">Better together</span>
          <h2 class="fp-h2">{detail.name} is stronger on the platform.</h2>
          <p class="lede">Every XGRC® solution shares the same data foundation. When {detail.name} is combined with other solutions, risk, compliance, assurance, and governance data flows without duplication.</p>
        </div>
        <div class="fp-cards">
          {related.map((r) => (
            <a class="fp-card rv" href={`/${r.slug}/`} style={`--racc: ${lookFor(r.slug).acc}`}>
              <span class="fp-card-top">
                {solutionIcon(r.slug) ? <img src={solutionIcon(r.slug)} alt="" width="34" height="34" loading="lazy" /> : <span class="fp-mono" aria-hidden="true">{r.name.slice(0, 2)}</span>}
                <span class="fp-tag">{r.tag}</span>
              </span>
              <h3>{r.name}</h3>
              <p>{r.blurb}</p>
              <span class="fp-go">Explore &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── What it's not / FAQs (GEO) ──────────────────────── -->
  {detail.geo && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="notthis-faq-grid">
          <div class="notthis-block rv">
            <span class="fp-eb">Set the record straight</span>
            <h2 class="fp-h2">What {detail.name} is not.</h2>
            <p class="lede">{detail.geo.notThis}</p>
          </div>
          <div class="faq-block">
            <span class="fp-eb">Frequently asked</span>
            <h2 class="fp-h2">Common questions.</h2>
            <div class="fp-faqs">
              {detail.geo.faqs.map((f, i) => (
                <details class="fp-faq rv">
                  <summary><span class="fp-fq-n">{pad(i)}</span><span class="fp-fq-q">{f.q}</span><span class="fp-fq-ic" aria-hidden="true"></span></summary>
                  <p>{f.a}</p>
                  {f.link && <p><a href={f.link.href} class="link-arrow">{f.link.label} &rarr;</a></p>}
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Trust bar (platform-wide, factual) ──────────────── -->
  <section class="fp-sec tight">
    <div class="container">
      <div class="trust-bar rv">
        <div class="trust-item">
          <span class="trust-val">ISO 27001:2022</span>
          <span class="trust-lbl">Platform certified by BSI</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-val">{detail.standards.join(' · ')}</span>
          <span class="trust-lbl">Aligned frameworks</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-val">Audit-ready</span>
          <span class="trust-lbl">Every record traceable</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Customer proof (real, attributed testimonials) ──── -->
  {featuredTestimonials.length > 0 && (
    <section class="fp-sec tight">
      <div class="container">
        <div class="fp-head rv">
          <span class="fp-eb">Proven in the field</span>
          <h2 class="fp-h2">What {detail.name} customers say.</h2>
        </div>
        <div class="sol-testimonials">
          {featuredTestimonials.map((t) => (
            <figure class="testimonial-card rv">
              <blockquote class="t-quote">"{t.quote}"</blockquote>
              {t.outcome && <p class="t-outcome">{t.outcome}</p>}
              <figcaption class="t-attribution">
                <span class="t-name">{t.name}</span>
                <span class="t-role">{t.role}, {t.company}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA ───────────────────────────────────────────── -->
  <section class="fp-sec">
    <div class="container">
      <div class="fp-cta cta-block rv">
        <div class="cta-tag"><span class="dot"></span>{detail.tag}</div>
        <h2>{detail.ctaHeadline || `See ${detail.name} running in your environment.`}</h2>
        <p class="lede">{detail.ctaBody || `Talk to an XGRC® specialist about how ${detail.name} fits your organisation's specific compliance and governance requirements.`}</p>
        <div class="cta-actions">
          <a href="/demo/" class="btn btn-primary">Request a live demo</a>
          <a href="/use-cases/" class="btn btn-ghost">See use cases</a>
        </div>
        <p class="contact-line">{brand.email} &middot; {brand.phone}</p>
      </div>
    </div>
  </section>
  </div>
</Base>
<FeatureReveal />

<style>
  /* Solution pages: feature-standard layout. Shared blocks live in src/styles/feature.css;
     the page accent (--acc) comes from src/data/solutionLooks.js. */
  .sol-login { margin: -4px 0 18px; font-size: 0.95rem; }
  .sol-login a { color: var(--acc); }
  .sol-login span { color: var(--faint); font-size: 0.85rem; }

  /* ── Hero ───────────────────────────────────────────── */
  .sol-hero { padding: clamp(28px, 5vw, 64px) 0 clamp(48px, 6vw, 84px); position: relative; isolation: isolate; }
  .sol-hero-glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(42% 55% at 78% 45%, color-mix(in srgb, var(--acc) 22%, transparent), transparent 70%),
      radial-gradient(35% 45% at 95% 85%, rgba(167, 139, 250, 0.10), transparent 70%),
      radial-gradient(40% 50% at 8% 8%, rgba(48, 226, 244, 0.08), transparent 70%),
      linear-gradient(rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px;
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .sol-hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .sol-hero-inner--solo { grid-template-columns: 1fr; max-width: 820px; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-bottom: 22px; }
  .breadcrumb a { color: var(--mute); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--acc); }
  .breadcrumb span:last-child { color: var(--acc); border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent); background: color-mix(in srgb, var(--acc) 9%, transparent); padding: 2px 10px; border-radius: 99px; }
  .sol-product-icon { height: 96px; width: auto; object-fit: contain; display: block; margin-bottom: 14px; filter: drop-shadow(0 0 24px color-mix(in srgb, var(--acc) 50%, transparent)); animation: iconIn 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes iconIn { from { opacity: 0; transform: scale(0.85) rotate(-6deg); } }
