<script>
  // Load the real YouTube player only when the facade is clicked.
  document.querySelectorAll('.yt-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-ytid');
      const ifr = document.createElement('iframe');
      ifr.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      ifr.title = 'Product overview video';
      ifr.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      ifr.allowFullscreen = true;
      ifr.setAttribute('style', 'position:absolute;inset:0;width:100%;height:100%;border:0;');
      btn.replaceWith(ifr);
    });
  });
</script>
