---
import Base from '../layouts/Base.astro';
import { customerGroups, caseStudies } from '../data/site.js';
import { useCaseRegistry, useCaseCategories } from '../data/useCaseRegistry.js';
---
<Base title="Use Cases | XGRC® Software" description="How organisations across mining, manufacturing, logistics and more use XGRC to drive compliance.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>Use Cases</span>
      <h1>Real governance, risk and compliance challenges — solved.</h1>
      <p class="lede">From mining and steel to food, logistics and finance, organisations use XGRC® to unify oversight and drive compliance across their operations.</p>
    </div>
  </section>
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>By discipline</span>
        <h2>Explore how XGRC® is used in practice.</h2>
        <p class="lede">Structured, solution-focused guides showing how XGRC® addresses a specific discipline, from planning through to assurance.</p>
      </div>
      <div class="filters" role="group" aria-label="Filter by category">
        <button class="filter-chip is-active" data-filter="All" type="button">All</button>
        {useCaseCategories.map((c) => (
          <button class="filter-chip" data-filter={c} type="button">{c}</button>
        ))}
      </div>
      <div class="grid cols-3" data-uc-grid>
        {useCaseRegistry.map((u) => (
          <a class="card uc-card" data-category={u.category} href={`/use-cases/${u.slug}/`}>
            <span class="tag">{u.category}</span>
            <h3>{u.crumbLabel}</h3>
            <p>{u.lede}</p>
            <span class="link-arrow">View use case &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Featured case studies</span>
        <h2>Outcomes, not just software.</h2>
      </div>
      <div class="grid cols-2">
        {caseStudies.map((c) => (
          <div class={`card${c.pdf ? ' cs-card' : ''}`}>
            <span class="tag">{c.solution}</span>
            <h3>{c.company}</h3>
            <p>{c.summary}</p>
            {c.pdf && (
              <a href={`/case-studies/${c.slug}.pdf`} class="link-arrow" download>Download case study &rarr;</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="dot"></span>Customers by industry</span>
        <h2>A platform proven across sectors.</h2>
      </div>
      <div class="sectors">
        {customerGroups.map((g) => (
          <div class="sector">
            <h3>{g.sector}</h3>
            <div class="chips">
              {g.customers.map((c) => (<span class="chip">{c.name}</span>))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<script>
  const grid = document.querySelector('[data-uc-grid]');
  const chips = document.querySelectorAll('.filter-chip');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    const filter = chip.dataset.filter;
    grid.querySelectorAll('[data-category]').forEach((card) => {
      card.style.display = filter === 'All' || card.dataset.category === filter ? '' : 'none';
    });
  }));
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .filter-chip { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--mute); border: 1px solid var(--line); border-radius: 100px; padding: 9px 16px; background: transparent; cursor: pointer; transition: 0.2s; }
  .filter-chip:hover { color: var(--ink); border-color: var(--line-strong); }
  .filter-chip.is-active { color: var(--cyan); border-color: var(--line-strong); background: rgba(48,226,244,0.06); }
  .page-head { padding: 130px 0 0; }
  .page-head h1 { margin: 8px 0 18px; }
  .uc-card { text-decoration: none; display: flex; flex-direction: column; }
  .uc-card .link-arrow { margin-top: auto; padding-top: 16px; }
  .cs-card { display: flex; flex-direction: column; }
  .cs-card .link-arrow { margin-top: auto; padding-top: 16px; }
  .sectors { display: flex; flex-direction: column; gap: 28px; }
  .sector { border-top: 1px solid var(--line); padding-top: 22px; }
  .sector h3 { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan); margin-bottom: 14px; font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { font-size: 13px; color: var(--mute); border: 1px solid var(--line); border-radius: 100px; padding: 8px 15px; background: var(--panel); transition: 0.25s; }
  .chip:hover { color: var(--ink); border-color: var(--line-strong); transform: translateY(-2px); }
</style>
