---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { brand, socialLinks } from '../data/site.js';

const {
  title = 'XGRC® Software',
  description = 'Synergy in Assurance, Strength in Compliance. A connected governance, risk and compliance platform.',
  noindex = false,
  ogImage = '/assets/og-default.jpg',
  mdPath = null, // when set (e.g. '/sheqx.md'), advertise a Markdown twin for LLMs
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const siteURL = Astro.site.toString().replace(/\/$/, '');
const mdURL = mdPath ? new URL(mdPath, Astro.site).toString() : null;

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteURL}/#organization`,
      name: 'XGRC® Software',
      url: siteURL,
      logo: `${siteURL}/assets/logos/brand/xgrc-icon-white.png`,
      description: 'XGRC® Software is a global governance, risk and compliance platform with specialist solutions that operate on one secure, auditable data foundation.',
      foundingDate: '2015',
      email: brand.email,
      telephone: brand.phone,
      sameAs: [...socialLinks.map((s) => s.url), 'https://www.strategix.co.za'],
      parentOrganization: { '@type': 'Organization', name: 'Strategix Group', url: 'https://www.strategix.co.za' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}/#website`,
      url: siteURL,
      name: 'XGRC® Software',
      publisher: { '@id': `${siteURL}/#organization` },
    },
  ],
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    {mdURL && <link rel="alternate" type="text/markdown" href={mdURL} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script type="application/ld+json" set:html={orgSchema} />

    <!-- Google Analytics (GA4) + Google Ads conversion tracking — only fires on the
         real production domain, so staging traffic and local testing never pollute
         production data or ad conversion counts.

         GA4 ID was replaced 2026-08-07: the original (G-XKBDKND5LZ) turned out to be
         one of two destinations silently fanned out from a shared "Google tag"
         (GT-NF7MFM6V) that never finished initializing for EITHER destination —
         confirmed via a clean headless-browser test with zero cookies/extensions.
         G-VLKD6CDZND is a fresh, standalone property not linked into that shared tag.
         Also loading GA4 and Ads as two INDEPENDENT Google tags (separate script tags,
         separate config calls) rather than one riding on the other's loader, so a
         problem with one destination's container can't stall the other. -->
    <script>
      const GA_MEASUREMENT_ID = 'G-VLKD6CDZND';
      const ADS_CONVERSION_ID = 'AW-744549022';
      const PRODUCTION_HOSTNAMES = ['xgrcsoftware.com', 'www.xgrcsoftware.com'];
      if (PRODUCTION_HOSTNAMES.includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        function gtag(...args) { window.dataLayer.push(args); }
        window.gtag = gtag;
        // No cookie-consent banner on this site yet, so grant default consent
        // explicitly — otherwise gtag.js silently withholds every hit pending
        // a consent signal that never arrives, and nothing ever reaches GA4/Ads.
        gtag('consent', 'default', {
          ad_storage: 'granted',
          analytics_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
        gtag('js', new Date());

        for (const id of [GA_MEASUREMENT_ID, ADS_CONVERSION_ID]) {
          const tag = document.createElement('script');
          tag.async = true;
          tag.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
          document.head.appendChild(tag);
          gtag('config', id);
        }
      }
    </script>

    <!-- Capture the gclid from a paid-search landing click into a first-party
         cookie, entirely independent of the gtag block above. This is what
         lets the demo/book-a-meeting forms report a real Google Ads
         conversion server-side (form-handler/app.py) even while gtag.js
         itself is silently dropping every browser hit. Runs on every host,
         not just production — harmless either way. 90-day window: a real
         ad-click-to-lead gap can outlast the shorter _ga cookie window. -->
    <script>
      const gclid = new URLSearchParams(window.location.search).get('gclid');
      if (gclid) {
        document.cookie = `xgrc_gclid=${encodeURIComponent(gclid)}; Max-Age=7776000; Path=/; SameSite=Lax`;
      }
    </script>

    <!-- Same first-party-cookie capture, for utm_source/utm_medium/utm_campaign --
         found missing during XRM ENH-132's Phase 0 validation (2026-08-20): the
         gclid path above was built for Google Ads' own server-side conversion
         call, but XRM's Revenue Copilot attribution model reads all three of
         these fields too (a lead with no gclid, e.g. from LinkedIn or a UTM-
         tagged newsletter link, would otherwise have zero attribution data).
         Only set when actually present on the landing URL, so a plain organic
         visit never overwrites a real value with an empty one. -->
    <script>
      const _p = new URLSearchParams(window.location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign']) {
        const value = _p.get(key);
        if (value) {
          document.cookie = `xgrc_${key}=${encodeURIComponent(value)}; Max-Age=7776000; Path=/; SameSite=Lax`;
        }
      }
    </script>
    <!-- A full-page load to a URL with a #hash (e.g. a resource card linking
         to /use-cases/x/#resource) fights with `scroll-behavior: smooth`
         (global.css): the browser's native scroll-to-fragment animates while
         fonts/images below the target are still loading and shifting page
         height mid-scroll, which can overshoot well past the target — as far
         as the bottom of the page on a long one. Disable smooth scrolling for
         that initial jump, then land on the target for real once everything
         has settled; re-enable smooth scrolling for subsequent in-page clicks. -->
    <script>
      if (location.hash) {
        document.documentElement.classList.add('no-smooth-scroll');
        window.addEventListener('load', () => {
          document.getElementById(location.hash.slice(1))?.scrollIntoView({ block: 'start' });
          document.documentElement.classList.remove('no-smooth-scroll');
        });
      }
    </script>
  </head>
  <body>
    {mdURL && (
      <div class="visually-hidden" aria-hidden="true">
        A Markdown version of this page is available at {mdURL}.
      </div>
    )}
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
