---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { brand, socialLinks } from '../data/site.js';

const {
  title = 'XGRC® Software',
  description = 'Synergy in Assurance, Strength in Compliance. A connected governance, risk and compliance platform.',
  noindex = false,
  canonical = true, // false on pages with no URL of their own (the 404 page)
  ogImage = '/assets/og-default.jpg',
  mdPath = null, // when set (e.g. '/sheqx.md'), advertise a Markdown twin for LLMs
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const siteURL = Astro.site.toString().replace(/\/$/, '');
const mdURL = mdPath ? new URL(mdPath, Astro.site).toString() : null;

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteURL}/#organization`,
      name: 'XGRC® Software',
      url: siteURL,
      logo: `${siteURL}/assets/logos/brand/xgrc-icon-white.png`,
      description: 'XGRC® Software is a global governance, risk and compliance platform with specialist solutions that operate on one secure, auditable data foundation.',
      foundingDate: '2015',
      email: brand.email,
      telephone: brand.phone,
      sameAs: [...socialLinks.map((s) => s.url), 'https://www.strategix.co.za'],
      parentOrganization: { '@type': 'Organization', name: 'Strategix Group', url: 'https://www.strategix.co.za' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}/#website`,
      url: siteURL,
      name: 'XGRC® Software',
      publisher: { '@id': `${siteURL}/#organization` },
    },
  ],
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonicalURL} />}
    {mdURL && <link rel="alternate" type="text/markdown" href={mdURL} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script type="application/ld+json" set:html={orgSchema} />

    <!-- Google Analytics (GA4) + Google Ads conversion tracking, gated to the
         real production domain so staging/local traffic never pollutes
         production data or ad conversion counts. See git history for the
         incident notes behind this setup, not repeated here deliberately:
         Google's site tag detection appears to scan raw page source rather
         than executed JavaScript, so a prior version of this comment that
         spelled out old, retired measurement/tag IDs as plain text was
         still being reported by Google as "the tag installed on this site"
         weeks after those IDs were replaced in the actual running code. -->
    <script>
      const GA_MEASUREMENT_ID = 'G-E8SHSDL5C4';
      const ADS_CONVERSION_ID = 'AW-744549022';
      const PRODUCTION_HOSTNAMES = ['xgrcsoftware.com', 'www.xgrcsoftware.com'];
      if (PRODUCTION_HOSTNAMES.includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        // Must push the `arguments` object itself. gtag.js silently ignores
        // plain arrays, so a rest-parameter version (`...args`) loads the
        // library but never sends a single hit.
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        // No cookie-consent banner on this site yet, so grant default consent
        // explicitly, otherwise gtag.js silently withholds every hit pending
        // a consent signal that never arrives, and nothing ever reaches GA4/Ads.
        gtag('consent', 'default', {
          ad_storage: 'granted',
          analytics_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
        gtag('js', new Date());
        gtag('config', GA_MEASUREMENT_ID);
        gtag('config', ADS_CONVERSION_ID);

        const tag = document.createElement('script');
        tag.async = true;
        tag.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
        document.head.appendChild(tag);
      }
    </script>

    <!-- Lead attribution, captured into first-party cookies (90 days) and
         read by every form via window.xgrcAttribution(). No gtag
         dependency, so it works even when analytics is blocked or broken.
         - Ad click IDs: gclid, plus gbraid/wbraid, which Google sends
           instead of gclid on some clicks (Peak Timbers' 24 Sep ad click
           carried only gbraid, so nothing was recorded).
         - utm_* tags.
         Both are only set when present on the URL, so a later organic visit
         never wipes a real value. Landing page and referring site are
         first-touch: set once, on the first visit from outside the site.
         Keeps the xgrc_gclid / xgrc_utm_* cookie names form-handler and
         earlier forms already use. -->
    <script>
      (function () {
        const MAX_AGE = 7776000;
        const set = (k, v) => { document.cookie = `xgrc_${k}=${encodeURIComponent(v)}; Max-Age=${MAX_AGE}; Path=/; SameSite=Lax`; };
        const get = (k) => { const m = document.cookie.match(new RegExp(`(?:^|; )xgrc_${k}=([^;]*)`)); return m ? decodeURIComponent(m[1]) : ''; };
        const p = new URLSearchParams(window.location.search);
        const TRACKED = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        for (const key of TRACKED) {
          const value = p.get(key);
          if (value) set(key, value);
        }
        const ref = document.referrer || '';
        const external = ref && !ref.startsWith(window.location.origin);
        if (!get('landing_page') && (external || !ref)) {
          set('landing_page', (window.location.pathname + window.location.search).slice(0, 300));
          set('first_referrer', external ? ref.slice(0, 300) : '(direct)');
        }
        window.xgrcAttribution = function () {
          const out = {};
          for (const key of [...TRACKED, 'landing_page', 'first_referrer']) {
            const value = get(key);
            if (value) out[`_${key}`] = value;
          }
          return out;
        };
      })();
    </script>
    <!-- A full-page load to a URL with a #hash (e.g. a resource card linking
         to /use-cases/x/#resource) fights with `scroll-behavior: smooth`
         (global.css): the browser's native scroll-to-fragment animates while
         fonts/images below the target are still loading and shifting page
         height mid-scroll, which can overshoot well past the target — as far
         as the bottom of the page on a long one. Disable smooth scrolling for
         that initial jump, then land on the target for real once everything
         has settled; re-enable smooth scrolling for subsequent in-page clicks. -->
    <script>
      if (location.hash) {
        document.documentElement.classList.add('no-smooth-scroll');
        window.addEventListener('load', () => {
          document.getElementById(location.hash.slice(1))?.scrollIntoView({ block: 'start' });
          document.documentElement.classList.remove('no-smooth-scroll');
        });
      }
    </script>
  </head>
  <body>
    {mdURL && (
      <div class="visually-hidden" aria-hidden="true">
        A Markdown version of this page is available at {mdURL}.
      </div>
    )}
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
