---
// Shared template for every /use-cases/[slug]/ page: use case, ISO readiness,
// regulatory, and inspection checklist pages all render through this one layout.
// See docs/add-new-use-case.md to add a new page instead of copying this file.
// Each page takes the accent colour, dashboard and icon of its related solution,
// so pages share one design language without looking identical.
import MarketingOptIn from '../components/MarketingOptIn.astro';
import Base from './Base.astro';
import { solutionDetails, solutions } from '../data/site.js';
import { useCaseRegistry } from '../data/useCaseRegistry.js';

const { entry } = Astro.props;
const {
  slug, category, crumbLabel, heroEyebrow, title, metaDescription, h1, lede,
  relatedSolution, frameworks = [], approachEyebrow = 'The XGRC® approach',
  problems = [], problemIntro, problemHeadline = 'Disconnected tools create risk.',
  approach = [], approachHeadline = 'A structured, repeatable process.',
  howItWorks = [], platformNote, howItWorksHeadline = 'Structured by default, connected by design.',
  compareLabel = 'XGRC®', manual = [], withXgrc = [],
  compareHeadline = 'The same process, without the friction.',
  scope = [], frameworksHeadline = 'Aligned to the standards that matter.',
  scopeHeadline = 'One platform across the full scope.',
  resource, relatedUseCases = [],
  heroButtonLabel = 'Download the checklist',
  ctaHeadline = 'See it as a structured, integrated process.',
  ctaBody = 'Book a demo to see how XGRC® turns this into one connected workflow.',
  faqs = [],
} = entry;

// Solutions with a custom page (e.g. AI Governance) have no solutionDetails entry; fall back to the solutions list.
const solutionListing = relatedSolution ? solutions.find((s) => s.slug === relatedSolution) : null;
const solution = relatedSolution ? (solutionDetails[relatedSolution] || (solutionListing && { name: solutionListing.name, tag: solutionListing.blurb })) : null;
// ISO and regulatory pages link up to their hub page
const hub = category === 'ISO Readiness' ? { href: '/use-cases/iso-compliance/', label: 'All ISO readiness guides' }
  : category === 'Regulatory' ? { href: '/use-cases/regulatory-compliance/', label: 'All regulatory compliance guides' }
  : null;
const related = relatedUseCases
  .map((s) => useCaseRegistry.find((u) => u.slug === s))
  .filter(Boolean);

// Per-solution look: accent colour, dashboard screenshot and product icon.
const looks = {
  'sheqx': { acc: '#fbbf24', shot: 'sheqx-dashboard.webp' },
  'envirx': { acc: '#34d399', shot: 'envirx-dashboard.webp' },
  'esg': { acc: '#3ecf8e', shot: 'esg-dashboard.webp' },
  'erm': { acc: '#fb923c', shot: 'erm-dashboard-new.webp' },
  'msx': { acc: '#30e2f4', shot: 'msx-dashboard.webp' },
  'msxcyber': { acc: '#a78bfa', shot: 'msxcyber-dashboard.webp' },
  'integrated-assurance': { acc: '#60a5fa', shot: 'integrated-assurance-dashboard.webp' },
  'compliance-hub': { acc: '#f472b6', shot: 'compliance-hub-dashboard-v2.webp' },
  'xlogic': { acc: '#2dd4bf', shot: 'xlogic-dashboard.webp' },
  'maia': { acc: '#c084fc', shot: 'maia-dashboard-v2.webp' },
  'ai-governance': { acc: '#60a5fa', shot: 'ai-governance-dashboard-register.webp' },
};
const look = looks[relatedSolution] || looks.msx;
const iconSlugs = ['msx', 'msxcyber', 'esg', 'sheqx', 'erm', 'integrated-assurance', 'envirx', 'compliance-hub', 'xlogic', 'maia', 'xrm'];
const iconFor = (s) => (iconSlugs.includes(s) ? `/assets/logos/solutions/icons/${s}.png` : null);
const solIcon = iconFor(relatedSolution);
const solName = solution?.name || 'XGRC®';

// Headline: the same words, with the second idea set in the accent gradient.
const splitters = [
  /^(.+?\.)(\s.+)$/,
  /^(.+?)(\s—\s.+)$/,
  /^(.+?,)(\s+not\s.+)$/,
  /^(.+?,)(\s.+)$/,
  /^(.+?)(\s(?:means|that|for|before|beyond)\s.+)$/,
];
const hm = splitters.map((r) => h1.match(r)).find(Boolean);
const [h1a, h1b] = hm ? [hm[1], hm[2]] : [h1, ''];

const rows = Array.from({ length: Math.max(manual.length, withXgrc.length) }, (_, i) => [manual[i], withXgrc[i]]);
const pad = (i) => String(i + 1).padStart(2, '0');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      'name': h1,
      'serviceType': category,
      'description': metaDescription,
      'provider': { '@type': 'Organization', 'name': 'XGRC® Software', 'url': 'https://xgrcsoftware.com' },
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://xgrcsoftware.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Use Cases', 'item': 'https://xgrcsoftware.com/use-cases/' },
        { '@type': 'ListItem', 'position': 3, 'name': crumbLabel },
      ],
    },
    ...(faqs.length > 0 ? [{
      '@type': 'FAQPage',
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    }] : []),
  ],
};
---
<Base title={title} description={metaDescription} mdPath={`/use-cases/${slug}.md`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="uc" id="uc" style={`--acc: ${look.acc}`}>

  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/use-cases/">Use Cases</a><span aria-hidden="true">/</span><b>{crumbLabel}</b>
        </nav>
        <span class="eb-chip"><span class="eb-dot"></span>{heroEyebrow}</span>
        <h1 class="hero-title">{h1a}{h1b && <span class="hl">{h1b}</span>}</h1>
        <p class="hero-dek">{lede}</p>
        <div class="hero-cta">
          {resource && (
            <button class="btn btn-primary" data-open-download type="button">{heroButtonLabel}</button>
          )}
          <a href="#demo" class="btn btn-ghost">Book a demo</a>
        </div>
      </div>
      <figure class="hero-fig" aria-label={`${solName} dashboard`}>
        <div class="halo" aria-hidden="true"></div>
        <div class="frame">
          <div class="bar" aria-hidden="true">
            <i></i><i></i><i></i>
            {solIcon && <img src={solIcon} alt="" width="18" height="18" />}
            <span>{solName}</span>
            <em class="live"><b></b>LIVE</em>
          </div>
          <img class="shot" src={`/assets/screenshots/${look.shot}`} alt={`${solName} dashboard on the XGRC® platform`} width="1600" height="1000" loading="eager" decoding="async" />
        </div>
        {withXgrc[0] && (
          <div class="float f1" aria-hidden="true">
            <span class="f-ok">✓</span>
            <span><span class="f-eb">With {compareLabel}</span><span class="f-t">{withXgrc[0]}</span></span>
          </div>
        )}
        {frameworks.length > 0 && (
          <div class="float f2" aria-hidden="true">
            <span class="f-eb">Aligned to</span>
            <span class="f-chips">{frameworks.slice(0, 3).map((f) => <span>{f}</span>)}</span>
          </div>
        )}
      </figure>
    </div>
  </header>

  <!-- ============ THE PROBLEM ============ -->
  {problems.length > 0 && (
    <section class="sec">
      <div class="container split">
        <div class="split-head rv">
          <span class="sec-eb">The problem</span>
          <h2 class="sec-title">{problemHeadline}</h2>
          {problemIntro && <p class="sec-lede">{problemIntro}</p>}
        </div>
        <ol class="pains">
          {problems.map((p, i) => (
            <li class="pain rv">
              <span class="pain-x" aria-hidden="true">×</span>
              <span class="pain-n" aria-hidden="true">{pad(i)}</span>
              <p>{p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ============ THE XGRC APPROACH ============ -->
  {approach.length > 0 && (
    <section class="sec sec-band">
      <div class="container">
        <div class="center-head rv">
          <span class="sec-eb">{approachEyebrow}</span>
          <h2 class="sec-title">{approachHeadline}</h2>
        </div>
        <ol class="rail" style={`--n: ${approach.length}`}>
          {approach.map((step, i) => (
            <li class="rail-step rv" style={`--d: ${i * 70}ms`}>
              <span class="rail-node">{pad(i)}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ============ HOW IT WORKS ============ -->
  {howItWorks.length > 0 && (
    <section class="sec">
      <div class="container">
        <div class="center-head rv">
          <span class="sec-eb">How it works</span>
          <h2 class="sec-title">{howItWorksHeadline}</h2>
        </div>
        <div class="how">
          <ul class="caps">
            {howItWorks.map((h) => (<li class="cap rv"><span class="cap-ic" aria-hidden="true"></span>{h}</li>))}
          </ul>
          {platformNote && (
            <div class="platform rv">
              <div class="platform-bg" aria-hidden="true"></div>
              <div class="platform-top">
                {solIcon ? <img src={solIcon} alt="" width="52" height="52" loading="lazy" /> : <span class="sol-mono" aria-hidden="true">{solName.slice(0, 2)}</span>}
                <span class="platform-eb">{solName}</span>
              </div>
              <h3>{platformNote.title}</h3>
              <p>{platformNote.body}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ============ MANUAL VS XGRC ============ -->
  {manual.length > 0 && withXgrc.length > 0 && (
    <section class="sec sec-band">
      <div class="container">
        <div class="center-head rv">
          <span class="sec-eb">From manual to {compareLabel}</span>
          <h2 class="sec-title">{compareHeadline}</h2>
        </div>
        <div class="vs">
          <div class="vs-head" aria-hidden="true">
            <span class="vs-l">Manual approach</span><span></span><span class="vs-r">{compareLabel} approach</span>
          </div>
          {rows.map(([m, x]) => (
            <div class="vs-row rv">
              {m ? <p class="vs-m"><span class="sr-only">Manual approach: </span>{m}</p> : <span class="vs-empty"></span>}
              <span class="vs-arrow" aria-hidden="true">→</span>
              {x ? <p class="vs-x"><span class="sr-only">{compareLabel} approach: </span>{x}</p> : <span class="vs-empty"></span>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ DOWNLOADABLE RESOURCE (gated) ============ -->
  {resource && (
    <section class="sec sec-tight" id="resource">
      <div class="container">
        <div class="check rv">
          <div class="check-doc" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><b>✓</b></div>
          <div class="check-body">
            <span class="sec-eb">Free resource</span>
            <h2>{resource.title}</h2>
            <ul class="check-list">
              {resource.includes.map((r) => (<li>{r}</li>))}
            </ul>
          </div>
          <div class="check-action">
            <button class="btn btn-primary" data-open-download type="button">Download the checklist</button>
            <span class="check-note">{resource.note}</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============ STANDARDS + SCOPE ============ -->
  {(frameworks.length > 0 || scope.length > 0) && (
    <section class="sec sec-tight">
      <div class="container tags">
        {frameworks.length > 0 && (
          <div class="tag-panel rv">
            <span class="sec-eb">Standards and frameworks</span>
            <h3>{frameworksHeadline}</h3>
            <ul class="chips">{frameworks.map((s) => (<li>{s}</li>))}</ul>
          </div>
        )}
        {scope.length > 0 && (
          <div class="tag-panel rv">
            <span class="sec-eb">Scope of application</span>
            <h3>{scopeHeadline}</h3>
            <ul class="chips alt">{scope.map((s) => (<li>{s}</li>))}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ============ RELATED ============ -->
  {(solution || related.length > 0) && (
    <section class="sec sec-tight">
      <div class="container">
        <div class="rel-head rv">
          <div>
            <span class="sec-eb">Related</span>
            <h2 class="sec-title sm">Explore the connected platform.</h2>
          </div>
          <div class="rel-links">
            {hub && (<a href={hub.href} class="rel-link">{hub.label} &rarr;</a>)}
            {solution?.regionalLink && (<a href={solution.regionalLink.href} class="rel-link">{solution.regionalLink.label} &rarr;</a>)}
          </div>
        </div>
        <div class="rel-grid">
          {solution && (
            <a class="rel-card rel-sol rv" href={`/${relatedSolution}/`}>
              <span class="rel-shot"><img src={`/assets/screenshots/${look.shot}`} alt="" loading="lazy" decoding="async" /></span>
              <span class="rel-body">
                <span class="rel-top">
                  {solIcon ? <img src={solIcon} alt="" width="36" height="36" loading="lazy" /> : <span class="sol-mono sm" aria-hidden="true">{solName.slice(0, 2)}</span>}
                  <span class="rel-tag">Solution</span>
                </span>
                <h3>{solution.name}</h3>
                <p>{solution.tag}</p>
                <span class="rel-go">Explore {solution.name} &rarr;</span>
              </span>
            </a>
          )}
          {related.map((r) => {
            const rl = looks[r.relatedSolution] || looks.msx;
            return (
              <a class="rel-card rv" href={`/use-cases/${r.slug}/`} style={`--racc: ${rl.acc}`}>
                <span class="rel-body">
                  <span class="rel-top">
                    {iconFor(r.relatedSolution) ? <img src={iconFor(r.relatedSolution)} alt="" width="36" height="36" loading="lazy" /> : <span class="sol-mono sm" aria-hidden="true">AI</span>}
                    <span class="rel-tag">{r.category}</span>
                  </span>
                  <h3>{r.crumbLabel}</h3>
                  <p>{r.lede}</p>
                  <span class="rel-go">View use case &rarr;</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ============ FAQ ============ -->
  {faqs.length > 0 && (
    <section class="sec sec-tight">
      <div class="container faq-wrap">
        <div class="split-head rv">
          <span class="sec-eb">Frequently asked</span>
          <h2 class="sec-title">Common questions.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq rv">
              <summary><span class="fq-n">{pad(i)}</span><span class="fq-q">{f.q}</span><span class="fq-ic" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ CTA ============ -->
  <section class="sec" id="demo">
    <div class="container">
      <div class="cta rv">
        <div class="cta-bg" aria-hidden="true"></div>
        {solIcon && <img class="cta-ic" src={solIcon} alt="" width="56" height="56" loading="lazy" />}
        <h2>{ctaHeadline}</h2>
        <p>{ctaBody}</p>
        <div class="cta-actions">
          <a href="/demo/" class="btn btn-primary">Book a demo</a>
          {resource && <button class="btn btn-ghost" data-open-download type="button">Download the checklist</button>}
        </div>
      </div>
    </div>
  </section>

  </div>

  <!-- ============ DOWNLOAD MODAL ============ -->
  {resource && (
    <div class="modal" id="downloadModal" hidden>
      <div class="modal-backdrop" data-close-download></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="dlTitle">
        <button class="modal-x" data-close-download type="button" aria-label="Close">&times;</button>
        <div data-form-state>
          <span class="eyebrow"><span class="dot"></span>{resource.title}</span>
          <h3 id="dlTitle">Where should we send your download link?</h3>
          <p>Enter your details and we will email you the link to the checklist.</p>
          <form id="downloadForm" novalidate>
            <label>Name<input type="text" name="name" required autocomplete="name" /></label>
            <label>Work email<input type="email" name="email" required autocomplete="email" /></label>
            <label>Company <span class="opt">(optional)</span><input type="text" name="company" autocomplete="organization" /></label>
            <MarketingOptIn />
            <div class="hp-field" aria-hidden="true"><label>Leave this field empty<input type="text" name="_hp" tabindex="-1" autocomplete="off" /></label></div>
            <p class="form-error" data-error hidden>Please enter your name and a valid email address.</p>
            <button class="btn btn-primary" type="submit">Email me the checklist</button>
            <p class="form-fine">We use your details only to send the resource and occasional XGRC&reg; updates. Unsubscribe any time.</p>
          </form>
        </div>
        <div data-success-state hidden>
          <span class="eyebrow ok"><span class="dot"></span>Ready to download</span>
          <h3>Your checklist is ready.</h3>
          <p>Click the button below to download the PDF. We have also sent this link to your email.</p>
          <a class="btn btn-primary" href={resource.pdfPath} download style="margin-top:18px;width:100%;justify-content:center;">Download the checklist (PDF)</a>
          <button class="btn btn-ghost" data-close-download type="button" style="width:100%;justify-content:center;margin-top:10px;">Close</button>
        </div>
      </div>
    </div>
  )}
</Base>

{resource && (
  <script define:vars={{ pdfPath: resource.pdfPath, resourceTitle: resource.title, pageUrl: `/use-cases/${slug}/` }}>
    // ---- Gated download interaction ----
    const _loadT = Date.now();
    const modal = document.getElementById('downloadModal');
    const form = document.getElementById('downloadForm');
    const formState = modal?.querySelector('[data-form-state]');
    const successState = modal?.querySelector('[data-success-state]');
    const errorEl = modal?.querySelector('[data-error]');
    let lastFocused = null;

    function openModal() {
      lastFocused = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('input[name="name"]')?.focus({ preventScroll: true });
    }
    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      formState.hidden = false;
      successState.hidden = true;
      form?.reset();
      errorEl.hidden = true;
      lastFocused?.focus();
    }

    document.querySelectorAll('[data-open-download]').forEach((b) => b.addEventListener('click', openModal));
    document.querySelectorAll('[data-close-download]').forEach((b) => b.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });
    // Links from insights articles ("Free checklist" cards) land on #download
    // and carry ?from=<article slug>, so the form opens straight away and the
    // lead shows which article sent it.
    const fromArticle = (new URLSearchParams(location.search).get('from') || '').match(/^[a-z0-9-]{1,120}$/)?.[0] || '';
    if (location.hash === '#download') openModal();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = (data.get('name') || '').toString().trim();
      const email = (data.get('email') || '').toString().trim();
      const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!name || !validEmail) { errorEl.hidden = false; return; }
      errorEl.hidden = true;

      // Submit lead to form endpoint (fire-and-forget — download proceeds regardless)
      fetch('/api/demo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          firstName: name.split(' ')[0],
          lastName: name.split(' ').slice(1).join(' ') || '',
          email,
          company: (data.get('company') || '').toString().trim(),
          message: `Checklist download request: ${resourceTitle}${fromArticle ? ` (from article /insights/${fromArticle}/)` : ''}`,
          _subject: `Checklist download — ${resourceTitle}`,
          _download_url: window.location.origin + pdfPath,
          _source_page: pageUrl,
          _ga_client_id: (document.cookie.match(/_ga=GA\d\.\d\.(\d+\.\d+)/) || [])[1] || '',
          ...(window.xgrcAttribution?.() || {}),
          _hp: (data.get('_hp') || '').toString(),
          marketingConsent: (data.get('marketingConsent') || '').toString(),
          _elapsed_ms: Date.now() - _loadT,
        }),
      }).catch(() => {}); // swallow errors — download still works

      // GA4 lead event. Consent mode applies: without Accept it is sent as a
      // cookieless ping and GA4 models it.
      window.gtag?.('event', 'generate_lead', { lead_type: 'checklist', resource: pageUrl });

      // Trigger download immediately so user doesn't wait for email
      const a = document.createElement('a');
      a.href = pdfPath;
      a.download = pdfPath.split('/').pop();
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      formState.hidden = true;
      successState.hidden = false;
    });
  </script>
)}


<script>
  // Reveal on scroll (content stays visible without JS or with reduced motion).
  const ucRoot = document.getElementById('uc');
  if (ucRoot && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ucRoot.classList.add('fx');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    ucRoot.querySelectorAll('.rv').forEach((el) => io.observe(el));
  }
</script>

<style>
  .uc { --c1: #30e2f4; --c2: #a78bfa; --c3: #2fe88a; --bad: #f87171; padding-top: 74px; overflow-x: clip; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  /* ── Hero ─────────────────────────────────────────── */
  .hero { position: relative; padding: clamp(28px, 5vw, 64px) 0 clamp(48px, 6vw, 80px); isolation: isolate; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(42% 55% at 78% 45%, color-mix(in srgb, var(--acc) 22%, transparent), transparent 70%),
      radial-gradient(35% 45% at 95% 85%, rgba(167, 139, 250, 0.10), transparent 70%),
      radial-gradient(40% 50% at 8% 8%, rgba(48, 226, 244, 0.08), transparent 70%),
      linear-gradient(rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(120, 170, 200, 0.06) 1px, transparent 1px) 0 0 / 44px 44px;
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 12px; color: var(--faint); margin-bottom: 22px; }
  .crumb a { color: var(--mute); text-decoration: none; }
  .crumb a:hover { color: var(--acc); }
  .crumb b { color: var(--ink); font-weight: 500; }
